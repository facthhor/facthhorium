  %oa0_gt = vector.mulf %oa0_gs2, %oa0_two : vector<8xf32>
  %oa0_gtanh = vector.subf %oa0_gt, %oa0_one : vector<8xf32>
  %oa0_gb = vector.mulf %oa0_beta, %oa0_gtanh : vector<8xf32>
  %oa0_gsig = vector.logisticf<afn> %g0s : vector<8xf32>
  %oa0_gact = vector.mulf %oa0_gb, %oa0_gsig : vector<8xf32>
  %oa0_u2 = vector.mulf %u0s, %oa0_invlb2 : vector<8xf32>
  %oa0_us2 = vector.logisticf<afn> %oa0_u2 : vector<8xf32>
  %oa0_ut = vector.mulf %oa0_us2, %oa0_two : vector<8xf32>
  %oa0_utanh = vector.subf %oa0_ut, %oa0_one : vector<8xf32>
  %oa0_uact = vector.mulf %oa0_lb, %oa0_utanh : vector<8xf32>
  %act0 = vector.mulf %oa0_gact, %oa0_uact : vector<8xf32>
  %oa1_beta = vector.splatf 4.0 : vector<8xf32>
  %oa1_invb2 = vector.splatf 0.5 : vector<8xf32>
  %oa1_lb = vector.splatf 25.0 : vector<8xf32>
  %oa1_invlb2 = vector.splatf 0.08 : vector<8xf32>
  %oa1_two = vector.splatf 2.0 : vector<8xf32>
  %oa1_one = vector.splatf 1.0 : vector<8xf32>
  %oa1_g2 = vector.mulf %g1s, %oa1_invb2 : vector<8xf32>
  %oa1_gs2 = vector.logisticf<afn> %oa1_g2 : vector<8xf32>
  %oa1_gt = vector.mulf %oa1_gs2, %oa1_two : vector<8xf32>
  %oa1_gtanh = vector.subf %oa1_gt, %oa1_one : vector<8xf32>
  %oa1_gb = vector.mulf %oa1_beta, %oa1_gtanh : vector<8xf32>
  %oa1_gsig = vector.logisticf<afn> %g1s : vector<8xf32>
  %oa1_gact = vector.mulf %oa1_gb, %oa1_gsig : vector<8xf32>
  %oa1_u2 = vector.mulf %u1s, %oa1_invlb2 : vector<8xf32>
  %oa1_us2 = vector.logisticf<afn> %oa1_u2 : vector<8xf32>
  %oa1_ut = vector.mulf %oa1_us2, %oa1_two : vector<8xf32>
  %oa1_utanh = vector.subf %oa1_ut, %oa1_one : vector<8xf32>
  %oa1_uact = vector.mulf %oa1_lb, %oa1_utanh : vector<8xf32>
  %act1 = vector.mulf %oa1_gact, %oa1_uact : vector<8xf32>
  vector.fragment.store<result> %act0, %y_view[%bounded_wave_row, %bounded_wave_out] shape [%c16, %c16] : vector<8xf32>, view<64x64xf32, %y_layout>
  vector.fragment.store<result> %act1, %y_view[%bounded_wave_row, %wave_out1] shape [%c16, %c16] : vector<8xf32>, view<64x64xf32, %y_layout>
  }
