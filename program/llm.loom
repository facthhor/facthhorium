kernel.def export("g_dsp_head_select_commit") @g_dsp_head_select_commit(%spans: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%spans, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%spans_arg: index, %etokens_arg: index, %step_arg: index, %epoch: buffer, %metadata: buffer, %partials: buffer, %slots: buffer, %prev_tok: buffer, %target_tokens: buffer) {
  %spans = index.assume %spans_arg [range(%spans_arg, 1, 1024)] : index
  %etokens = index.assume %etokens_arg [range(%etokens_arg, 1, 8192)] : index
  %step = index.assume %step_arg [range(%step_arg, 1, 7)] : index
  %span_id = kernel.workgroup.id<x> : index
  %span = index.assume %span_id [lt(%span_id, %spans)] : index
  %lane_id = kernel.workitem.id<x> : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 255)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c256 = index.constant 256 : index
  %chunks = index.constant 512 : index
  %c0_i32 = scalar.constant 0 : i32
  %neg_inf = scalar.constant -3.0e38 : f32
  %big = scalar.constant 2147483647 : i32
  %header = buffer.view %metadata[%zero] : buffer -> view<4xi32>
  %count32 = view.load %header[0] : view<4xi32> -> i32
  %count_b = scalar.assume %count32 [range(%count32, 0, 1024)] : i32
  %count = index.cast %count_b : i32 to index
  %live = index.cmp ult, %span, %count : index
  scf.if %live {
    %first = index.cmp eq, %lane, %c0 : index
    %pv = buffer.view %partials[%zero] : buffer -> view<[%spans]x512x2xi32>
    %bv, %bi = scf.for %c = [%lane to %chunks step %c256](%v = %neg_inf : f32, %i = %big : i32) -> (f32, i32) {
      %bc = index.assume %c [range(%c, 0, 511)] : index
      %bits = view.load %pv[%span, %bc, %c0] : view<[%spans]x512x2xi32> -> i32
      %id = view.load %pv[%span, %bc, %c1] : view<[%spans]x512x2xi32> -> i32
      %val = scalar.bitcast %bits : i32 to f32
      %better = scalar.cmpf ogt, %val, %v : f32
      %nv = scf.select %better, %val, %v : f32
      %ni = scf.select %better, %id, %i : i32
      scf.yield %nv, %ni : f32, i32
    }
    %best = kernel.workgroup.reduce<maxnumf> %bv : f32
    %is_b = scalar.cmpf oeq, %bv, %best : f32
    %cand = scf.select %is_b, %bi, %big : i32
    %row = kernel.workgroup.reduce<minsi> %cand : i32
    scf.if %first {
        %row_b = scalar.assume %row [range(%row, 0, 65535)] : i32
        %row_idx = index.cast %row_b : i32 to index
        %map = global.load @dsp_head_map : buffer
        %mv = buffer.view %map[%zero] : buffer -> view<65536xi32>
        %winner = view.load %mv[%row_idx] : view<65536xi32> -> i32
      %eos = view.load %header[1] : view<4xi32> -> i32
        %terminal_0 = scalar.constant false : i1
        %eid0 = scalar.constant 199999 : i32
        %eis0 = scalar.cmpi eq, %winner, %eid0 : i32
        %terminal_1 = scalar.ori %terminal_0, %eis0 : i1
        %token = scf.select %terminal_1, %eos, %winner : i32
      %prevv = buffer.view %prev_tok[%zero] : buffer -> view<[%spans]xi32>
      view.store %token, %prevv[%span] : i32, view<[%spans]xi32>
      %sv = buffer.view %slots[%zero] : buffer -> view<[%spans]xi32>
      %base32 = view.load %sv[%span] : view<[%spans]xi32> -> i32
      %base_b = scalar.assume %base32 [range(%base32, 0, 8191)] : i32
      %base = index.cast %base_b : i32 to index
      %dst_t = index.add %base, %step : index
      %in_t = index.cmp ult, %dst_t, %etokens : index
      scf.if %in_t {
        %eh = buffer.view %epoch[%zero] : buffer -> view<4xi32>
        %mixed_w = view.load %eh[2] : view<4xi32> -> i32
        %mixed = scalar.cmpi ne, %mixed_w, %c0_i32 : i32
        %id_stride = scf.select %mixed, %c8, %c1 : index
        %n_ids = index.mul %etokens, %id_stride : index
        %ids_flat = buffer.view %target_tokens[%zero] : buffer -> view<[%n_ids]xi32>
        %dst_e = index.mul %dst_t, %id_stride : index
        %dst_idx = index.assume %dst_e [range(%dst_e, 0, 65535), lt(%dst_e, %n_ids)] : index
        view.store %token, %ids_flat[%dst_idx] : i32, view<[%n_ids]xi32>
      }
    }
  }
  kernel.return
}
config.decl @llm.prep_blocks : i64

config.decl @llm.prep_input : i64
config.decl @llm.prep_split : i64

config.decl @llm.prep_skip : i64

// Load-time weight preparation (draft/prep_weights.py): staged Q8_0G tensor (input + llm.prep_input) ->
// Q4_0S in output, one lane per 32-value block; output unit g reads source unit g (g < split) or g + skip.
kernel.def export("g_prep_q8_0g_q4_0s") @g_prep_q8_0g_q4_0s(%blocks: index) {
  %c1 = index.constant 1 : index
  %c63 = index.constant 63 : index
  %c64 = index.constant 64 : index
  %rounded = index.add %blocks, %c63 : index
  %groups = index.div %rounded, %c64 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%blocks_arg: index, %in64: i64, %split64: i64, %skip64: i64, %output: buffer, %input: buffer) {
  %blocks = index.assume %blocks_arg [range(%blocks_arg, 1, 1073741824)] : index
  %in_bound = scalar.assume %in64 [range(%in64, 0, 9223372036854775807)] : i64
  %in_origin = index.cast %in_bound : i64 to offset
  %split_bound = scalar.assume %split64 [range(%split64, 0, 1073741824)] : i64
  %split = index.cast %split_bound : i64 to index
  %skip_bound = scalar.assume %skip64 [range(%skip64, 0, 1073741824)] : i64
  %skip = index.cast %skip_bound : i64 to index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c64 = index.constant 64 : index
  %sb_bytes = index.constant 34 : offset
  %wg = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %base = index.mul %wg, %c64 : index
  %g = index.add %base, %lane : index
  %live = index.cmp ult, %g, %blocks : index
  scf.if %live {
    %zero_o = index.constant 0 : offset
    %row = index.div %g, %skip : index
    %col = index.rem %g, %skip : index
    %row_b = index.assume %row [lt(%row, %split)] : index
    %map = global.load @dsp_head_map : buffer
    %mv = buffer.view %map[%zero_o] : buffer -> view<[%split]xi32>
    %src_r32 = view.load %mv[%row_b] : view<[%split]xi32> -> i32
    %src_rb = scalar.assume %src_r32 [range(%src_r32, 0, 1048575)] : i32
    %src_r = index.cast %src_rb : i32 to index
    %src_base = index.mul %src_r, %skip : index
    %sg = index.add %src_base, %col : index
    %sbo = index.scale %sg, %sb_bytes : index, offset -> offset
    %origin = index.add %in_origin, %sbo : offset
    %sd_view = buffer.view %input[%origin] : buffer -> view<1xf16>
    %sdh = view.load %sd_view[0] : view<1xf16> -> f16
    %sd = scalar.extf %sdh : f16 to f32
    %sdv = vector.splat %sd : vector<32xf32>
    %two_i = index.constant 2 : offset
    %qa = index.add %origin, %two_i : offset
    %sq_view = buffer.view %input[%qa] : buffer -> view<32xi8>
    %sq = vector.load %sq_view[0] : view<32xi8> -> vector<32xi8>
    %sqf = vector.sitofp %sq : vector<32xi8> to vector<32xf32>
    %v = vector.mulf %sqf, %sdv : vector<32xf32>
    %zero_f = scalar.constant 0.0 : f32
    %ninf = scalar.constant -3.0e38 : f32
    %pinf = scalar.constant 3.0e38 : f32
    %cm8 = scalar.constant -8.0 : f32
    %one_f = scalar.constant 1.0 : f32
    %hi = vector.reduce<maxnumf> %v, %ninf : vector<32xf32>, f32
    %lo = vector.reduce<minnumf> %v, %pinf : vector<32xf32>, f32
    %nlo = scalar.negf %lo : f32
    %pos = scalar.cmpf oge, %hi, %nlo : f32
    %m = scf.select %pos, %hi, %lo : f32
    %d = scalar.divf %m, %cm8 : f32
    %nz = scalar.cmpf one, %d, %zero_f : f32
    %inv = scalar.divf %one_f, %d : f32
    %id = scf.select %nz, %inv, %zero_f : f32
    %idv = vector.splat %id : vector<32xf32>
    %off = vector.splatf 8.5 : vector<32xf32>
    %top = vector.splatf 15.0 : vector<32xf32>
    %sv = vector.fmaf %v, %idv, %off : vector<32xf32>
    %cl = vector.minnumf %sv, %top : vector<32xf32>
    %q = vector.fptosi %cl : vector<32xf32> to vector<32xi8>
    %ql = vector.slice %q[0] : vector<32xi8> -> vector<16xi8>
    %qh = vector.slice %q[16] : vector<32xi8> -> vector<16xi8>
    %four = vector.splati 4 : vector<16xi8>
    %qhs = vector.shli %qh, %four : vector<16xi8>
    %packed = vector.ori %ql, %qhs : vector<16xi8>
    %dh = scalar.fptrunc %d : f32 to f16
    // Q4_0 SoA layout (q4_0s): [blocks, 16] 16-byte aligned nibble plane, then [blocks] f16 scale plane.
    %ob16 = index.constant 16 : offset
    %oo16 = index.scale %g, %ob16 : index, offset -> offset
    %q_view = buffer.view %output[%oo16] : buffer -> view<16xi8>
    vector.store %packed, %q_view[0] : vector<16xi8>, view<16xi8>
    %sc_base = index.scale %blocks, %ob16 : index, offset -> offset
    %ob2 = index.constant 2 : offset
    %sc_off = index.scale %g, %ob2 : index, offset -> offset
    %sc_at = index.add %sc_base, %sc_off : offset
    %d_view = buffer.view %output[%sc_at] : buffer -> view<1xf16>
    view.store %dh, %d_view[0] : f16, view<1xf16>
  }
  kernel.return
}

command.def public target(@device) @llm_prep_q8_0g_q4_0s() launch(%output: buffer, %input: buffer) {
  %b64 = config.get @llm.prep_blocks : i64
  %blocks = index.cast %b64 : i64 to index
  %in64 = config.get @llm.prep_input : i64
  %split64 = config.get @llm.prep_split : i64
  %skip64 = config.get @llm.prep_skip : i64
  kernel.launch @g_prep_q8_0g_q4_0s[%blocks](%blocks, %in64, %split64, %skip64, %output, %input) : [index](index, i64, i64, i64, buffer, buffer)
  command.return
}


amdgpu.target<gfx11-generic> @t_nvfp4_gfx11 {subgroup_size = 32}

low.func.def target<amdgpu.gfx11.generic.core>(@t_nvfp4_gfx11) @g_nvfp4_deq16_low(
    %q0: reg<amdgpu.vgpr>, %q1: reg<amdgpu.vgpr>, %d_pk: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x8>) asm {
  %lut_lo = v_mov_b32 1583110144
  %lut_hi = v_mov_b32 1717854816
  %zero = v_mov_b32 0

  %m0_lo = v_and_b32_lit %q0, 117901063
  %lut0_lo = v_perm_b32 %lut_hi, %lut_lo, %m0_lo
  %s0_lo = v_lshlrev_b32_src0_inline %q0, 4
  %s0_lo_m = v_and_b32_lit %s0_lo, 2155905152
  %h0_lo = v_or_b32 %lut0_lo, %s0_lo_m

  %m1_lo = v_and_b32_lit %q1, 117901063
  %lut1_lo = v_perm_b32 %lut_hi, %lut_lo, %m1_lo
  %s1_lo = v_lshlrev_b32_src0_inline %q1, 4
  %s1_lo_m = v_and_b32_lit %s1_lo, 2155905152
  %h1_lo = v_or_b32 %lut1_lo, %s1_lo_m

  %q0_hi = v_lshrrev_b32_src0_inline %q0, 4
  %m0_hi = v_and_b32_lit %q0_hi, 117901063
  %lut0_hi = v_perm_b32 %lut_hi, %lut_lo, %m0_hi
  %s0_hi_m = v_and_b32_lit %q0, 2155905152
  %h0_hi = v_or_b32 %lut0_hi, %s0_hi_m

  %q1_hi = v_lshrrev_b32_src0_inline %q1, 4
  %m1_hi = v_and_b32_lit %q1_hi, 117901063
  %lut1_hi = v_perm_b32 %lut_hi, %lut_lo, %m1_hi
  %s1_hi_m = v_and_b32_lit %q1, 2155905152
  %h1_hi = v_or_b32 %lut1_hi, %s1_hi_m

  %p0 = v_perm_b32_src2_lit %zero, %h0_lo, 17563660
  %p1 = v_perm_b32_src2_lit %zero, %h0_lo, 51118604
  %p2 = v_perm_b32_src2_lit %zero, %h1_lo, 17563660
  %p3 = v_perm_b32_src2_lit %zero, %h1_lo, 51118604
  %p4 = v_perm_b32_src2_lit %zero, %h0_hi, 17563660
  %p5 = v_perm_b32_src2_lit %zero, %h0_hi, 51118604
  %p6 = v_perm_b32_src2_lit %zero, %h1_hi, 17563660
  %p7 = v_perm_b32_src2_lit %zero, %h1_hi, 51118604

  %r0 = v_pk_mul_f16 %p0, %d_pk
  %r1 = v_pk_mul_f16 %p1, %d_pk
  %r2 = v_pk_mul_f16 %p2, %d_pk
  %r3 = v_pk_mul_f16 %p3, %d_pk
  %r4 = v_pk_mul_f16 %p4, %d_pk
  %r5 = v_pk_mul_f16 %p5, %d_pk
  %r6 = v_pk_mul_f16 %p6, %d_pk
  %r7 = v_pk_mul_f16 %p7, %d_pk

  %out = concat(%r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
  return %out
}


// Router: wave w scores experts w*16..; then thread e holds expert e and 8 rounds of
// workgroup reductions pick the top 8 (ties: lowest index) of sigmoid(logit) + bias.
kernel.def export("g_moe_route") @g_moe_route(%tokens: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %x: buffer, %w: buffer, %b: buffer, %ids: buffer, %wts: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %token_id = kernel.workgroup.id<x> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %wave_id = kernel.subgroup.id : index
  %wave = index.assume %wave_id [range(%wave_id, 0, 7)] : index
  %lane_id = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 31)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %cHG = index.constant 72 : index
  %cE = index.constant 128 : index
  %zero_f = scalar.constant 0.0 : f32
  %x_view = buffer.view %x[%zero] : buffer -> view<[%tokens]x72x32xf32>
  %w_view = buffer.view %w[%zero] : buffer -> view<128x72x32xbf16>
  %lg_bytes = index.constant 512 : offset
  %lg = buffer.alloca<workgroup> align(16) %lg_bytes : buffer
  %lg_view = buffer.view %lg[%zero] : buffer -> view<128xf32>
  %first = index.cmp eq, %lane, %c0 : index
  %cEPW = index.constant 16 : index
  %e0 = index.mul %wave, %cEPW : index
  %cU = index.constant 4 : index
  scf.for %j = [%c0 to %cEPW step %cU] {
    %e_raw = index.add %e0, %j : index
    %ex0_raw = index.add %e_raw, %c0 : index
    %ex0 = index.assume %ex0_raw [range(%ex0_raw, 0, 127)] : index
    %ex1_raw = index.add %e_raw, %c1 : index
    %ex1 = index.assume %ex1_raw [range(%ex1_raw, 0, 127)] : index
    %ex2_raw = index.add %e_raw, %c2 : index
    %ex2 = index.assume %ex2_raw [range(%ex2_raw, 0, 127)] : index
    %ex3_raw = index.add %e_raw, %c3 : index
    %ex3 = index.assume %ex3_raw [range(%ex3_raw, 0, 127)] : index
    %part0, %part1, %part2, %part3 = scf.for %g = [%lane to %cHG step %c32](%acc0 = %zero_f : f32, %acc1 = %zero_f : f32, %acc2 = %zero_f : f32, %acc3 = %zero_f : f32) -> (f32, f32, f32, f32) {
      %bg = index.assume %g [range(%g, 0, 71)] : index
      %xv = vector.load %x_view[%token, %bg, %c0] : view<[%tokens]x72x32xf32> -> vector<32xf32>
      %wv0_raw = vector.load %w_view[%ex0, %bg, %c0] : view<128x72x32xbf16> -> vector<32xbf16>
      %wv0 = vector.extf %wv0_raw : vector<32xbf16> to vector<32xf32>
      %wv1_raw = vector.load %w_view[%ex1, %bg, %c0] : view<128x72x32xbf16> -> vector<32xbf16>
      %wv1 = vector.extf %wv1_raw : vector<32xbf16> to vector<32xf32>
      %wv2_raw = vector.load %w_view[%ex2, %bg, %c0] : view<128x72x32xbf16> -> vector<32xbf16>
      %wv2 = vector.extf %wv2_raw : vector<32xbf16> to vector<32xf32>
      %wv3_raw = vector.load %w_view[%ex3, %bg, %c0] : view<128x72x32xbf16> -> vector<32xbf16>
      %wv3 = vector.extf %wv3_raw : vector<32xbf16> to vector<32xf32>
      %d0 = vector.dotf<reassoc|contract> %wv0, %xv, %zero_f : vector<32xf32>, vector<32xf32>, f32
      %nx0 = scalar.addf %acc0, %d0 : f32
      %d1 = vector.dotf<reassoc|contract> %wv1, %xv, %zero_f : vector<32xf32>, vector<32xf32>, f32
      %nx1 = scalar.addf %acc1, %d1 : f32
      %d2 = vector.dotf<reassoc|contract> %wv2, %xv, %zero_f : vector<32xf32>, vector<32xf32>, f32
      %nx2 = scalar.addf %acc2, %d2 : f32
      %d3 = vector.dotf<reassoc|contract> %wv3, %xv, %zero_f : vector<32xf32>, vector<32xf32>, f32
      %nx3 = scalar.addf %acc3, %d3 : f32
      scf.yield %nx0, %nx1, %nx2, %nx3 : f32, f32, f32, f32
    }
    %logit0 = kernel.subgroup.reduce<addf> %part0 : f32
    %logit1 = kernel.subgroup.reduce<addf> %part1 : f32
    %logit2 = kernel.subgroup.reduce<addf> %part2 : f32
    %logit3 = kernel.subgroup.reduce<addf> %part3 : f32
    scf.if %first {
      view.store %logit0, %lg_view[%ex0] : f32, view<128xf32>
      view.store %logit1, %lg_view[%ex1] : f32, view<128xf32>
      view.store %logit2, %lg_view[%ex2] : f32, view<128xf32>
      view.store %logit3, %lg_view[%ex3] : f32, view<128xf32>
    }
  }

  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %t0 = kernel.workitem.id<x> : index
  %tb = index.assume %t0 [range(%t0, 0, 255)] : index
  %in_range = index.cmp ult, %tb, %cE : index
  %removed = scalar.constant -3.0e38 : f32
  %prob, %score0 = scf.if %in_range -> (f32, f32) {
    %be = index.assume %tb [range(%tb, 0, 127)] : index
    %lgt = view.load %lg_view[%be] : view<128xf32> -> f32
    %prob_v = scalar.logisticf<afn> %lgt : f32
    %b_view = buffer.view %b[%zero] : buffer -> view<128xf32>
    %bias_v = view.load %b_view[%be] : view<128xf32> -> f32
    %score_v = scalar.addf %prob_v, %bias_v : f32
    scf.yield %prob_v, %score_v : f32, f32
  } else {
    scf.yield %zero_f, %removed : f32, f32
  }
  %ids_view = buffer.view %ids[%zero] : buffer -> view<[%tokens]x8xi32>
  %wts_view = buffer.view %wts[%zero] : buffer -> view<[%tokens]x8xf32>
  %t32 = index.cast %tb : index to i32
  %big_id = scalar.constant 1000000 : i32
  %cKU = index.constant 8 : index
  %minus1 = scalar.constant -1 : i32
  %rest, %total, %my_w, %my_k = scf.for %round = [%c0 to %cKU step %c1](%sc = %score0 : f32, %sum = %zero_f : f32, %mw = %zero_f : f32, %mk = %minus1 : i32) -> (f32, f32, f32, i32) {
    %best = kernel.workgroup.reduce<maxnumf> %sc : f32
    %is_best = scalar.cmpf oeq, %sc, %best : f32
    %cand = scf.select %is_best, %t32, %big_id : i32
    %winner = kernel.workgroup.reduce<minsi> %cand : i32
    %won = scalar.cmpi eq, %winner, %t32 : i32
    %br = index.assume %round [range(%round, 0, 7)] : index
    scf.if %won {
      view.store %t32, %ids_view[%token, %br] : i32, view<[%tokens]x8xi32>
    }
    %mine = scf.select %won, %prob, %zero_f : f32
    %wp = kernel.workgroup.reduce<addf> %mine : f32
    %round32 = index.cast %br : index to i32
    %next_mw = scf.select %won, %prob, %mw : f32
    %next_mk = scf.select %won, %round32, %mk : i32
    %next_sc = scf.select %won, %removed, %sc : f32
    %next_sum = scalar.addf %sum, %wp : f32
    scf.yield %next_sc, %next_sum, %next_mw, %next_mk : f32, f32, f32, i32
  }
  %min_sum = scalar.constant 1e-20 : f32
  %wsum = scalar.addf %total, %min_sum : f32
  // The winner thread of each round keeps its prob in registers and writes the normalized weight
  // itself: reading back other threads' global stores raced through the per-WGP cache when
  // neighboring tokens' workgroups share a cache line (prefill outputs varied run to run).
  %c0_i32r = scalar.constant 0 : i32
  %writer = scalar.cmpi sge, %my_k, %c0_i32r : i32
  scf.if %writer {
    %kb = scalar.assume %my_k [range(%my_k, 0, 7)] : i32
    %bk = index.cast %kb : i32 to index
    %wn = scalar.divf %my_w, %wsum : f32
    %wn_k = scalar.constant 8.0 : f32
    %wns = scalar.mulf %wn, %wn_k : f32
    view.store %wns, %wts_view[%token, %bk] : f32, view<[%tokens]x8xf32>
  }
  kernel.return
}

// Router: TR=4 tokens per workgroup, their h rows staged in LDS; wave w scores experts w*16.. for
// all 4 tokens (one weight load serves 4 tokens); then per token, thread e holds expert e and 8
// rounds of workgroup reductions pick the top 8 (ties: lowest index) of sigmoid(logit) + bias.
kernel.def export("g_moe_route_tr") @g_moe_route_tr(%tokens: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  %cTRm1 = index.constant 3 : index
  %cTR = index.constant 4 : index
  %padded = index.add %tokens, %cTRm1 : index
  %groups = index.div %padded, %cTR : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %x: buffer, %w: buffer, %b: buffer, %ids: buffer, %wts: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %group_id = kernel.workgroup.id<x> : index
  %wave_id = kernel.subgroup.id : index
  %wave = index.assume %wave_id [range(%wave_id, 0, 7)] : index
  %lane_id = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 31)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  %c256 = index.constant 256 : index
  %cHG = index.constant 72 : index
  %cE = index.constant 128 : index
  %cTR = index.constant 4 : index
  %zero_f = scalar.constant 0.0 : f32
  %token0 = index.mul %group_id, %cTR : index
  %x_view = buffer.view %x[%zero] : buffer -> view<[%tokens]x72x32xf32>
  %xs_bytes = index.constant 36864 : offset
  %xs = buffer.alloca<workgroup> align(16) %xs_bytes : buffer
  %xs_view = buffer.view %xs[%zero] : buffer -> view<4x72x32xf32>
  %xs4_view = buffer.view %xs[%zero] : buffer -> view<4x18x32x4xf32>
  %w4_view = buffer.view %w[%zero] : buffer -> view<128x18x32x4xbf16>
  %cHB = index.constant 18 : index
  %lg_bytes = index.constant 2048 : offset
  %lg = buffer.alloca<workgroup> align(16) %lg_bytes : buffer
  %lg_view = buffer.view %lg[%zero] : buffer -> view<4x128xf32>
  %tid0 = kernel.workitem.id<x> : index
  %tid = index.assume %tid0 [range(%tid0, 0, 255)] : index
  %cvec = index.constant 288 : index
  %zero32 = vector.splatf 0.0 : vector<32xf32>
  scf.for %v = [%tid to %cvec step %c256] {
    %r_value = index.div %v, %cHG : index
    %r = index.assume %r_value [range(%r_value, 0, 3)] : index
    %g_value = index.rem %v, %cHG : index
    %g = index.assume %g_value [range(%g_value, 0, 71)] : index
    %tok_value = index.add %token0, %r : index
    %tok_in = index.cmp ult, %tok_value, %tokens : index
    %tok_c = scf.select %tok_in, %tok_value, %c0 : index
    %tok = index.assume %tok_c [lt(%tok_c, %tokens)] : index
    %xg = vector.load %x_view[%tok, %g, %c0] : view<[%tokens]x72x32xf32> -> vector<32xf32>
    %xsel = scf.select %tok_in, %xg, %zero32 : vector<32xf32>
    vector.store %xsel, %xs_view[%r, %g, %c0] : vector<32xf32>, view<4x72x32xf32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %first = index.cmp eq, %lane, %c0 : index
  %cEPW = index.constant 16 : index
  %e0 = index.mul %wave, %cEPW : index
  scf.for %j = [%c0 to %cEPW step %c1] {
    %e_raw = index.add %e0, %j : index
    %e = index.assume %e_raw [range(%e_raw, 0, 127)] : index
    %p0, %p1, %p2, %p3 = scf.for %bq = [%c0 to %cHB step %c1](%a0 = %zero_f : f32, %a1 = %zero_f : f32, %a2 = %zero_f : f32, %a3 = %zero_f : f32) -> (f32, f32, f32, f32) {
      %bb = index.assume %bq [range(%bq, 0, 17)] : index
      %wraw = vector.load %w4_view[%e, %bb, %lane, %c0] : view<128x18x32x4xbf16> -> vector<4xbf16>
      %wv = vector.extf %wraw : vector<4xbf16> to vector<4xf32>
      %xv0 = vector.load %xs4_view[0, %bb, %lane, %c0] : view<4x18x32x4xf32> -> vector<4xf32>
      %d0 = vector.dotf<reassoc|contract> %wv, %xv0, %zero_f : vector<4xf32>, vector<4xf32>, f32
      %n0 = scalar.addf %a0, %d0 : f32
      %xv1 = vector.load %xs4_view[1, %bb, %lane, %c0] : view<4x18x32x4xf32> -> vector<4xf32>
      %d1 = vector.dotf<reassoc|contract> %wv, %xv1, %zero_f : vector<4xf32>, vector<4xf32>, f32
      %n1 = scalar.addf %a1, %d1 : f32
      %xv2 = vector.load %xs4_view[2, %bb, %lane, %c0] : view<4x18x32x4xf32> -> vector<4xf32>
      %d2 = vector.dotf<reassoc|contract> %wv, %xv2, %zero_f : vector<4xf32>, vector<4xf32>, f32
      %n2 = scalar.addf %a2, %d2 : f32
      %xv3 = vector.load %xs4_view[3, %bb, %lane, %c0] : view<4x18x32x4xf32> -> vector<4xf32>
      %d3 = vector.dotf<reassoc|contract> %wv, %xv3, %zero_f : vector<4xf32>, vector<4xf32>, f32
      %n3 = scalar.addf %a3, %d3 : f32
      scf.yield %n0, %n1, %n2, %n3 : f32, f32, f32, f32
    }
    %logit0 = kernel.subgroup.reduce<addf> %p0 : f32
    scf.if %first {
      view.store %logit0, %lg_view[0, %e] : f32, view<4x128xf32>
    }
    %logit1 = kernel.subgroup.reduce<addf> %p1 : f32
    scf.if %first {
      view.store %logit1, %lg_view[1, %e] : f32, view<4x128xf32>
    }
    %logit2 = kernel.subgroup.reduce<addf> %p2 : f32
    scf.if %first {
      view.store %logit2, %lg_view[2, %e] : f32, view<4x128xf32>
    }
    %logit3 = kernel.subgroup.reduce<addf> %p3 : f32
    scf.if %first {
      view.store %logit3, %lg_view[3, %e] : f32, view<4x128xf32>
    }
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %c0_i32r = scalar.constant 0 : i32
  %removed = scalar.constant -3.0e38 : f32
  %big_id = scalar.constant 1000000 : i32
  %ids_view = buffer.view %ids[%zero] : buffer -> view<[%tokens]x8xi32>
  %wts_view = buffer.view %wts[%zero] : buffer -> view<[%tokens]x8xf32>
  %wave_tok = index.cmp ult, %wave, %cTR : index
  scf.if %wave_tok {
    %r = index.assume %wave [range(%wave, 0, 3)] : index
    %tok_value = index.add %token0, %r : index
    %tok_live = index.cmp ult, %tok_value, %tokens : index
    %tok_c = scf.select %tok_live, %tok_value, %c0 : index
    %token = index.assume %tok_c [lt(%tok_c, %tokens)] : index
    %store_lane = scalar.andi %first, %tok_live : i1
    %ce0 = index.constant 0 : index
    %e0_v = index.add %lane, %ce0 : index
    %e0_in = index.cmp ult, %e0_v, %cE : index
    %e0_c = scf.select %e0_in, %e0_v, %c0 : index
    %be0 = index.assume %e0_c [range(%e0_c, 0, 127)] : index
    %id0 = index.cast %e0_v : index to i32
    %lgt0 = view.load %lg_view[%r, %be0] : view<4x128xf32> -> f32
    %pr0 = scalar.logisticf<afn> %lgt0 : f32
    %b_view0 = buffer.view %b[%zero] : buffer -> view<128xf32>
    %bias0 = view.load %b_view0[%be0] : view<128xf32> -> f32
    %sv0 = scalar.addf %pr0, %bias0 : f32
    %s0_0 = scf.select %e0_in, %sv0, %removed : f32
    %ce1 = index.constant 32 : index
    %e1_v = index.add %lane, %ce1 : index
    %e1_in = index.cmp ult, %e1_v, %cE : index
    %e1_c = scf.select %e1_in, %e1_v, %c0 : index
    %be1 = index.assume %e1_c [range(%e1_c, 0, 127)] : index
    %id1 = index.cast %e1_v : index to i32
    %lgt1 = view.load %lg_view[%r, %be1] : view<4x128xf32> -> f32
    %pr1 = scalar.logisticf<afn> %lgt1 : f32
