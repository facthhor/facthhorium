    kernel.launch @g_moe_gu_q8_0_fused_q8_k2304_r2[%nFE, %ta](%nFE, %ta, %ids, %h16q, %m_gu_47, %m_gu_47, %act) : [index, index](index, index, buffer, buffer, view<721944576xi8>, view<721944576xi8>, buffer)
    kernel.launch @g_quant_q8[%ta, %nFE](%ta, %nFE, %act, %actq) : [index, index](index, index, buffer, buffer)
    kernel.launch @g_moe_dn_q8_0_q8_k1152_r2[%nH, %ta](%nH, %ta, %ids, %actq, %m_dn_47, %ys) : [index, index](index, index, buffer, buffer, view<360972288xi8>, buffer)
  }
  scf.if %gemm {
  } else {
    kernel.launch @g_ink_moe_combine_sconv_spancap_add_c2304[%spans](%t, %spans, %slot_47, %off_fp, %metadata, %info, %origins, %arena, %ys, %wts, %fpconv_47, %ffn_inp, %x, %sc_cap) : [index](index, index, index, index, buffer, buffer, buffer, buffer, buffer, buffer, view<36864xi8>, buffer, buffer, buffer)
  }

  // ==== Final output head (n_blk=4) ====
  %out_rq = command.parameter %weights, "output_res_query.weight" : view<9216xi8>
  %output_norm = command.parameter %weights, "output_norm.weight" : view<2304xf32>
  kernel.launch @g_ink_mix5[%t, %c1](%t, %c1, %c0, %c0, %c1, %info, %blk_bank, %x, %out_rq, %mix_out) : [index, index](index, index, index, index, index, buffer, buffer, buffer, view<9216xi8>, buffer)
  kernel.launch @g_ink_rms_norm_plane[%t](%t, %c1, %c0, %mix_out, %output_norm, %h) : [index](index, index, index, buffer, view<2304xf32>, buffer)
  %tap_slot_3 = index.constant 3 : index
  kernel.launch @g_dfl_tap[%t](%t, %tap_slot_3, %h, %features) : [index](index, index, buffer, buffer)
  %head = command.parameter %weights, "output.weight" : view<492106752xi8>
  %width = config.get @llm.width : index
  %span_rows = index.mul %spans, %width : index
  %rows_uncapped = index.min %span_rows, %t : index
  %rows_cap = index.constant 128 : index
  %rows = index.min %rows_uncapped, %rows_cap : index
  %c36_o = index.constant 36 : offset
  %c16_o = index.constant 16 : offset
  %rows_records = index.scale %rows, %c36_o : index, offset -> offset
  %rows_meta_size = index.add %rows_records, %c16_o : offset
  %rows_meta = buffer.alloca<global> align(256) %rows_meta_size : buffer
  %c4_o = index.constant 4 : offset
  %pred_size = index.scale %rows, %c4_o : index, offset -> offset
  %predictions = buffer.alloca<global> align(256) %pred_size : buffer
  %vpartial_size = index.scale %rows, %partial_bytes : index, offset -> offset
  %vpartials = buffer.alloca<global> align(256) %vpartial_size : buffer
  %vlogit_size = index.scale %rows, %logit_bytes : index, offset -> offset
  %vlogits = buffer.alloca<global> align(256) %vlogit_size : buffer
  %replay_records = index.scale %spans, %c36_o : index, offset -> offset
  %replay_tables = index.scale %spans, %c4_o : index, offset -> offset
  %replay_body = index.add %replay_records, %replay_tables : offset
  %replay_size = index.add %replay_body, %c16_o : offset
  %replay = buffer.alloca<global> align(256) %replay_size : buffer
  kernel.launch @g_spec_rows(%spans, %rows, %metadata, %rows_meta) : (index, index, buffer, buffer)
  %hq2_b = index.constant 4608 : offset
  %hq2_s = index.scale %t, %hq2_b : index, offset -> offset
  %hq2 = buffer.alloca<global> align(256) %hq2_s : buffer
  %hq2_w = index.constant 2304 : index
  kernel.launch @g_quant_q8[%t, %hq2_w](%t, %hq2_w, %h, %hq2) : [index, index](index, index, buffer, buffer)
  %one_row = index.cmp eq, %rows, %c1 : index
  %hq2_c4 = index.constant 4 : index
  %hq2_le4 = index.cmp ule, %rows, %hq2_c4 : index
  scf.if %one_row {
    kernel.launch @g_head_mv_q8[%rows](%rows, %t, %rows_meta, %hq2, %head, %vpartials, %vlogits) : [index](index, index, buffer, buffer, view<492106752xi8>, buffer, buffer)
  } else {
    scf.if %hq2_le4 {
      kernel.launch @g_head_mv_t4_q8[%rows](%rows, %t, %rows_meta, %hq2, %head, %vpartials, %vlogits) : [index](index, index, buffer, buffer, view<492106752xi8>, buffer, buffer)
    } else {
      %hq2_c8 = index.constant 8 : index
      %hq2_le8 = index.cmp ule, %rows, %hq2_c8 : index
      scf.if %hq2_le8 {
        kernel.launch @g_head_mv_t8_q8[%rows](%rows, %t, %rows_meta, %hq2, %head, %vpartials, %vlogits) : [index](index, index, buffer, buffer, view<492106752xi8>, buffer, buffer)
      } else {
        kernel.launch @g_head_mv_t16_q8[%rows](%rows, %t, %rows_meta, %hq2, %head, %vpartials, %vlogits) : [index](index, index, buffer, buffer, view<492106752xi8>, buffer, buffer)
      }
    }
  }
  %tile_bytes = index.constant 65536 : offset
  %mass_size = index.scale %rows, %tile_bytes : index, offset -> offset
  %tile_mass = buffer.alloca<global> align(256) %mass_size : buffer
  kernel.launch @g_sampling_tile_mass[%rows](%rows, %rows_meta, %vlogits, %tile_mass) : [index](index, buffer, buffer, buffer)
  kernel.launch @g_head_select[%rows](%rows, %rows_meta, %vpartials, %vlogits, %predictions, %tile_mass) : [index](index, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @g_spec_accept(%spans, %rows, %t, %metadata, %tokens, %predictions, %results, %committed, %replay) : (index, index, index, buffer, buffer, buffer, buffer, buffer, buffer)
  scf.if %not_gated {
  // ---- Inkling-2 single-launch shortconv replay over all 48 logical layers (accepted tokens only)
  kernel.launch @g_ink_sconv_replay_all[%spans](%spans, %replay, %origins, %arena, %sc_cap) : [index](index, buffer, buffer, buffer, buffer)
  }
  command.return
}

config.decl @llm.epoch_spans : %value: index where [range(%value, 1, 8192)]

config.decl @llm.epoch_tokens : %value: index where [range(%value, 1, 8192)]

// DSpark warm: fuse 4 target taps [5, 23, 41, 48] -> context KV (layers 0 & 2 into SWA rings in %carry,
// layer 1 into paged FP16 %arena) + last-token f_rnn in %carry[row, 0].
command.def public target(@device) @llm_dflash_warm() launch(%w_draft: buffer, %features: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %carry: buffer, %tokens: buffer) {
