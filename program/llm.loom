    kernel.launch @g_head_mv_q8[%spans](%spans, %t, %metadata, %hq1, %head, %partials, %logits) : [index](index, index, buffer, buffer, view<492106752xi8>, buffer, buffer)
  } else {
    scf.if %hq1_le4 {
      kernel.launch @g_head_mv_t4_q8[%spans](%spans, %t, %metadata, %hq1, %head, %partials, %logits) : [index](index, index, buffer, buffer, view<492106752xi8>, buffer, buffer)
    } else {
      %hq1_c8 = index.constant 8 : index
      %hq1_le8 = index.cmp ule, %spans, %hq1_c8 : index
      scf.if %hq1_le8 {
        kernel.launch @g_head_mv_t8_q8[%spans](%spans, %t, %metadata, %hq1, %head, %partials, %logits) : [index](index, index, buffer, buffer, view<492106752xi8>, buffer, buffer)
      } else {
        kernel.launch @g_head_mv_t16_q8[%spans](%spans, %t, %metadata, %hq1, %head, %partials, %logits) : [index](index, index, buffer, buffer, view<492106752xi8>, buffer, buffer)
      }
    }
  }
  %tile_bytes = index.constant 65536 : offset
  %mass_size = index.scale %spans, %tile_bytes : index, offset -> offset
  %tile_mass = buffer.alloca<global> align(256) %mass_size : buffer
  kernel.launch @g_sampling_tile_mass[%spans](%spans, %metadata, %logits, %tile_mass) : [index](index, buffer, buffer, buffer)
  kernel.launch @g_head_select[%spans](%spans, %metadata, %partials, %logits, %outputs, %tile_mass) : [index](index, buffer, buffer, buffer, buffer, buffer)
  // Opt-in logits readback: folded away unless the card config sets llm.logits (default stages are identical without it).
  %logits_on = config.get @llm.logits : i1
  scf.if %logits_on {
    %logit_slots = config.get @llm.logit_slots : index
    kernel.launch @g_logits_export[%spans](%spans, %logit_slots, %metadata, %logits, %outputs) : [index](index, index, buffer, buffer, buffer)
  }
  command.return
}

config.decl @llm.width : %value: index where [range(%value, 2, 8)]

config.decl @llm.gated : %value: index where [range(%value, 0, 1)]

command.def public target(@device) @llm_verify() launch(%weights: buffer, %features: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %tokens: buffer, %committed: buffer, %results: buffer) {
  %gate_cfg = config.get @llm.gated : index
  %gate_zero = index.constant 0 : index
  %not_gated = index.cmp eq, %gate_cfg, %gate_zero : index
  %t = config.get @llm.tokens : index
  %spans = config.get @llm.spans : index
  %context = config.get @llm.context : index
  %pool = config.get @llm.pool : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c24 = index.constant 24 : index
  %c32 = index.constant 32 : index
  %nH = index.constant 2304 : index
  %n2H = index.constant 4608 : index
  %nQ = index.constant 3072 : index
  %nKV = index.constant 1024 : index
  %nR = index.constant 384 : index
  %nRANK = index.constant 64 : index
  %nE = index.constant 128 : index
  %nSINK = index.constant 24 : index
  %nDYN = index.constant 32 : index
  %off_k = index.constant 0 : index
  %off_v = index.constant 12288 : index
  %off_ap = index.constant 24576 : index
  %off_fp = index.constant 52224 : index
  %zero_i32 = scalar.constant 0 : i32
  %one_i32 = scalar.constant 1 : i32
  %blocks = index.div %context, %c16 : index
  %single = index.cmp eq, %t, %c1 : index
  %gemm = index.cmp uge, %t, %c64 : index
  %big = index.cmp uge, %t, %c128 : index
  %huge = index.cmp uge, %t, %c256 : index
  // Scratch allocations
  %row_bytes = index.constant 9216 : offset
  %row_size = index.scale %t, %row_bytes : index, offset -> offset
  %x = buffer.alloca<global> align(256) %row_size : buffer
  %h = buffer.alloca<global> align(256) %row_size : buffer
  %hk = buffer.alloca<global> align(256) %row_size : buffer
  %hv = buffer.alloca<global> align(256) %row_size : buffer
  %y = buffer.alloca<global> align(256) %row_size : buffer
  %y2 = buffer.alloca<global> align(256) %row_size : buffer
  %ffn_inp = buffer.alloca<global> align(256) %row_size : buffer
  %ctrl_out0 = buffer.alloca<global> align(256) %row_size : buffer
  %ctrl_out1 = buffer.alloca<global> align(256) %row_size : buffer
  %ctrl_out2 = buffer.alloca<global> align(256) %row_size : buffer
  %bank_last = buffer.alloca<global> align(256) %row_size : buffer
  // 8-slot block bank: slots 0..3 = blocks[0..3], 4 = prelude_cur, 5 = bank_b2
  %c5 = index.constant 5 : index
  %c8 = index.constant 8 : index
  %bank_size = index.scale %c8, %row_size : index, offset -> offset
  %blk_bank = buffer.alloca<global> align(256) %bank_size : buffer
  // Mix output buffers (up to 3 planes x t x H)
  %mix3_size = index.scale %c3, %row_size : index, offset -> offset
  %mix_out = buffer.alloca<global> align(256) %mix3_size : buffer
  %mix2_size = index.scale %c2, %row_size : index, offset -> offset
  %msg_attn = buffer.alloca<global> align(256) %mix2_size : buffer
  %msg_kv = buffer.alloca<global> align(256) %mix2_size : buffer
  // Decode vs Prefill sizing helpers
  %t_dec = scf.select %gemm, %c1, %t : index
  %t_pre = scf.select %gemm, %t, %c1 : index
  // Loop controller scratch: [t_dec, 2*H] (prefill uses %cat16) and [t, 64]
  %cat_bytes = index.constant 18432 : offset
  %cat_size = index.scale %t_dec, %cat_bytes : index, offset -> offset
  %cat = buffer.alloca<global> align(256) %cat_size : buffer
  %z_bytes = index.constant 256 : offset
  %z_size = index.scale %t, %z_bytes : index, offset -> offset
  %z_buf = buffer.alloca<global> align(256) %z_size : buffer
  // Attention scratch
  %q_bytes = index.constant 12288 : offset
  %q_size = index.scale %t, %q_bytes : index, offset -> offset
  %q = buffer.alloca<global> align(256) %q_size : buffer
  %gate = buffer.alloca<global> align(256) %q_size : buffer
  %att = buffer.alloca<global> align(256) %q_size : buffer
  %kv_bytes = index.constant 4096 : offset
  %kv_size = index.scale %t, %kv_bytes : index, offset -> offset
  %k_raw = buffer.alloca<global> align(256) %kv_size : buffer
  %v_raw = buffer.alloca<global> align(256) %kv_size : buffer
  %k_conv = buffer.alloca<global> align(256) %kv_size : buffer
  %v_conv = buffer.alloca<global> align(256) %kv_size : buffer
  %r_bytes = index.constant 1536 : offset
  %r_size = index.scale %t, %r_bytes : index, offset -> offset
  %r_buf = buffer.alloca<global> align(256) %r_size : buffer
  %sink_bytes = index.constant 96 : offset
  %sink_size = index.scale %t, %sink_bytes : index, offset -> offset
  %sink_buf = buffer.alloca<global> align(256) %sink_size : buffer
  %dyn_bytes = index.constant 128 : offset
  %dyn_size = index.scale %t, %dyn_bytes : index, offset -> offset
  %dyn_k = buffer.alloca<global> align(256) %dyn_size : buffer
  %dyn_v = buffer.alloca<global> align(256) %dyn_size : buffer
  // Decode split-K scratch (only sized for t < 64; 1 token dummy on prefill!)
  // The single-token global scan uses four times as many partials.
  %wide_rows = index.constant 4 : index
  %partial_rows = scf.select %single, %wide_rows, %t_dec : index
  %pm_bytes = index.constant 6144 : offset
  %pm_size = index.scale %partial_rows, %pm_bytes : index, offset -> offset
  %pm = buffer.alloca<global> align(256) %pm_size : buffer
  %pl = buffer.alloca<global> align(256) %pm_size : buffer
  %po_bytes = index.constant 786432 : offset
  %po_size = index.scale %partial_rows, %po_bytes : index, offset -> offset
  %po = buffer.alloca<global> align(256) %po_size : buffer
  // Tiny decode-only scratch for concurrent 3-way loop controls (q/k/v): <200 KiB total!
  %cat_dec_bytes = index.constant 18432 : offset
  %cat_dec_size = index.scale %t_dec, %cat_dec_bytes : index, offset -> offset
  %cat_d1 = buffer.alloca<global> align(256) %cat_dec_size : buffer
  %cat_d2 = buffer.alloca<global> align(256) %cat_dec_size : buffer
  %z_dec_bytes = index.constant 256 : offset
  %z_dec_size = index.scale %t_dec, %z_dec_bytes : index, offset -> offset
  %z_d1 = buffer.alloca<global> align(256) %z_dec_size : buffer
  %z_d2 = buffer.alloca<global> align(256) %z_dec_size : buffer
  // Prefill flash2 tile list & 16-split listed fallback scratch (sized for t on prefill, 1 on decode)
  // 8 MiB MALL-hot SWA prefill K/V scratch ([t_pre, 2, KH, D] f16, 4 KiB on decode!)
  %swa_cur_bytes = index.constant 4096 : offset
  %swa_cur_size = index.scale %t_pre, %swa_cur_bytes : index, offset -> offset
  %swa_kv_cur = buffer.alloca<global> align(256) %swa_cur_size : buffer
  %list_entry = index.constant 4 : offset
  %list_size = index.scale %t_pre, %list_entry : index, offset -> offset
  %count_size = index.constant 256 : offset
  %ti64_size = index.constant 1024 : offset
  %tile_info64 = buffer.alloca<global> align(256) %ti64_size : buffer
  %tile_info32 = buffer.alloca<global> align(256) %ti64_size : buffer
  %split_meta = buffer.alloca<global> align(256) %count_size : buffer
  %cnt256 = buffer.alloca<global> align(256) %count_size : buffer
  %cnt128 = buffer.alloca<global> align(256) %count_size : buffer
  %cnt64 = buffer.alloca<global> align(256) %count_size : buffer
  %cE64 = index.constant 8192 : index
  %cE32 = index.constant 4096 : index
  %flash_tiles = buffer.alloca<global> align(256) %list_size : buffer
  %far_ml_bytes = index.constant 96 : offset
  %far_ml_size = index.scale %t, %far_ml_bytes : index, offset -> offset
  %far_m = buffer.alloca<global> align(256) %far_ml_size : buffer
  %far_l = buffer.alloca<global> align(256) %far_ml_size : buffer
  %far_end = buffer.alloca<global> align(256) %list_size : buffer
  %fallback_list = buffer.alloca<global> align(256) %list_size : buffer
  %fallback_count = buffer.alloca<global> align(256) %count_size : buffer
  %fb_acc_bytes = index.constant 24576 : offset
  %fb_acc_size = index.scale %t_pre, %fb_acc_bytes : index, offset -> offset
  %fb_acc = buffer.alloca<global> align(256) %fb_acc_size : buffer
  %fb_ml_bytes = index.constant 384 : offset
  %fb_ml_size = index.scale %t_pre, %fb_ml_bytes : index, offset -> offset
  %fb_ml = buffer.alloca<global> align(256) %fb_ml_size : buffer
  // Prefill F16 row-scaled activation buffers (sized for %t_pre) & decode Q8 sizes (%t_dec)
  %f16_h_bytes = index.constant 4608 : offset
  %f16_q_bytes = index.constant 6144 : offset
  %f16_2h_bytes = index.constant 9216 : offset
  %scale_bytes = index.constant 8 : offset
  %ink_h16_size = index.scale %t_pre, %f16_h_bytes : index, offset -> offset
  %ink_h16q_size = index.scale %t_dec, %f16_h_bytes : index, offset -> offset
  %ink_q16_size = index.scale %t_pre, %f16_q_bytes : index, offset -> offset
  %ink_q16q_size = index.scale %t_dec, %f16_q_bytes : index, offset -> offset
  %c16_size = index.scale %t_pre, %f16_2h_bytes : index, offset -> offset
  %sc_size = index.scale %t_pre, %scale_bytes : index, offset -> offset
  %h16 = buffer.alloca<global> align(256) %ink_h16_size : buffer
  %h16q = buffer.alloca<global> align(256) %ink_h16q_size : buffer
  %s_h = buffer.alloca<global> align(256) %sc_size : buffer
  %hk16 = buffer.alloca<global> align(256) %ink_h16_size : buffer
  %hk16q = buffer.alloca<global> align(256) %ink_h16q_size : buffer
  %s_hk = buffer.alloca<global> align(256) %sc_size : buffer
  %hv16 = buffer.alloca<global> align(256) %ink_h16_size : buffer
  %hv16q = buffer.alloca<global> align(256) %ink_h16q_size : buffer
  %s_hv = buffer.alloca<global> align(256) %sc_size : buffer
  %att16 = buffer.alloca<global> align(256) %ink_q16_size : buffer
  %att16q = buffer.alloca<global> align(256) %ink_q16q_size : buffer
  %s_att = buffer.alloca<global> align(256) %sc_size : buffer
  %cat16 = buffer.alloca<global> align(256) %c16_size : buffer
  %s_cat = buffer.alloca<global> align(256) %sc_size : buffer
  // Info + Head scratch
  %info_bytes = index.constant 16 : offset
  %info_size = index.scale %t, %info_bytes : index, offset -> offset
  %info = buffer.alloca<global> align(256) %info_size : buffer
  %logit_spans = index.min %spans, %c64 : index
  %partial_bytes = index.constant 12504 : offset
  %part_size = index.scale %logit_spans, %partial_bytes : index, offset -> offset
  %partials = buffer.alloca<global> align(256) %part_size : buffer
  %logit_bytes = index.constant 800256 : offset
  %logit_size = index.scale %logit_spans, %logit_bytes : index, offset -> offset
  %logits = buffer.alloca<global> align(256) %logit_size : buffer
  // MoE scratch
  %nFS = index.constant 32 : index
  %cKU = index.constant 8 : index
  %ta = index.mul %t, %cKU : index
  %t_dec_m = scf.select %gemm, %c1, %t : index
  %nFE = index.constant 1152 : index
  %ids_bytes = index.constant 32 : offset
  %ids_size = index.scale %t, %ids_bytes : index, offset -> offset
  %ids = buffer.alloca<global> align(256) %ids_size : buffer
  %wts = buffer.alloca<global> align(256) %ids_size : buffer
  %act_bytes = index.constant 36864 : offset
  %act_size = index.scale %t_dec_m, %act_bytes : index, offset -> offset
  %act = buffer.alloca<global> align(256) %act_size : buffer
  %actq = buffer.alloca<global> align(256) %act_size : buffer
  %ys_bytes = index.constant 73728 : offset
  %ys_size = index.scale %t_dec_m, %ys_bytes : index, offset -> offset
  %ys = buffer.alloca<global> align(256) %ys_size : buffer
  %c64m = index.constant 128 : index
  %cEm = index.constant 128 : index
  %ta_tiles = index.div %ta, %c64m : index
  %max_tiles_raw = index.add %ta_tiles, %cEm : index
  %max_rows_raw = index.mul %max_tiles_raw, %c64m : index
  %max_tiles = scf.select %gemm, %max_tiles_raw, %c1 : index
  %max_rows = scf.select %gemm, %max_rows_raw, %c1 : index
  %b8 = index.constant 8 : offset
  %b4 = index.constant 4 : offset
  %ti_size = index.scale %max_tiles, %b8 : index, offset -> offset
  %tile_info = buffer.alloca<global> align(256) %ti_size : buffer
  %rm_size = index.scale %max_rows, %b4 : index, offset -> offset
  %rowmap = buffer.alloca<global> align(256) %rm_size : buffer
  %pos_size = index.scale %ta, %b4 : index, offset -> offset
  %pos = buffer.alloca<global> align(256) %pos_size : buffer
  %fe4 = index.constant 4608 : offset
  %fe2 = index.constant 2304 : offset
  %h4 = index.constant 4608 : offset
  %as_size = index.scale %c1, %fe4 : index, offset -> offset
  %act_sorted = buffer.alloca<global> align(256) %as_size : buffer
  %a16_size = index.scale %max_rows, %fe2 : index, offset -> offset
  %act16 = buffer.alloca<global> align(256) %a16_size : buffer
  %sr_size = index.scale %max_rows, %b8 : index, offset -> offset
  %s_rows = buffer.alloca<global> align(256) %sr_size : buffer
  %yss_size = index.scale %max_rows, %h4 : index, offset -> offset
  %ys_sorted = buffer.alloca<global> align(256) %yss_size : buffer

  // Parallel router logits [t, E] (2 MiB at t=4096) + small-batch expert grouping scratch
  %rl_bytes = index.constant 512 : offset
  %rl_size = index.scale %t, %rl_bytes : index, offset -> offset
  %rlogits = buffer.alloca<global> align(256) %rl_size : buffer
  %grp_e_size = index.constant 512 : offset
  %grp_exp = buffer.alloca<global> align(256) %grp_e_size : buffer
  %grp_cnt = buffer.alloca<global> align(256) %grp_e_size : buffer
  %grp_a_size = index.constant 32768 : offset
  %grp_act = buffer.alloca<global> align(256) %grp_a_size : buffer
  %nU_grp = index.min %ta, %nE : index
  %sc_cap_size = index.constant 163577856 : offset
  %sc_cap = buffer.alloca<global> align(256) %sc_cap_size : buffer
  kernel.launch @g_token_info[%t](%t, %spans, %metadata, %info) : [index](index, index, buffer, buffer)
  kernel.launch @g_ink_swa_fork_copy_all[%spans](%spans, %metadata, %origins, %arena) : [index](index, buffer, buffer, buffer)
  scf.if %gemm {
    kernel.launch @g_attention_fallback_list[%t](%t, %info, %flash_tiles, %fallback_list, %fallback_count) : [index](index, buffer, buffer, buffer, buffer)
  }
  // Embed + token_embd_norm -> %h, then copy %h -> %x so `cur` always lives in %x
  %embedding = command.parameter %weights, "token_embd.weight" : view<492106752xi8>
  %tok_norm = command.parameter %weights, "token_embd_norm.weight" : view<2304xf32>
  kernel.launch @g_embed_media[%t](%t, %tokens, %embedding, %tok_norm, %x, %h, %metadata, %info) : [index](index, buffer, view<492106752xi8>, view<2304xf32>, buffer, buffer, buffer, buffer)
  kernel.launch @g_ink_copy_buf[%t](%t, %h, %x) : [index](index, buffer, buffer)
  %loop_res_q = command.parameter %weights, "loop_res_query.weight" : view<221184xi8>
  %loop_kv_q = command.parameter %weights, "loop_kv_res_query.weight" : view<221184xi8>
  %cQLOOP = index.constant 24 : index

  // ==== step 0 (phys blk.0, pass -1, SWA, n_blk=0) ====
  %slot_0 = index.constant 0 : index
  %swa_0 = scalar.constant 1 : i32
  %an_0 = command.parameter %weights, "blk.0.attn_norm.weight" : view<2304xf32>
  scf.if %gemm {
    kernel.launch @g_ink_rms_norm_plane_f16[%t](%t, %c1, %c0, %x, %an_0, %info, %h, %s_h, %h16) : [index](index, index, index, buffer, view<2304xf32>, buffer, buffer, buffer, buffer)
  } else {
    kernel.launch @g_ink_rms_norm_plane_q8f[%t](%t, %c1, %c0, %x, %an_0, %h, %h16q) : [index](index, index, index, buffer, view<2304xf32>, buffer, buffer)
  }
  %wq_0 = command.parameter %weights, "blk.0.attn_q.weight" : view<7520256xi8>
  %wk_0 = command.parameter %weights, "blk.0.attn_k.weight" : view<2506752xi8>
  %wv_0 = command.parameter %weights, "blk.0.attn_v.weight" : view<2506752xi8>
  %wr_0 = command.parameter %weights, "blk.0.attn_rel.weight" : view<940032xi8>
  %wg_0 = command.parameter %weights, "blk.0.attn_gate.weight" : view<7520256xi8>
  %wo_0 = command.parameter %weights, "blk.0.attn_output.weight" : view<7520256xi8>
  %wsink_0 = command.parameter %weights, "blk.0.attn_sink_proj.weight" : view<110592xi8>
  %qclip_0 = command.parameter %weights, "blk.0.attn_q_clip.weight" : view<12288xi8>
  %rclip_0 = command.parameter %weights, "blk.0.attn_rel_clip.weight" : view<1536xi8>
  %rbias_0 = command.parameter %weights, "blk.0.attn_rel_bias.weight" : view<65536xi8>
  %kconv_0 = command.parameter %weights, "blk.0.attn_k_conv.weight" : view<16384xi8>
  %vconv_0 = command.parameter %weights, "blk.0.attn_v_conv.weight" : view<16384xi8>
  %apconv_0 = command.parameter %weights, "blk.0.attn_post_conv.weight" : view<36864xi8>
  %fpconv_0 = command.parameter %weights, "blk.0.ffn_post_conv.weight" : view<36864xi8>
  command.concurrent {
    %pm_c4_0 = index.constant 4 : index
    %pm_le4_0 = index.cmp ule, %t, %pm_c4_0 : index
    %pm_gt1_0 = index.cmp ugt, %t, %c1 : index
    %pm_use_0 = scalar.andi %pm_le4_0, %pm_gt1_0 : i1
    scf.if %pm_use_0 {
      kernel.launch @g_pmv_q8_0_k2304_t4_q8_r1_m5[%nQ, %nQ, %nKV, %nKV, %nR, %t](%nQ, %nQ, %nKV, %nKV, %nR, %t, %zero_i32, %h16q, %wq_0, %wg_0, %wk_0, %wv_0, %wr_0, %q, %gate, %k_raw, %v_raw, %r_buf) : [index, index, index, index, index, index](index, index, index, index, index, index, i32, buffer, view<7520256xi8>, view<7520256xi8>, view<2506752xi8>, view<2506752xi8>, view<940032xi8>, buffer, buffer, buffer, buffer, buffer)
    } else {
      command.concurrent {
      scf.if %gemm {
          scf.if %big {
            scf.if %huge {
              template.apply<@sel1_g_gemm_q8_0_store_m256>(%t, %nQ, %t, %nH, %nQ, %h16, %s_h, %wq_0, %q) : (index, index, index, index, index, buffer, buffer, view<7520256xi8>, buffer)
            } else {
              template.apply<@sel2_g_gemm_q8_0_store_m128>(%t, %nQ, %t, %nH, %nQ, %h16, %s_h, %wq_0, %q) : (index, index, index, index, index, buffer, buffer, view<7520256xi8>, buffer)
            }
          } else {
            template.apply<@sel3_g_gemm_q8_0_store>(%t, %nQ, %t, %nH, %nQ, %h16, %s_h, %wq_0, %q) : (index, index, index, index, index, buffer, buffer, view<7520256xi8>, buffer)
          }
          scf.if %big {
            scf.if %huge {
              template.apply<@sel1_g_gemm_q8_0_store_m256>(%t, %nQ, %t, %nH, %nQ, %h16, %s_h, %wg_0, %gate) : (index, index, index, index, index, buffer, buffer, view<7520256xi8>, buffer)
            } else {
              template.apply<@sel2_g_gemm_q8_0_store_m128>(%t, %nQ, %t, %nH, %nQ, %h16, %s_h, %wg_0, %gate) : (index, index, index, index, index, buffer, buffer, view<7520256xi8>, buffer)
