    %hi0 = index.add %lane, %warp : index
    %hi_id = index.min %hi0, %last_split : index
    %lo = view.load %pm_v[%tok, %hd, %lo_id] : view<[%tokens]x24x64xf32> -> f32
    %hi = view.load %pm_v[%tok, %hd, %hi_id] : view<[%tokens]x24x64xf32> -> f32
    %pair_max = scalar.maxnumf %lo, %hi : f32
    %split_max = kernel.subgroup.reduce<maxnumf> %pair_max : f32
    %mx = scalar.maxnumf %sink, %split_max : f32
    %s_sh = scalar.subf %sink, %mx : f32
    %d0 = scalar.expf<afn> %s_sh : f32
