    %w1_a = index.add %w0_a, %swidth : index
    %w1 = index.assume %w1_a [range(%w1_a, 0, 19967)] : index
    %w2_a = index.add %w1_a, %swidth : index
    %w2 = index.assume %w2_a [range(%w2_a, 0, 19967)] : index
