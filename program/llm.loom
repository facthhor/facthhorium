    }
  }
  } else {
    %lv_lane = kernel.workitem.id<x> : index
    %lv_c0 = index.constant 0 : index
    %lv_c1 = index.constant 1 : index
    %lv_first = index.cmp eq, %lv_lane, %lv_c0 : index
    scf.if %lv_first {
