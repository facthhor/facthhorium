    %slot_b = index.assume %slot_c [range(%slot_c, 0, 7)] : index
    %sq_p, %dt_p = scf.for %i = [%tid to %cH4 step %c256](%sq = %zero_f : f32, %dt = %zero_f : f32) -> (f32, f32) {
      %ch = index.assume %i [range(%i, 0, 575)] : index
      %x = scf.if %is_cur -> (vector<4xf32>) {
        %xc = vector.load %cv[%tok, %ch, %c0] : view<[%tokens]x576x4xf32> -> vector<4xf32>
        scf.yield %xc : vector<4xf32>
      } else {
        %xb = vector.load %bv[%slot_b, %tok, %ch, %c0] : view<8x[%tokens]x576x4xf32> -> vector<4xf32>
        scf.yield %xb : vector<4xf32>
      }
      %q = vector.load %qv[%q_row, %ch, %c0] : view<[%q_total]x576x4xf32> -> vector<4xf32>
      %nsq = vector.dotf<reassoc|contract> %x, %x, %sq : vector<4xf32>, vector<4xf32>, f32
      %ndt = vector.dotf<reassoc|contract> %x, %q, %dt : vector<4xf32>, vector<4xf32>, f32
      scf.yield %nsq, %ndt : f32, f32
    }
    %sq_tot = kernel.workgroup.reduce<addf> %sq_p : f32
    %dt_tot = kernel.workgroup.reduce<addf> %dt_p : f32
    %mean = scalar.mulf %sq_tot, %inv_H : f32
    %var = scalar.addf %mean, %eps : f32
    %inv_r = scalar.rsqrtf %var : f32
    %sc0 = scalar.mulf %dt_tot, %inv_r : f32
    %sc1 = scalar.mulf %sc0, %inv_sqrt_H : f32
    scf.if %is_t0 {
      view.store %sc1, %sc_v[%sb] : f32, view<8xf32>
      view.store %inv_r, %ir_v[%sb] : f32, view<8xf32>
    }
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %smax = scf.for %s = [%c0 to %n_states step %c1](%mx = %neg_inf : f32) -> (f32) {
    %sb = index.assume %s [range(%s, 0, 4)] : index
    %v = view.load %sc_v[%sb] : view<8xf32> -> f32
    %nm = scalar.maxnumf %mx, %v : f32
    scf.yield %nm : f32
  }
  %ssum = scf.for %s = [%c0 to %n_states step %c1](%sm = %zero_f : f32) -> (f32) {
    %sb = index.assume %s [range(%s, 0, 4)] : index
    %v = view.load %sc_v[%sb] : view<8xf32> -> f32
    %df = scalar.subf %v, %smax : f32
    %ex = scalar.expf<afn> %df : f32
    %ns = scalar.addf %sm, %ex : f32
    scf.yield %ns : f32
  }
  // Precompute combined weights w[s] = softmax(sc[s]) * inv_r[s] once into ir_buf
  scf.if %is_t0 {
    scf.for %s = [%c0 to %n_states step %c1] {
      %sb = index.assume %s [range(%s, 0, 4)] : index
      %sv = view.load %sc_v[%sb] : view<8xf32> -> f32
      %ir = view.load %ir_v[%sb] : view<8xf32> -> f32
      %df = scalar.subf %sv, %smax : f32
      %ex = scalar.expf<afn> %df : f32
      %pw = scalar.divf %ex, %ssum : f32
      %w = scalar.mulf %pw, %ir : f32
      view.store %w, %ir_v[%sb] : f32, view<8xf32>
    }
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  scf.for %i = [%tid to %cH4 step %c256] {
    %ch = index.assume %i [range(%i, 0, 575)] : index
    %acc = scf.for %s = [%c0 to %n_states step %c1](%a = %zero4 : vector<4xf32>) -> (vector<4xf32>) {
      %sb = index.assume %s [range(%s, 0, 4)] : index
      %is_cur = index.cmp eq, %sb, %n_blk : index
      %slot_v = index.add %slot_base, %sb : index
      %slot_c = scf.select %is_cur, %c0, %slot_v : index
      %slot_b = index.assume %slot_c [range(%slot_c, 0, 7)] : index
      %x = scf.if %is_cur -> (vector<4xf32>) {
        %xc = vector.load %cv[%tok, %ch, %c0] : view<[%tokens]x576x4xf32> -> vector<4xf32>
        scf.yield %xc : vector<4xf32>
      } else {
        %xb = vector.load %bv[%slot_b, %tok, %ch, %c0] : view<8x[%tokens]x576x4xf32> -> vector<4xf32>
        scf.yield %xb : vector<4xf32>
      }
      %w = view.load %ir_v[%sb] : view<8xf32> -> f32
      %wv = vector.splat %w : vector<4xf32>
      %na = vector.fmaf %wv, %x, %a : vector<4xf32>
      scf.yield %na : vector<4xf32>
    }
    vector.store %acc, %ov[%qi, %tok, %ch, %c0] : vector<4xf32>, view<[%q_cnt]x[%tokens]x576x4xf32>
  }
  kernel.return
}


kernel.def export("g_ink_mix2") @g_ink_mix2(%tokens: index, %q_cnt: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%tokens, %q_cnt, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %q_cnt_arg: index, %slot_base_arg: index, %q_row_off_arg: index, %q_total_arg: index, %blocks: buffer, %cur: buffer, %query: buffer, %out: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %q_cnt = index.assume %q_cnt_arg [range(%q_cnt_arg, 1, 4)] : index
  %slot = index.assume %slot_base_arg [range(%slot_base_arg, 0, 7)] : index
  %q_row_off = index.assume %q_row_off_arg [range(%q_row_off_arg, 0, 23)] : index
  %q_total = index.assume %q_total_arg [range(%q_total_arg, 1, 24)] : index
  %tok_id = kernel.workgroup.id<x> : index
  %tok = index.assume %tok_id [lt(%tok_id, %tokens)] : index
  %qi_id = kernel.workgroup.id<y> : index
  %qi = index.assume %qi_id [lt(%qi_id, %q_cnt)] : index
  %tid_raw = kernel.workitem.id<x> : index
  %tid = index.assume %tid_raw [range(%tid_raw, 0, 255)] : index
  %c0 = index.constant 0 : index
  %c256 = index.constant 256 : index
  %c512 = index.constant 512 : index
  %cH4 = index.constant 576 : index
  %zero = index.constant 0 : offset
  %zero_f = scalar.constant 0.0 : f32
  %zero4 = vector.splatf 0.0 : vector<4xf32>
  %eps = scalar.constant 9.999999974752427e-07 : f32
  %inv_H = scalar.constant 0.00043402777777777775 : f32
  %inv_sqrt_H = scalar.constant 0.020833333333333332 : f32
  %q_row_v = index.add %q_row_off, %qi : index
  %q_row = index.assume %q_row_v [lt(%q_row_v, %q_total)] : index
  %bv = buffer.view %blocks[%zero] : buffer -> view<8x[%tokens]x576x4xf32>
  %cv = buffer.view %cur[%zero] : buffer -> view<[%tokens]x576x4xf32>
  %qv = buffer.view %query[%zero] : buffer -> view<[%q_total]x576x4xf32>
  %ov = buffer.view %out[%zero] : buffer -> view<[%q_cnt]x[%tokens]x576x4xf32>
  %i0 = index.assume %tid [range(%tid, 0, 575)] : index
  %i1_raw = index.add %tid, %c256 : index
  %i1 = index.assume %i1_raw [range(%i1_raw, 0, 575)] : index
  %i2_raw = index.add %tid, %c512 : index
  %has2 = index.cmp ult, %i2_raw, %cH4 : index
  // Load 3 vec4s of state 0 (block) and state 1 (cur) ONCE into registers!
  %a0 = vector.load %bv[%slot, %tok, %i0, %c0] : view<8x[%tokens]x576x4xf32> -> vector<4xf32>
  %b0 = vector.load %cv[%tok, %i0, %c0] : view<[%tokens]x576x4xf32> -> vector<4xf32>
  %q0 = vector.load %qv[%q_row, %i0, %c0] : view<[%q_total]x576x4xf32> -> vector<4xf32>
  %a1 = vector.load %bv[%slot, %tok, %i1, %c0] : view<8x[%tokens]x576x4xf32> -> vector<4xf32>
  %b1 = vector.load %cv[%tok, %i1, %c0] : view<[%tokens]x576x4xf32> -> vector<4xf32>
  %q1 = vector.load %qv[%q_row, %i1, %c0] : view<[%q_total]x576x4xf32> -> vector<4xf32>
  %a2, %b2, %q2 = scf.if %has2 -> (vector<4xf32>, vector<4xf32>, vector<4xf32>) {
    %i2 = index.assume %i2_raw [range(%i2_raw, 0, 575)] : index
    %xa = vector.load %bv[%slot, %tok, %i2, %c0] : view<8x[%tokens]x576x4xf32> -> vector<4xf32>
    %xb = vector.load %cv[%tok, %i2, %c0] : view<[%tokens]x576x4xf32> -> vector<4xf32>
    %xq = vector.load %qv[%q_row, %i2, %c0] : view<[%q_total]x576x4xf32> -> vector<4xf32>
    scf.yield %xa, %xb, %xq : vector<4xf32>, vector<4xf32>, vector<4xf32>
  } else {
    scf.yield %zero4, %zero4, %zero4 : vector<4xf32>, vector<4xf32>, vector<4xf32>
  }
  %sqa0 = vector.dotf<reassoc|contract> %a0, %a0, %zero_f : vector<4xf32>, vector<4xf32>, f32
  %sqa1 = vector.dotf<reassoc|contract> %a1, %a1, %sqa0 : vector<4xf32>, vector<4xf32>, f32
  %sqa2 = vector.dotf<reassoc|contract> %a2, %a2, %sqa1 : vector<4xf32>, vector<4xf32>, f32
  %dta0 = vector.dotf<reassoc|contract> %a0, %q0, %zero_f : vector<4xf32>, vector<4xf32>, f32
  %dta1 = vector.dotf<reassoc|contract> %a1, %q1, %dta0 : vector<4xf32>, vector<4xf32>, f32
  %dta2 = vector.dotf<reassoc|contract> %a2, %q2, %dta1 : vector<4xf32>, vector<4xf32>, f32
