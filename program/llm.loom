// Load-time weight preparation (draft/prep_weights.py): staged F32E tensor (input + llm.prep_input) ->
// BF16C blocks in output, one lane per 32-value block.
kernel.def export("g_prep_f32e_bf16c") @g_prep_f32e_bf16c(%blocks: index) {
  %c1 = index.constant 1 : index
  %c63 = index.constant 63 : index
  %c64 = index.constant 64 : index
  %rounded = index.add %blocks, %c63 : index
  %groups = index.div %rounded, %c64 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%blocks_arg: index, %in64: i64, %output: buffer, %input: buffer) {
  %blocks = index.assume %blocks_arg [range(%blocks_arg, 1, 1073741824)] : index
  %in_bound = scalar.assume %in64 [range(%in64, 0, 9223372036854775807)] : i64
  %in_origin = index.cast %in_bound : i64 to offset
  %c64 = index.constant 64 : index
  %wg = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %base = index.mul %wg, %c64 : index
  %g = index.add %base, %lane : index
  %live = index.cmp ult, %g, %blocks : index
  scf.if %live {
    %ib = index.constant 4 : offset
    %io = index.scale %g, %ib : index, offset -> offset
    %ia = index.add %in_origin, %io : offset
    %src_view = buffer.view %input[%ia] : buffer -> view<1xi32>
    %raw = view.load %src_view[0] : view<1xi32> -> i32
    %c16 = scalar.constant 16 : i32
    %hi = scalar.shrui %raw, %c16 : i32
    %h16 = scalar.trunci %hi : i32 to i16
    %ob = index.constant 2 : offset
    %oo = index.scale %g, %ob : index, offset -> offset
    %o_view = buffer.view %output[%oo] : buffer -> view<1xi16>
    view.store %h16, %o_view[0] : i16, view<1xi16>
  }
  kernel.return
}

command.def public target(@device) @llm_prep_f32e_bf16c() launch(%output: buffer, %input: buffer) {
  %b64 = config.get @llm.prep_blocks : i64
  %blocks = index.cast %b64 : i64 to index
  %in64 = config.get @llm.prep_input : i64
  kernel.launch @g_prep_f32e_bf16c[%blocks](%blocks, %in64, %output, %input) : [index](index, i64, buffer, buffer)
  command.return
}

kernel.def export("g_embed_media") @g_embed_media(%tokens: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %ids: buffer, %table: buffer, %w: buffer, %x: buffer, %h: buffer, %metadata: buffer, %info: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %token_id = kernel.workgroup.id<x> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %lane_id = kernel.workitem.id<x> : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 255)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c8 = index.constant 1 : index
  %groups = index.constant 72 : index
  %zero_f = scalar.constant 0.0 : f32
  %c0_i32 = scalar.constant 0 : i32
  %c1 = index.constant 1 : index
  %metadata_view = buffer.view %metadata[%zero] : buffer -> view<4xi32>
  %mode = view.load %metadata_view[2] : view<4xi32> -> i32
  %mixed = scalar.cmpi ne, %mode, %c0_i32 : i32
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %live_word = view.load %info_view[%token, 2] : view<[%tokens]x4xi32> -> i32
  %live = scalar.cmpi ne, %live_word, %c0_i32 : i32
  %raw, %feature = scf.if %mixed -> (i32, i32) {
    %records = buffer.view %ids[%zero] : buffer -> view<[%tokens]x8xi32>
    %id, %feature_at = scf.if %live -> (i32, i32) {
      %token_id = view.load %records[%token, %c0] : view<[%tokens]x8xi32> -> i32
      %feat = view.load %records[%token, %c1] : view<[%tokens]x8xi32> -> i32
      scf.yield %token_id, %feat : i32, i32
    } else {
      scf.yield %c0_i32, %c0_i32 : i32, i32
    }
    scf.yield %id, %feature_at : i32, i32
  } else {
    %ids_view = buffer.view %ids[%zero] : buffer -> view<[%tokens]xi32>
    %id = view.load %ids_view[%token] : view<[%tokens]xi32> -> i32
    scf.yield %id, %c0_i32 : i32, i32
  }
  %is_feature = scalar.cmpi ne, %feature, %c0_i32 : i32
  %vocab_last = scalar.constant 200057 : i32
  %low = scalar.maxsi %raw, %c0_i32 : i32
  %clamped = scalar.minsi %low, %vocab_last : i32
  %bounded = scalar.assume %clamped [range(%clamped, 0, 200057)] : i32
  %id = index.cast %bounded : i32 to index
