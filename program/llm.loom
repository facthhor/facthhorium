  %oa0_invb2 = vector.splatf 0.5 : vector<8xf32>
  %oa0_lb = vector.splatf 25.0 : vector<8xf32>
  %oa0_invlb2 = vector.splatf 0.08 : vector<8xf32>
  %oa0_two = vector.splatf 2.0 : vector<8xf32>
  %oa0_one = vector.splatf 1.0 : vector<8xf32>
  %oa0_g2 = vector.mulf %g0s, %oa0_invb2 : vector<8xf32>
