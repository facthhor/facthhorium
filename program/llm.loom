    %inverse_exp = scalar.addi %c127, %e : i32
    %scale_bits = scalar.shli %scale_exp, %c23 : i32
    %inverse_bits = scalar.shli %inverse_exp, %c23 : i32
    %scale_f = scalar.bitcast %scale_bits : i32 to f32
    %inv_scale_f = scalar.bitcast %inverse_bits : i32 to f32
    scf.if %is_t0 {
      view.store %scale_f, %scv[%tok, %c0] : f32, view<[%tokens]x2xf32>
      view.store %inv_scale_f, %scv[%tok, %c1] : f32, view<[%tokens]x2xf32>
    }
    %scv4 = vector.splat %scale_f : vector<4xf32>
    %p0 = vector.mulf %y0, %scv4 : vector<4xf32>
    %h0 = vector.fptrunc %p0 : vector<4xf32> to vector<4xf16>
    vector.store %h0, %h16v[%tok, %i0, %c0] : vector<4xf16>, view<[%tokens]x576x4xf16>
