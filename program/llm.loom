    %va1 = vector.fmaf %vwt1, %vh1, %va0 : vector<4xf32>
    %va2 = vector.fmaf %vwt2, %vh2, %va1 : vector<4xf32>
    %va3 = vector.fmaf %vwt3, %vx3, %va2 : vector<4xf32>
    %vres = vector.addf %vx3, %va3 : vector<4xf32>
