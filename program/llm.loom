    %deq1_within_n = index.rem %w_col_n, %deq1_bv_n : index
    %deq1_sub_v_n = index.div %deq1_within_n, %c16 : index
    %deq1_sub_n = index.assume %deq1_sub_v_n [range(%deq1_sub_v_n, 0, 3)] : index
    %deq1_block_add_n = index.scale %deq1_block_n, %block_bytes : index, offset -> offset
    %deq1_block_origin_n = index.add %w2_row_origin, %deq1_block_add_n : offset
    %deq1_c4o_n = index.constant 4 : offset
    %deq1_c8o_n = index.constant 8 : offset
