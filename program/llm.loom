} launch(%tokens_arg: index, %use_dn_scale: i32, %logits: buffer, %bias: buffer, %dn_scale: buffer, %ids: buffer, %wts: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
