    %mn4 = scalar.mulf %tsq4, %inv_H : f32
    %vr4 = scalar.addf %mn4, %eps : f32
    %ir4 = scalar.rsqrtf %vr4 : f32
    %sc4_a = scalar.mulf %tdt4, %ir4 : f32
    %sc4 = scalar.mulf %sc4_a, %inv_sqrt_H : f32
    %mx0 = scalar.maxnumf %sc0, %sc1 : f32
    %mx1 = scalar.maxnumf %mx0, %sc2 : f32
    %mx2 = scalar.maxnumf %mx1, %sc3 : f32
    %mx3 = scalar.maxnumf %mx2, %sc4 : f32
    %df0 = scalar.subf %sc0, %mx3 : f32
    %ex0 = scalar.expf<afn> %df0 : f32
    %df1 = scalar.subf %sc1, %mx3 : f32
    %ex1 = scalar.expf<afn> %df1 : f32
    %df2 = scalar.subf %sc2, %mx3 : f32
    %ex2 = scalar.expf<afn> %df2 : f32
    %df3 = scalar.subf %sc3, %mx3 : f32
    %ex3 = scalar.expf<afn> %df3 : f32
