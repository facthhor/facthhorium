    %tot_7 = scalar.addf %s2_7, %sh1_7 : f32
    %val_7 = scf.select %is_lg0, %tot_7, %ninf : f32
    %r32_7 = index.cast %r7 : index to i32
    %gt_7 = scalar.cmpf ogt, %val_7, %bv_6 : f32
    %eq_7 = scalar.cmpf oeq, %val_7, %bv_6 : f32
    %lt_7 = scalar.cmpi slt, %r32_7, %bi_6 : i32
    %tie_7 = scalar.andi %eq_7, %lt_7 : i1
    %win_7 = scalar.ori %gt_7, %tie_7 : i1
    %bv_7 = scf.select %win_7, %val_7, %bv_6 : f32
    %bi_7 = scf.select %win_7, %r32_7, %bi_6 : i32
    %wg_best = kernel.workgroup.reduce<maxnumf> %bv_7 : f32
    %is_b = scalar.cmpf oeq, %bv_7, %wg_best : f32
    %cand = scf.select %is_b, %bi_7, %big : i32
    %wg_row = kernel.workgroup.reduce<minsi> %cand : i32
    %is_w0 = index.cmp eq, %wid, %c0 : index
