  %in_r = index.cmp ult, %row, %c16_r : index
  %g0 = scalar.andi %active, %in_c : i1
  %go = scalar.andi %g0, %in_r : i1
  scf.if %go {
    %ch = index.assume %ch_raw [range(%ch_raw, 0, 6655)] : index
    %rb = index.assume %row [range(%row, 0, 15)] : index
    // Map ch in [0..6655] to (stream_elem_base, stream_width, local_ch):
    //   [0, 1024):     K  base=0,     C=1024
    //   [1024, 2048):  V  base=3072,  C=1024
    //   [2048, 4352):  AP base=6144,  C=2304
    //   [4352, 6656):  FP base=13056, C=2304
    %cKD = index.constant 1024 : index
    %c2KD = index.constant 2048 : index
    %cAP = index.constant 4352 : index
    %cH = index.constant 2304 : index
    %is_k = index.cmp ult, %ch, %cKD : index
    %is_kv = index.cmp ult, %ch, %c2KD : index
    %is_ap = index.cmp ult, %ch, %cAP : index
