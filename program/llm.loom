        %ms = scalar.subf %m, %nm : f32
        %al = scalar.expf<afn> %ms : f32
        %ls = scalar.mulf %l, %al : f32
        %alv = vector.splat %al : vector<4xf32>
        %as = vector.mulf %acc, %alv : vector<4xf32>
        %ds = scalar.subf %s, %nm : f32
        %pv = scalar.expf<afn> %ds : f32
        %nl = scalar.addf %ls, %pv : f32
        %pvv = vector.splat %pv : vector<4xf32>
        %na = vector.fmaf %pvv, %v4, %as : vector<4xf32>
        scf.yield %nm, %nl, %na : f32, f32, vector<4xf32>
      }
      %acc_v = buffer.view %part_acc[%zero] : buffer -> view<[%tokens]x24x2x32x4xf32>
      vector.store %af, %acc_v[%token, %hd, %sp, %lane, %c0] : vector<4xf32>, view<[%tokens]x24x2x32x4xf32>
      %is_l0 = index.cmp eq, %lane, %c0 : index
      scf.if %is_l0 {
        %ml_v = buffer.view %part_ml[%zero] : buffer -> view<[%tokens]x24x2x2xf32>
        view.store %mf, %ml_v[%token, %hd, %sp, 0] : f32, view<[%tokens]x24x2x2xf32>
        view.store %lf, %ml_v[%token, %hd, %sp, 1] : f32, view<[%tokens]x24x2x2xf32>
      }
    }
  }
  kernel.return
}


kernel.def export("g_logits_export") @g_logits_export(%spans: index) {
  %c1 = index.constant 1 : index
  %chunks = index.constant 1563 : index
  %c128 = index.constant 128 : index
  kernel.launch.config workgroups(%spans, %chunks, %c1) workgroup_size(%c128, %c1, %c1) : index
} launch(%spans_arg: index, %slots: index, %metadata: buffer, %logits: buffer, %outputs: buffer) {
  %spans = index.assume %spans_arg [range(%spans_arg, 1, 8192)] : index
  %span_id = kernel.workgroup.id<x> : index
  %span = index.assume %span_id [lt(%span_id, %spans)] : index
  %chunk_id = kernel.workgroup.id<y> : index
  %chunk = index.assume %chunk_id [range(%chunk_id, 0, 1562)] : index
  %lane_id = kernel.workitem.id<x> : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 127)] : index
  %zero = index.constant 0 : offset
  %c16 = index.constant 16 : offset
  %c128 = index.constant 128 : index
  %vocab = index.constant 200058 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %flag = scalar.constant 1073741824 : i32
  %header = buffer.view %metadata[%zero] : buffer -> view<4xi32>
  %count32 = view.load %header[0] : view<4xi32> -> i32
  %count_bound = scalar.assume %count32 [range(%count32, 0, 8192)] : i32
  %count = index.cast %count_bound : i32 to index
  %live_span = index.cmp ult, %span, %count : index
  scf.if %live_span {
    %packets = buffer.view %metadata[%c16] : buffer -> view<[%spans]x9xi32>
    %flags = view.load %packets[%span, 6] : view<[%spans]x9xi32> -> i32
    %bits = scalar.andi %flags, %c1_i32 : i32
    %selected = scalar.cmpi ne, %bits, %c0_i32 : i32
    %top_k = view.load %packets[%span, 7] : view<[%spans]x9xi32> -> i32
    %wanted_bits = scalar.andi %top_k, %flag : i32
    %wanted = scalar.cmpi ne, %wanted_bits, %c0_i32 : i32
    %wanted_row = scalar.andi %selected, %wanted : i1
    %has_slot = index.cmp ult, %span, %slots : index
    %export = scalar.andi %wanted_row, %has_slot : i1
    scf.if %export {
      %base = index.mul %chunk, %c128 : index
      %column = index.add %base, %lane : index
      %logit_view = buffer.view %logits[%zero] : buffer -> view<[%spans]x200064xf32>
      %x = view.load %logit_view[%span, %column] : view<[%spans]x200064xf32> -> f32
      %sc_k = scalar.constant 0.03333333333333333 : f32
      %sc_y = scalar.mulf %x, %sc_k : f32
      %sc_y2 = scalar.addf %sc_y, %sc_y : f32
      %sc_e = scalar.expf<afn> %sc_y2 : f32
      %sc_one = scalar.constant 1.0 : f32
      %sc_two = scalar.constant 2.0 : f32
      %sc_d = scalar.addf %sc_e, %sc_one : f32
      %sc_q = scalar.divf %sc_two, %sc_d : f32
      %sc_t = scalar.subf %sc_one, %sc_q : f32
      %sc_cap = scalar.constant 30.0 : f32
      %sc_v = scalar.mulf %sc_t, %sc_cap : f32
