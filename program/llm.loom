    scf.yield %live_ng0_3, %live_ng1_3, %live_nu0_3, %live_nu1_3, %x_half_raw_n, %deq0_b0_n, %deq0_payload_n, %deq1_b0_n, %deq1_payload_n : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<16xf16>, i8, vector<8xi8>, i8, vector<8xi8>
  }
  %inv_bytes = index.constant 4096 : offset
  %inv_view = buffer.view %x_stage[%origin] : buffer -> view<64x16xf32>
  %writer = index.cmp ult, %workitem, %c64 : index
  scf.if %writer {
    %inv_row_value = index.add %row_origin, %workitem : index
  %gi_prow_v = index.add %inv_row_value, %c0 : index
  %gi_rm_rows = index.mul %row_tile_count, %c64 : index
  %gi_prow = index.assume %gi_prow_v [lt(%gi_prow_v, %gi_rm_rows)] : index
  %gi_rm_view = buffer.view %rowmap[%origin] : buffer -> view<[%gi_rm_rows]xi32>
  %gi_a32 = view.load %gi_rm_view[%gi_prow] : view<[%gi_rm_rows]xi32> -> i32
  %gi_valid = scalar.cmpi sge, %gi_a32, %c0_i32g : i32
  %gi_ac = scalar.maxsi %gi_a32, %c0_i32g : i32
