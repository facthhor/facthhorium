    scf.for %rr = [%c0 to %c64 step %c1] {
      %rrb = index.assume %rr [range(%rr, 0, 63)] : index
      %mul_r = view.load %sql_v[%c0, %rrb] : view<2x64xf32> -> f32
      %r_live = scalar.cmpf une, %mul_r, %zero_f : f32
      scf.if %r_live {
        %pt_raw = index.add %t_base, %rrb : index
        %pt = index.assume %pt_raw [lt(%pt_raw, %tokens)] : index
        %mv4 = vector.splat %mul_r : vector<4xf32>
        %x4_0 = vector.load %tv4[%pt, %j0, %c0] : view<[%tokens]x576x4xf32> -> vector<4xf32>
        %q4_0a = vector.mulf %x4_0, %w4_0 : vector<4xf32>
        %q4_0 = vector.mulf %q4_0a, %mv4 : vector<4xf32>
        %h4_0 = vector.fptrunc %q4_0 : vector<4xf32> to vector<4xf16>
        vector.store %h4_0, %o16v[%pt, %j0, %c0] : vector<4xf16>, view<[%tokens]x576x4xf16>
        %x4_1 = vector.load %tv4[%pt, %j1, %c0] : view<[%tokens]x576x4xf32> -> vector<4xf32>
        %q4_1a = vector.mulf %x4_1, %w4_1 : vector<4xf32>
        %q4_1 = vector.mulf %q4_1a, %mv4 : vector<4xf32>
        %h4_1 = vector.fptrunc %q4_1 : vector<4xf32> to vector<4xf16>
        vector.store %h4_1, %o16v[%pt, %j1, %c0] : vector<4xf16>, view<[%tokens]x576x4xf16>
        %x4_2 = vector.load %tv4[%pt, %j2, %c0] : view<[%tokens]x576x4xf32> -> vector<4xf32>
        %q4_2a = vector.mulf %x4_2, %w4_2 : vector<4xf32>
        %q4_2 = vector.mulf %q4_2a, %mv4 : vector<4xf32>
        %h4_2 = vector.fptrunc %q4_2 : vector<4xf32> to vector<4xf16>
        vector.store %h4_2, %o16v[%pt, %j2, %c0] : vector<4xf16>, view<[%tokens]x576x4xf16>
        %x4_3 = vector.load %tv4[%pt, %j3, %c0] : view<[%tokens]x576x4xf32> -> vector<4xf32>
        %q4_3a = vector.mulf %x4_3, %w4_3 : vector<4xf32>
        %q4_3 = vector.mulf %q4_3a, %mv4 : vector<4xf32>
        %h4_3 = vector.fptrunc %q4_3 : vector<4xf32> to vector<4xf16>
        vector.store %h4_3, %o16v[%pt, %j3, %c0] : vector<4xf16>, view<[%tokens]x576x4xf16>
        scf.if %has_j4 {
          %j4p = index.assume %j4_v [range(%j4_v, 0, 575)] : index
