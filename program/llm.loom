    %vw0_1 = view.load %vwv[%kh, %lane, 1, 0] : view<8x32x4x4xf32> -> f32
    %vw0_2 = view.load %vwv[%kh, %lane, 2, 0] : view<8x32x4x4xf32> -> f32
    %vw0_3 = view.load %vwv[%kh, %lane, 3, 0] : view<8x32x4x4xf32> -> f32
