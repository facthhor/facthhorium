  %live32 = view.load %info_v[%token, 2] : view<[%tokens]x4xi32> -> i32
  %live = scalar.cmpi ne, %live32, %c0_i32 : i32
  scf.if %live {
    %row32 = view.load %info_v[%token, 0] : view<[%tokens]x4xi32> -> i32
    %pos32 = view.load %info_v[%token, 1] : view<[%tokens]x4xi32> -> i32
    %row_b = scalar.assume %row32 [range(%row32, 0, 2147483646)] : i32
    %pos_b = scalar.assume %pos32 [range(%pos32, 0, 1048575)] : i32
    %row = index.cast %row_b : i32 to index
    %pos = index.cast %pos_b : i32 to index
    %is_swa = scalar.constant true : i1
    %far = index.cmp uge, %pos, %cWIN : index
    %use_win = scalar.andi %is_swa, %far : i1
    %win_start = index.sub %pos, %cWIN1 : index
    %w_low = scf.select %use_win, %win_start, %c0 : index
    %end = index.add %pos, %c1 : index
    %vis_val = index.sub %end, %w_low : index
    %vis = index.assume %vis_val [range(%vis_val, 1, 1048576)] : index
    %s_eff = index.min %vis, %cS : index
    %active_split = index.cmp ult, %sp, %s_eff : index
    scf.if %active_split {
      %s_less = index.sub %s_eff, %c1 : index
      %per_pad = index.add %vis, %s_less : index
      %per = index.div %per_pad, %s_eff : index
      %st0 = index.mul %sp, %per : index
      %st = index.min %st0, %vis : index
      %en0 = index.add %st, %per : index
      %en = index.min %en0, %vis : index
      %span32 = view.load %info_v[%token, 3] : view<[%tokens]x4xi32> -> i32
      %span_b = scalar.assume %span32 [range(%span32, 0, 8191)] : i32
      %span = index.cast %span_b : i32 to index
      %sp_act, %sp_len, %sp_start32, %sp_row, %sp_first = func.call @g_gdn_span(%metadata, %spans, %span) : (buffer, index, index) -> (i1, index, i32, index, index)
      %sp_start_b = scalar.assume %sp_start32 [range(%sp_start32, 0, 1048575)] : i32
      %sp_start = index.cast %sp_start_b : i32 to index
      %ring_rd, %ring_wr, %ring_fr = func.call @g_gdn_slots(%origins, %row, %sp_start32, %swa_off) : (buffer, index, i32, offset) -> (offset, offset, i1)
      %pos_bytes = index.constant 2048 : offset
      %ring_v_stride = index.constant 2097152 : offset
      %swa_cur_v = buffer.view %swa_cur[%zero] : buffer -> view<[%tokens]x2x8x32x4xf16>
      %qv = buffer.view %q[%zero] : buffer -> view<[%tokens]x24x32x4xf32>
      %q_raw = vector.load %qv[%token, %hd, %lane, %c0] : view<[%tokens]x24x32x4xf32> -> vector<4xf32>
      %q4 = vector.mulf %q_raw, %scale4 : vector<4xf32>
      %rv = buffer.view %r[%zero] : buffer -> view<[%tokens]x24x16xf32>
      %r16 = vector.load %rv[%token, %hd, %c0] : view<[%tokens]x24x16xf32> -> vector<16xf32>
      %rbv = buffer.view %rel_bias[%zero] : buffer -> view<1024x16xf32>
      %mf, %lf, %af = scf.for %k = [%st to %en step %c1](%m = %neg_big : f32, %l = %zero_f : f32, %acc = %zero4 : vector<4xf32>) -> (f32, f32, vector<4xf32>) {
        %kp_raw = index.add %w_low, %k : index
        %kp = index.assume %kp_raw [range(%kp_raw, 0, 1048575)] : index
        %in_cur = index.cmp uge, %kp, %sp_start : index
        %kh16, %vh16 = scf.if %in_cur -> (vector<4xf16>, vector<4xf16>) {
          %rel = index.sub %kp, %sp_start : index
          %tk_v = index.add %sp_first, %rel : index
          %tk = index.assume %tk_v [range(%tk_v, 0, 8191), lt(%tk_v, %tokens)] : index
          %khc = vector.load %swa_cur_v[%tk, %c0, %kh, %lane, %c0] : view<[%tokens]x2x8x32x4xf16> -> vector<4xf16>
          %vhc = vector.load %swa_cur_v[%tk, %c1, %kh, %lane, %c0] : view<[%tokens]x2x8x32x4xf16> -> vector<4xf16>
          scf.yield %khc, %vhc : vector<4xf16>, vector<4xf16>
        } else {
          %rp = index.rem %kp, %cWIN : index
          %rpo = index.scale %rp, %pos_bytes : index, offset -> offset
          %ko = index.add %ring_rd, %rpo : offset
          %vo = index.add %ko, %ring_v_stride : offset
          %kc = buffer.view %arena[%ko] : buffer -> view<8x32x4xf16>
          %vc = buffer.view %arena[%vo] : buffer -> view<8x32x4xf16>
          %kho = vector.load %kc[%kh, %lane, %c0] : view<8x32x4xf16> -> vector<4xf16>
          %vho = vector.load %vc[%kh, %lane, %c0] : view<8x32x4xf16> -> vector<4xf16>
          scf.yield %kho, %vho : vector<4xf16>, vector<4xf16>
        }
        %k4 = vector.extf %kh16 : vector<4xf16> to vector<4xf32>
        %v4 = vector.extf %vh16 : vector<4xf16> to vector<4xf32>
        %p4 = vector.dotf<reassoc|contract> %q4, %k4, %zero_f : vector<4xf32>, vector<4xf32>, f32
        %s_qk = kernel.subgroup.reduce<addf> %p4 : f32
        %dist = index.sub %pos, %kp : index
        %in_ext = index.cmp ult, %dist, %cEXT : index
        %rb = scf.if %in_ext -> (f32) {
          %db = index.assume %dist [range(%dist, 0, 1023)] : index
          %bv = vector.load %rbv[%db, %c0] : view<1024x16xf32> -> vector<16xf32>
          %rd = vector.dotf<reassoc|contract> %r16, %bv, %zero_f : vector<16xf32>, vector<16xf32>, f32
          scf.yield %rd : f32
        } else {
          scf.yield %zero_f : f32
        }
        %s = scalar.addf %s_qk, %rb : f32
        %nm = scalar.maxnumf %m, %s : f32
        %ms = scalar.subf %m, %nm : f32
        %al = scalar.expf<afn> %ms : f32
        %ls = scalar.mulf %l, %al : f32
        %alv = vector.splat %al : vector<4xf32>
        %as = vector.mulf %acc, %alv : vector<4xf32>
        %ds = scalar.subf %s, %nm : f32
        %pv = scalar.expf<afn> %ds : f32
        %nl = scalar.addf %ls, %pv : f32
        %pvv = vector.splat %pv : vector<4xf32>
        %na = vector.fmaf %pvv, %v4, %as : vector<4xf32>
        scf.yield %nm, %nl, %na : f32, f32, vector<4xf32>
      }
      %acc_v = buffer.view %part_acc[%zero] : buffer -> view<[%tokens]x24x16x32x4xf32>
      vector.store %af, %acc_v[%token, %hd, %sp, %lane, %c0] : vector<4xf32>, view<[%tokens]x24x16x32x4xf32>
      %is_l0 = index.cmp eq, %lane, %c0 : index
      scf.if %is_l0 {
        %ml_v = buffer.view %part_ml[%zero] : buffer -> view<[%tokens]x24x16x2xf32>
        view.store %mf, %ml_v[%token, %hd, %sp, 0] : f32, view<[%tokens]x24x16x2xf32>
        view.store %lf, %ml_v[%token, %hd, %sp, 1] : f32, view<[%tokens]x24x16x2xf32>
      }
    }
  }
  kernel.return
}


kernel.def export("g_logits_export") @g_logits_export(%spans: index) {
  %c1 = index.constant 1 : index
  %chunks = index.constant 1563 : index
  %c128 = index.constant 128 : index
  kernel.launch.config workgroups(%spans, %chunks, %c1) workgroup_size(%c128, %c1, %c1) : index
} launch(%spans_arg: index, %slots: index, %metadata: buffer, %logits: buffer, %outputs: buffer) {
  %spans = index.assume %spans_arg [range(%spans_arg, 1, 8192)] : index
  %span_id = kernel.workgroup.id<x> : index
  %span = index.assume %span_id [lt(%span_id, %spans)] : index
  %chunk_id = kernel.workgroup.id<y> : index
  %chunk = index.assume %chunk_id [range(%chunk_id, 0, 1562)] : index
  %lane_id = kernel.workitem.id<x> : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 127)] : index
  %zero = index.constant 0 : offset
  %c16 = index.constant 16 : offset
  %c128 = index.constant 128 : index
  %vocab = index.constant 200058 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %flag = scalar.constant 1073741824 : i32
  %header = buffer.view %metadata[%zero] : buffer -> view<4xi32>
  %count32 = view.load %header[0] : view<4xi32> -> i32
  %count_bound = scalar.assume %count32 [range(%count32, 0, 8192)] : i32
  %count = index.cast %count_bound : i32 to index
  %live_span = index.cmp ult, %span, %count : index
  scf.if %live_span {
    %packets = buffer.view %metadata[%c16] : buffer -> view<[%spans]x9xi32>
    %flags = view.load %packets[%span, 6] : view<[%spans]x9xi32> -> i32
    %bits = scalar.andi %flags, %c1_i32 : i32
    %selected = scalar.cmpi ne, %bits, %c0_i32 : i32
    %top_k = view.load %packets[%span, 7] : view<[%spans]x9xi32> -> i32
    %wanted_bits = scalar.andi %top_k, %flag : i32
    %wanted = scalar.cmpi ne, %wanted_bits, %c0_i32 : i32
    %wanted_row = scalar.andi %selected, %wanted : i1
    %has_slot = index.cmp ult, %span, %slots : index
    %export = scalar.andi %wanted_row, %has_slot : i1
    scf.if %export {
      %base = index.mul %chunk, %c128 : index
      %column = index.add %base, %lane : index
      %logit_view = buffer.view %logits[%zero] : buffer -> view<[%spans]x200064xf32>
      %x = view.load %logit_view[%span, %column] : view<[%spans]x200064xf32> -> f32
      %sc_k = scalar.constant 0.03333333333333333 : f32
      %sc_y = scalar.mulf %x, %sc_k : f32
      %sc_y2 = scalar.addf %sc_y, %sc_y : f32
      %sc_e = scalar.expf<afn> %sc_y2 : f32
      %sc_one = scalar.constant 1.0 : f32
      %sc_two = scalar.constant 2.0 : f32
      %sc_d = scalar.addf %sc_e, %sc_one : f32
      %sc_q = scalar.divf %sc_two, %sc_d : f32
      %sc_t = scalar.subf %sc_one, %sc_q : f32
      %sc_cap = scalar.constant 30.0 : f32
      %sc_v = scalar.mulf %sc_t, %sc_cap : f32
      %in_vocab = index.cmp ult, %column, %vocab : index
      %value = scf.select %in_vocab, %sc_v, %x : f32
      %region = index.constant 32768 : offset
      %out_view = buffer.view %outputs[%region] : buffer -> view<[%spans]x200064xf32>
      view.store %value, %out_view[%span, %column] : f32, view<[%spans]x200064xf32>
    }
  }
  kernel.return
}


// Router: wave w scores experts w*16..; then thread e holds expert e and 8 rounds of
// workgroup reductions pick the top 8 (ties: lowest index) of sigmoid(logit) + bias.
kernel.def export("g_moe_route") @g_moe_route(%tokens: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %x: buffer, %w: buffer, %b: buffer, %ids: buffer, %wts: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %token_id = kernel.workgroup.id<x> : index
  %token = index.assume %token_id [lt(%token_id, %tokens)] : index
  %wave_id = kernel.subgroup.id : index
  %wave = index.assume %wave_id [range(%wave_id, 0, 7)] : index
  %lane_id = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 31)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %cHG = index.constant 72 : index
  %cE = index.constant 128 : index
  %zero_f = scalar.constant 0.0 : f32
  %x_view = buffer.view %x[%zero] : buffer -> view<[%tokens]x72x32xf32>
  %w_view = buffer.view %w[%zero] : buffer -> view<128x72x32xf32>
  %lg_bytes = index.constant 512 : offset
  %lg = buffer.alloca<workgroup> align(16) %lg_bytes : buffer
  %lg_view = buffer.view %lg[%zero] : buffer -> view<128xf32>
  %first = index.cmp eq, %lane, %c0 : index
  %cEPW = index.constant 16 : index
  %e0 = index.mul %wave, %cEPW : index
  %cU = index.constant 4 : index
  scf.for %j = [%c0 to %cEPW step %cU] {
    %e_raw = index.add %e0, %j : index
    %ex0_raw = index.add %e_raw, %c0 : index
    %ex0 = index.assume %ex0_raw [range(%ex0_raw, 0, 127)] : index
    %ex1_raw = index.add %e_raw, %c1 : index
    %ex1 = index.assume %ex1_raw [range(%ex1_raw, 0, 127)] : index
    %ex2_raw = index.add %e_raw, %c2 : index
    %ex2 = index.assume %ex2_raw [range(%ex2_raw, 0, 127)] : index
    %ex3_raw = index.add %e_raw, %c3 : index
    %ex3 = index.assume %ex3_raw [range(%ex3_raw, 0, 127)] : index
    %part0, %part1, %part2, %part3 = scf.for %g = [%lane to %cHG step %c32](%acc0 = %zero_f : f32, %acc1 = %zero_f : f32, %acc2 = %zero_f : f32, %acc3 = %zero_f : f32) -> (f32, f32, f32, f32) {
      %bg = index.assume %g [range(%g, 0, 71)] : index
      %xv = vector.load %x_view[%token, %bg, %c0] : view<[%tokens]x72x32xf32> -> vector<32xf32>
      %wv0 = vector.load %w_view[%ex0, %bg, %c0] : view<128x72x32xf32> -> vector<32xf32>
      %wv1 = vector.load %w_view[%ex1, %bg, %c0] : view<128x72x32xf32> -> vector<32xf32>
      %wv2 = vector.load %w_view[%ex2, %bg, %c0] : view<128x72x32xf32> -> vector<32xf32>
      %wv3 = vector.load %w_view[%ex3, %bg, %c0] : view<128x72x32xf32> -> vector<32xf32>
      %d0 = vector.dotf<reassoc|contract> %wv0, %xv, %zero_f : vector<32xf32>, vector<32xf32>, f32
      %nx0 = scalar.addf %acc0, %d0 : f32
      %d1 = vector.dotf<reassoc|contract> %wv1, %xv, %zero_f : vector<32xf32>, vector<32xf32>, f32
      %nx1 = scalar.addf %acc1, %d1 : f32
      %d2 = vector.dotf<reassoc|contract> %wv2, %xv, %zero_f : vector<32xf32>, vector<32xf32>, f32
      %nx2 = scalar.addf %acc2, %d2 : f32
      %d3 = vector.dotf<reassoc|contract> %wv3, %xv, %zero_f : vector<32xf32>, vector<32xf32>, f32
      %nx3 = scalar.addf %acc3, %d3 : f32
      scf.yield %nx0, %nx1, %nx2, %nx3 : f32, f32, f32, f32
    }
    %logit0 = kernel.subgroup.reduce<addf> %part0 : f32
    %logit1 = kernel.subgroup.reduce<addf> %part1 : f32
    %logit2 = kernel.subgroup.reduce<addf> %part2 : f32
    %logit3 = kernel.subgroup.reduce<addf> %part3 : f32
    scf.if %first {
      view.store %logit0, %lg_view[%ex0] : f32, view<128xf32>
      view.store %logit1, %lg_view[%ex1] : f32, view<128xf32>
      view.store %logit2, %lg_view[%ex2] : f32, view<128xf32>
      view.store %logit3, %lg_view[%ex3] : f32, view<128xf32>
    }
  }

  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %t0 = kernel.workitem.id<x> : index
  %tb = index.assume %t0 [range(%t0, 0, 255)] : index
  %in_range = index.cmp ult, %tb, %cE : index
  %removed = scalar.constant -3.0e38 : f32
  %prob, %score0 = scf.if %in_range -> (f32, f32) {
    %be = index.assume %tb [range(%tb, 0, 127)] : index
    %lgt = view.load %lg_view[%be] : view<128xf32> -> f32
    %prob_v = scalar.logisticf<afn> %lgt : f32
    %b_view = buffer.view %b[%zero] : buffer -> view<128xf32>
    %bias_v = view.load %b_view[%be] : view<128xf32> -> f32
    %score_v = scalar.addf %prob_v, %bias_v : f32
    scf.yield %prob_v, %score_v : f32, f32
  } else {
    scf.yield %zero_f, %removed : f32, f32
  }
  %ids_view = buffer.view %ids[%zero] : buffer -> view<[%tokens]x8xi32>
  %wts_view = buffer.view %wts[%zero] : buffer -> view<[%tokens]x8xf32>
  %t32 = index.cast %tb : index to i32
  %big_id = scalar.constant 1000000 : i32
  %cKU = index.constant 8 : index
  %minus1 = scalar.constant -1 : i32
  %rest, %total, %my_w, %my_k = scf.for %round = [%c0 to %cKU step %c1](%sc = %score0 : f32, %sum = %zero_f : f32, %mw = %zero_f : f32, %mk = %minus1 : i32) -> (f32, f32, f32, i32) {
    %best = kernel.workgroup.reduce<maxnumf> %sc : f32
    %is_best = scalar.cmpf oeq, %sc, %best : f32
    %cand = scf.select %is_best, %t32, %big_id : i32
    %winner = kernel.workgroup.reduce<minsi> %cand : i32
    %won = scalar.cmpi eq, %winner, %t32 : i32
    %br = index.assume %round [range(%round, 0, 7)] : index
    scf.if %won {
      view.store %t32, %ids_view[%token, %br] : i32, view<[%tokens]x8xi32>
    }
    %mine = scf.select %won, %prob, %zero_f : f32
    %wp = kernel.workgroup.reduce<addf> %mine : f32
    %round32 = index.cast %br : index to i32
    %next_mw = scf.select %won, %prob, %mw : f32
    %next_mk = scf.select %won, %round32, %mk : i32
    %next_sc = scf.select %won, %removed, %sc : f32
    %next_sum = scalar.addf %sum, %wp : f32
    scf.yield %next_sc, %next_sum, %next_mw, %next_mk : f32, f32, f32, i32
  }
  %min_sum = scalar.constant 1e-20 : f32
  %wsum = scalar.addf %total, %min_sum : f32
  // The winner thread of each round keeps its prob in registers and writes the normalized weight
  // itself: reading back other threads' global stores raced through the per-WGP cache when
  // neighboring tokens' workgroups share a cache line (prefill outputs varied run to run).
  %c0_i32r = scalar.constant 0 : i32
  %writer = scalar.cmpi sge, %my_k, %c0_i32r : i32
  scf.if %writer {
    %kb = scalar.assume %my_k [range(%my_k, 0, 7)] : i32
    %bk = index.cast %kb : i32 to index
    %wn = scalar.divf %my_w, %wsum : f32
    %wn_k = scalar.constant 8.0 : f32
    %wns = scalar.mulf %wn, %wn_k : f32
    view.store %wns, %wts_view[%token, %bk] : f32, view<[%tokens]x8xf32>
  }
  kernel.return
}

// Router: TR=4 tokens per workgroup, their h rows staged in LDS; wave w scores experts w*16.. for
// all 4 tokens (one weight load serves 4 tokens); then per token, thread e holds expert e and 8
// rounds of workgroup reductions pick the top 8 (ties: lowest index) of sigmoid(logit) + bias.
kernel.def export("g_moe_route_tr") @g_moe_route_tr(%tokens: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  %cTRm1 = index.constant 3 : index
  %cTR = index.constant 4 : index
  %padded = index.add %tokens, %cTRm1 : index
  %groups = index.div %padded, %cTR : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %x: buffer, %w: buffer, %b: buffer, %ids: buffer, %wts: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %group_id = kernel.workgroup.id<x> : index
  %wave_id = kernel.subgroup.id : index
  %wave = index.assume %wave_id [range(%wave_id, 0, 7)] : index
  %lane_id = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 31)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  %c256 = index.constant 256 : index
  %cHG = index.constant 72 : index
  %cE = index.constant 128 : index
  %cTR = index.constant 4 : index
  %zero_f = scalar.constant 0.0 : f32
  %token0 = index.mul %group_id, %cTR : index
  %x_view = buffer.view %x[%zero] : buffer -> view<[%tokens]x72x32xf32>
  %xs_bytes = index.constant 36864 : offset
  %xs = buffer.alloca<workgroup> align(16) %xs_bytes : buffer
  %xs_view = buffer.view %xs[%zero] : buffer -> view<4x72x32xf32>
  %xs4_view = buffer.view %xs[%zero] : buffer -> view<4x18x32x4xf32>
  %w4_view = buffer.view %w[%zero] : buffer -> view<128x18x32x4xf32>
  %cHB = index.constant 18 : index
  %lg_bytes = index.constant 2048 : offset
  %lg = buffer.alloca<workgroup> align(16) %lg_bytes : buffer
  %lg_view = buffer.view %lg[%zero] : buffer -> view<4x128xf32>
  %tid0 = kernel.workitem.id<x> : index
  %tid = index.assume %tid0 [range(%tid0, 0, 255)] : index
  %cvec = index.constant 288 : index
  %zero32 = vector.splatf 0.0 : vector<32xf32>
  scf.for %v = [%tid to %cvec step %c256] {
    %r_value = index.div %v, %cHG : index
    %r = index.assume %r_value [range(%r_value, 0, 3)] : index
    %g_value = index.rem %v, %cHG : index
    %g = index.assume %g_value [range(%g_value, 0, 71)] : index
    %tok_value = index.add %token0, %r : index
    %tok_in = index.cmp ult, %tok_value, %tokens : index
