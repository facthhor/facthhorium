  %bv = buffer.view %bias[%zero] : buffer -> view<128xf32>
  %sv = buffer.view %dn_scale[%zero] : buffer -> view<128xf32>
  %iv = buffer.view %ids[%zero] : buffer -> view<[%tokens]x8xi32>
  %wv = buffer.view %wts[%zero] : buffer -> view<[%tokens]x8xf32>
