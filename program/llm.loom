  %block_bytes = index.constant 34 : offset
  %row_origin = index.scale %id, %row_bytes : index, offset -> offset
  %active = index.cmp ult, %lane, %groups : index
  %zero32 = vector.splatf 0.0 : vector<32xf32>
  %values = scf.if %active -> (vector<32xf32>) {
    %v = scf.if %is_feature -> (vector<32xf32>) {
      %bounded_feature = scalar.assume %feature [range(%feature, 1, 2147483647)] : i32
      %feature_at = index.cast %bounded_feature : i32 to offset
      %features = buffer.view %ids[%feature_at] : buffer -> view<72x32xf32>
      %bl = index.assume %lane [range(%lane, 0, 71)] : index
      %image = vector.load %features[%bl, %c0] : view<72x32xf32> -> vector<32xf32>
      scf.yield %image : vector<32xf32>
    } else {
      %block = index.div %lane, %c8 : index
      %within = index.rem %lane, %c8 : index
      %block_add = index.scale %block, %block_bytes : index, offset -> offset
      %origin = index.add %row_origin, %block_add : offset
      %token_vec = func.call @g_q8_0_values(%table, %origin, %within) : (buffer, offset, index) -> (vector<32xf32>)
      scf.yield %token_vec : vector<32xf32>
    }
    scf.yield %v : vector<32xf32>
  } else {
    scf.yield %zero32 : vector<32xf32>
  }
  %normalized = vector.addf %values, %zero32 : vector<32xf32>
  %count = scalar.constant 2304.0 : f32
  %eps = scalar.constant 9.999999974752427e-07 : f32
  %squares2 = vector.mulf %normalized, %normalized : vector<32xf32>
  %local2 = vector.reduce<addf> %squares2, %zero_f : vector<32xf32>, f32
  %sum2 = kernel.workgroup.reduce<addf> %local2 : f32
  %mean2 = scalar.divf %sum2, %count : f32
  %stable2 = scalar.addf %mean2, %eps : f32
  %inverse2 = scalar.rsqrtf %stable2 : f32
  %inverses2 = vector.splat %inverse2 : vector<32xf32>
  scf.if %active {
    %bl = index.assume %lane [range(%lane, 0, 71)] : index
    %x_view = buffer.view %x[%zero] : buffer -> view<[%tokens]x72x32xf32>
    %h_view = buffer.view %h[%zero] : buffer -> view<[%tokens]x72x32xf32>
    %w_view = buffer.view %w[%zero] : buffer -> view<72x32xf32>
    vector.store %normalized, %x_view[%token, %bl, %c0] : vector<32xf32>, view<[%tokens]x72x32xf32>
    %weights = vector.load %w_view[%bl, %c0] : view<72x32xf32> -> vector<32xf32>
    %n2 = vector.mulf %normalized, %inverses2 : vector<32xf32>
    %hv = vector.mulf %n2, %weights : vector<32xf32>
    %result = scf.if %is_feature -> (vector<32xf32>) {
      scf.yield %normalized : vector<32xf32>
    } else {
      scf.yield %hv : vector<32xf32>
    }
    vector.store %result, %h_view[%token, %bl, %c0] : vector<32xf32>, view<[%tokens]x72x32xf32>
  }
  kernel.return
}

// x[t] += y[t]; h[t] = rmsnorm(x[t]) * w_next.
kernel.def export("g_sampling_tile_mass") @g_sampling_tile_mass(%spans: index) {
  %tiles = index.constant 32 : index
  %lanes = index.constant 256 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%spans, %tiles, %c1) workgroup_size(%lanes, %c1, %c1) : index
} launch(%spans_arg: index, %metadata: buffer, %logits: buffer, %tile_mass: buffer) {
  %spans = index.assume %spans_arg [range(%spans_arg, 1, 8192)] : index
  %span_id = kernel.workgroup.id<x> : index
  %span = index.assume %span_id [lt(%span_id, %spans)] : index
  %tile_id = kernel.workgroup.id<y> : index
  %tile = index.assume %tile_id [range(%tile_id, 0, 31)] : index
  %lane_id = kernel.workitem.id<x> : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 255)] : index
  %zero = index.constant 0 : offset
  %c16 = index.constant 16 : offset
  %c256 = index.constant 256 : index
  %width = index.constant 6400 : index
  %vocab = index.constant 200058 : index
  %c0_i32 = scalar.constant 0 : i32
  %one32 = scalar.constant 1 : i32
  %header = buffer.view %metadata[%zero] : buffer -> view<4xi32>
  %count = view.load %header[0] : view<4xi32> -> i32
  %span32 = index.cast %span : index to i32
  %live = scalar.cmpi ult, %span32, %count : i32
  scf.if %live {
    %packets = buffer.view %metadata[%c16] : buffer -> view<[%spans]x9xi32>
    %flags = view.load %packets[%span, 6] : view<[%spans]x9xi32> -> i32
    %selected = scalar.andi %flags, %one32 : i32
    %temperature_bits = view.load %packets[%span, 2] : view<[%spans]x9xi32> -> i32
    %temperature = scalar.bitcast %temperature_bits : i32 to f32
        %top_p_bits = view.load %packets[%span, 5] : view<[%spans]x9xi32> -> i32
        %top_p_raw = scalar.bitcast %top_p_bits : i32 to f32
        %top_k_raw = view.load %packets[%span, 7] : view<[%spans]x9xi32> -> i32
        %one = scalar.constant 1.0 : f32
        %k_mask = scalar.constant 1073741823 : i32
        %request_k = scalar.andi %top_k_raw, %k_mask : i32
        %no_filter = scalar.cmpi eq, %request_k, %c0_i32 : i32
        %all_p = scalar.cmpf oeq, %top_p_raw, %one : f32
        %unit_t = scalar.cmpf oeq, %temperature, %one : f32
        %all_kp = scalar.andi %no_filter, %all_p : i1
        %full = scalar.andi %all_kp, %unit_t : i1
    %enabled = scalar.cmpi ne, %selected, %c0_i32 : i32
    %run = scalar.andi %enabled, %full : i1
    scf.if %run {
      %all_logits = buffer.view %logits[%zero] : buffer -> view<[%spans]x200064xf32>
      %out = buffer.view %tile_mass[%zero] : buffer -> view<[%spans]x32x256xf64>
      %zero_d = scalar.constant 0.0 : f64
      %two_over_cap = scalar.constant 0.06666666666666667 : f32
      %cap = scalar.constant 30.0 : f32
      %two = scalar.constant 2.0 : f32
      %base = index.mul %tile, %width : index
      %begin = index.add %base, %lane : index
      %next_tile = index.add %base, %width : index
      %end = index.min %vocab, %next_tile : index
      %mass = scf.for %v = [%begin to %end step %c256](%acc = %zero_d : f64) -> (f64) {
        %idx = index.assume %v [range(%v, 0, 200057)] : index
            %raw = view.load %all_logits[%span, %idx] : view<[%spans]x200064xf32> -> f32
            %scaled = scalar.mulf %raw, %two_over_cap : f32
            %e = scalar.expf<afn> %scaled : f32
            %den = scalar.addf %one, %e : f32
            %frac = scalar.divf %two, %den : f32
            %tanh = scalar.subf %one, %frac : f32
            %capped = scalar.mulf %cap, %tanh : f32
            %w = scalar.expf<afn> %capped : f32
            %weight64 = scalar.extf %w : f32 to f64
        %next = scalar.addf %acc, %weight64 : f64
        scf.yield %next : f64
      }
      view.store %mass, %out[%span, %tile, %lane] : f64, view<[%spans]x32x256xf64>
    }
  }
  kernel.return
}

