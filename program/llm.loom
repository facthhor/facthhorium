} launch(%tokens_arg: index, %layer_arg: index, %context_arg: index, %pool_arg: index, %q: buffer, %info: buffer, %tiles: buffer, %origins: buffer, %arena: buffer, %out: buffer, %far_m: buffer, %far_l: buffer, %far_end: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 16, 8192), multiple_of(%tokens_arg, 16)] : index
  %layer = index.assume %layer_arg [range(%layer_arg, 0, 47)] : index
  %context = index.assume %context_arg [range(%context_arg, 16, 1048576)] : index
  %pool = index.assume %pool_arg [range(%pool_arg, 16, 2147483584)] : index
