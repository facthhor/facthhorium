    %l_d4 = index.div %lane, %c4 : index
    %key_k_v = index.madd %wk, %c4, %l_m4 : index
    %key_k = index.assume %key_k_v [range(%key_k_v, 0, 31)] : index
    %k_in_pg = index.rem %key_k, %c16 : index
    %k_use_p1 = index.cmp uge, %wk, %c4 : index
    %k_d0_v = index.mul %l_d4, %c8 : index
    %k_d0 = index.assume %k_d0_v [range(%k_d0_v, 0, 56)] : index
    %c64 = index.constant 64 : index
    %c256_o = index.constant 256 : offset
    %c16_o = index.constant 16 : offset
    %c128_o = index.constant 128 : offset
