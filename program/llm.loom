    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    // Pass 2: coalesced vec4 sweep of L2/MALL-hot %tmp_out -> %out16 (norm_w loaded ONCE!)
    %j0 = index.assume %tid [range(%tid, 0, 575)] : index
    %j1_v = index.add %tid, %c128 : index
    %j1 = index.assume %j1_v [range(%j1_v, 0, 575)] : index
    %j2_v = index.add %tid, %c256 : index
    %j2 = index.assume %j2_v [range(%j2_v, 0, 575)] : index
    %j3_v = index.add %tid, %c384 : index
    %j3 = index.assume %j3_v [range(%j3_v, 0, 575)] : index
    %j4_v = index.add %tid, %c512 : index
    %has_j4 = index.cmp ult, %j4_v, %cH4 : index
    %zero4 = vector.splatf 0.0 : vector<4xf32>
    %w4_0 = vector.load %nwv4[%j0, %c0] : view<576x4xf32> -> vector<4xf32>
    %w4_1 = vector.load %nwv4[%j1, %c0] : view<576x4xf32> -> vector<4xf32>
    %w4_2 = vector.load %nwv4[%j2, %c0] : view<576x4xf32> -> vector<4xf32>
    %w4_3 = vector.load %nwv4[%j3, %c0] : view<576x4xf32> -> vector<4xf32>
    %w4_4 = scf.if %has_j4 -> (vector<4xf32>) {
      %j4w = index.assume %j4_v [range(%j4_v, 0, 575)] : index
      %vw4 = vector.load %nwv4[%j4w, %c0] : view<576x4xf32> -> vector<4xf32>
      scf.yield %vw4 : vector<4xf32>
    } else {
      scf.yield %zero4 : vector<4xf32>
