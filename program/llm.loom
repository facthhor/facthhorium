  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %cWIN = index.constant 1024 : index
  %cRING = index.constant 1040 : index
  %c0_i32 = scalar.constant 0 : i32
  %active, %length, %start32, %row, %first = func.call @g_gdn_span(%metadata, %spans, %span) : (buffer, index, index) -> (i1, index, i32, index, index)
  scf.if %active {
    %rec_stride = index.constant 40 : offset
    %brow = index.assume %row [range(%row, 0, 2147483646)] : index
    %rec_off = index.scale %brow, %rec_stride : index, offset -> offset
