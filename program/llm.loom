      %hw_1 = vector.load %jw_v[%orow, %c2_1_col, %c0] : view<768x640x8xbf16> -> vector<8xbf16>
      %hx_2 = vector.load %hb_v[%tok, %c3_2, %c0] : view<[%tokens]x288x8xf32> -> vector<8xf32>
      %hw_2 = vector.load %jw_v[%orow, %c2_2_col, %c0] : view<768x640x8xbf16> -> vector<8xbf16>
      %hwf_0 = vector.extf %hw_0 : vector<8xbf16> to vector<8xf32>
      %ha_0 = vector.dotf<reassoc|contract> %hx_0, %hwf_0, %zf : vector<8xf32>, vector<8xf32>, f32
      %hwf_1 = vector.extf %hw_1 : vector<8xbf16> to vector<8xf32>
      %ha_1 = vector.dotf<reassoc|contract> %hx_1, %hwf_1, %ha_0 : vector<8xf32>, vector<8xf32>, f32
      %hwf_2 = vector.extf %hw_2 : vector<8xbf16> to vector<8xf32>
      %ha_2 = vector.dotf<reassoc|contract> %hx_2, %hwf_2, %ha_1 : vector<8xf32>, vector<8xf32>, f32
      %hx_3 = vector.load %hb_v[%tok, %c3_3, %c0] : view<[%tokens]x288x8xf32> -> vector<8xf32>
      %hw_3 = vector.load %jw_v[%orow, %c2_3_col, %c0] : view<768x640x8xbf16> -> vector<8xbf16>
      %hx_4 = vector.load %hb_v[%tok, %c3_4, %c0] : view<[%tokens]x288x8xf32> -> vector<8xf32>
      %hw_4 = vector.load %jw_v[%orow, %c2_4_col, %c0] : view<768x640x8xbf16> -> vector<8xbf16>
      %hx_5 = vector.load %hb_v[%tok, %c3_5, %c0] : view<[%tokens]x288x8xf32> -> vector<8xf32>
      %hw_5 = vector.load %jw_v[%orow, %c2_5_col, %c0] : view<768x640x8xbf16> -> vector<8xbf16>
      %hwf_3 = vector.extf %hw_3 : vector<8xbf16> to vector<8xf32>
      %ha_3 = vector.dotf<reassoc|contract> %hx_3, %hwf_3, %ha_2 : vector<8xf32>, vector<8xf32>, f32
      %hwf_4 = vector.extf %hw_4 : vector<8xbf16> to vector<8xf32>
      %ha_4 = vector.dotf<reassoc|contract> %hx_4, %hwf_4, %ha_3 : vector<8xf32>, vector<8xf32>, f32
      %hwf_5 = vector.extf %hw_5 : vector<8xbf16> to vector<8xf32>
      %ha_5 = vector.dotf<reassoc|contract> %hx_5, %hwf_5, %ha_4 : vector<8xf32>, vector<8xf32>, f32
      %hx_6 = vector.load %hb_v[%tok, %c3_6, %c0] : view<[%tokens]x288x8xf32> -> vector<8xf32>
      %hw_6 = vector.load %jw_v[%orow, %c2_6_col, %c0] : view<768x640x8xbf16> -> vector<8xbf16>
      %hx_7 = vector.load %hb_v[%tok, %c3_7, %c0] : view<[%tokens]x288x8xf32> -> vector<8xf32>
      %hw_7 = vector.load %jw_v[%orow, %c2_7_col, %c0] : view<768x640x8xbf16> -> vector<8xbf16>
      %hx_8 = vector.load %hb_v[%tok, %c3_8, %c0] : view<[%tokens]x288x8xf32> -> vector<8xf32>
      %hw_8 = vector.load %jw_v[%orow, %c2_8_col, %c0] : view<768x640x8xbf16> -> vector<8xbf16>
      %hwf_6 = vector.extf %hw_6 : vector<8xbf16> to vector<8xf32>
      %ha_6 = vector.dotf<reassoc|contract> %hx_6, %hwf_6, %ha_5 : vector<8xf32>, vector<8xf32>, f32
      %hwf_7 = vector.extf %hw_7 : vector<8xbf16> to vector<8xf32>
      %ha_7 = vector.dotf<reassoc|contract> %hx_7, %hwf_7, %ha_6 : vector<8xf32>, vector<8xf32>, f32
      %hwf_8 = vector.extf %hw_8 : vector<8xbf16> to vector<8xf32>
      %ha_8 = vector.dotf<reassoc|contract> %hx_8, %hwf_8, %ha_7 : vector<8xf32>, vector<8xf32>, f32
      %h_sum = kernel.subgroup.reduce<addf> %ha_8 : f32
      scf.if %l0 {
        %sm1_v = index.sub %s, %c1 : index
        %sm1 = index.assume %sm1_v [range(%sm1_v, 0, 6)] : index
        %res = scalar.addf %base, %h_sum : f32
        view.store %res, %sov[%blk, %sm1, %orow] : f32, view<[%blocks]x7x768xf32>
      }
    }
  }
  kernel.return
}

// 17b. g_dsp_markov_dyn: vectorized BF16 dot over dynamic cols [0..511] (skips state on step==1!) + static_out
kernel.def export("g_dsp_markov_dyn") @g_dsp_markov_dyn(%blocks: index) {
  %cWG = index.constant 192 : index
  %c128 = index.constant 128 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%blocks, %cWG, %c1) workgroup_size(%c128, %c1, %c1) : index
} launch(%blocks_arg: index, %step_arg: index, %metadata: buffer, %prev_tok: buffer, %rnn_state: buffer, %markov_w1: buffer, %joint_w: buffer, %static_out: buffer, %joint_out: buffer) {
  %blocks = index.assume %blocks_arg [range(%blocks_arg, 1, 1024)] : index
  %step = index.assume %step_arg [range(%step_arg, 1, 7)] : index
  %blk_id = kernel.workgroup.id<x> : index
  %blk = index.assume %blk_id [lt(%blk_id, %blocks)] : index
  %wg_y = kernel.workgroup.id<y> : index
  %wave = kernel.subgroup.id : index
  %lane_raw = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_raw [range(%lane_raw, 0, 31)] : index
  %c4 = index.constant 4 : index
  %orow_a = index.mul %wg_y, %c4 : index
  %orow_b = index.add %orow_a, %wave : index
  %orow = index.assume %orow_b [range(%orow_b, 0, 767)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %cR8 = index.constant 32 : index
  %zf = scalar.constant 0.0 : f32
  %hdr = buffer.view %metadata[%zero] : buffer -> view<4xi32>
  %cnt32 = view.load %hdr[0] : view<4xi32> -> i32
  %cnt_b = scalar.assume %cnt32 [range(%cnt32, 0, 1024)] : i32
  %cnt = index.cast %cnt_b : i32 to index
  %live = index.cmp ult, %blk, %cnt : index
  scf.if %live {
    %pv = buffer.view %prev_tok[%zero] : buffer -> view<[%blocks]xi32>
    %pid_r = view.load %pv[%blk] : view<[%blocks]xi32> -> i32
    %c0_i32 = scalar.constant 0 : i32
    %vmax = scalar.constant 201023 : i32
    %plo = scalar.maxsi %pid_r, %c0_i32 : i32
    %pcl = scalar.minsi %plo, %vmax : i32
    %pbd = scalar.assume %pcl [range(%pcl, 0, 201023)] : i32
    %pid = index.cast %pbd : i32 to index
    %mw_v = buffer.view %markov_w1[%zero] : buffer -> view<201024x32x8xbf16>
    %jw_v = buffer.view %joint_w[%zero] : buffer -> view<768x640x8xbf16>
    // Seg 1: markov_w1[prev_tok] (32 lanes x 8 bf16 = 256 EXACT!)
    %eb = vector.load %mw_v[%pid, %lane, %c0] : view<201024x32x8xbf16> -> vector<8xbf16>
    %ef = vector.extf %eb : vector<8xbf16> to vector<8xf32>
    %col1_v = index.add %lane, %cR8 : index
    %col1 = index.assume %col1_v [range(%col1_v, 32, 63)] : index
    %wb1 = vector.load %jw_v[%orow, %col1, %c0] : view<768x640x8xbf16> -> vector<8xbf16>
    %wf1 = vector.extf %wb1 : vector<8xbf16> to vector<8xf32>
    %d1 = vector.dotf<reassoc|contract> %ef, %wf1, %zf : vector<8xf32>, vector<8xf32>, f32
    // Seg 0: rnn_state (skip on step==1 since initial state is 0!)
    %has_st = index.cmp ugt, %step, %c1 : index
    %d_tot = scf.if %has_st -> (f32) {
      %st_v = buffer.view %rnn_state[%zero] : buffer -> view<[%blocks]x32x8xf32>
      %sv = vector.load %st_v[%blk, %lane, %c0] : view<[%blocks]x32x8xf32> -> vector<8xf32>
      %wb0 = vector.load %jw_v[%orow, %lane, %c0] : view<768x640x8xbf16> -> vector<8xbf16>
      %wf0 = vector.extf %wb0 : vector<8xbf16> to vector<8xf32>
      %d01 = vector.dotf<reassoc|contract> %sv, %wf0, %d1 : vector<8xf32>, vector<8xf32>, f32
      scf.yield %d01 : f32
    } else {
      scf.yield %d1 : f32
    }
    %sum = kernel.subgroup.reduce<addf> %d_tot : f32
    %l0 = index.cmp eq, %lane, %c0 : index
    scf.if %l0 {
      %sm1_v = index.sub %step, %c1 : index
      %sm1 = index.assume %sm1_v [range(%sm1_v, 0, 6)] : index
      %sov = buffer.view %static_out[%zero] : buffer -> view<[%blocks]x7x768xf32>
      %base = view.load %sov[%blk, %sm1, %orow] : view<[%blocks]x7x768xf32> -> f32
      %res = scalar.addf %base, %sum : f32
      %jov = buffer.view %joint_out[%zero] : buffer -> view<[%blocks]x768xf32>
      view.store %res, %jov[%blk, %orow] : f32, view<[%blocks]x768xf32>
    }
  }
  kernel.return
}

// 17c. g_dsp_markov_out_q8: 1-dispatch zero-LDS fused state_update (ping-pong!) + BF16 hidden_out + h_blk + Q8 quantize!
// Grid: (%blocks, HG=72, 1), WG size 32 (1 wave per Q8 group g, rows 32g..32g+31).
kernel.def export("g_dsp_markov_out_q8") @g_dsp_markov_out_q8(%blocks: index) {
  %cHG = index.constant 72 : index
  %c32 = index.constant 32 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%blocks, %cHG, %c1) workgroup_size(%c32, %c1, %c1) : index
} launch(%blocks_arg: index, %tokens_arg: index, %step_arg: index, %joint_out: buffer, %rnn_in: buffer, %rnn_out: buffer, %h_blk: buffer, %ho_w: buffer, %ho_b: buffer, %h_eff_q: buffer) {
  %blocks = index.assume %blocks_arg [range(%blocks_arg, 1, 1024)] : index
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %step = index.assume %step_arg [range(%step_arg, 1, 7)] : index
  %blk_id = kernel.workgroup.id<x> : index
  %blk = index.assume %blk_id [lt(%blk_id, %blocks)] : index
  %grp_id = kernel.workgroup.id<y> : index
  %grp = index.assume %grp_id [range(%grp_id, 0, 71)] : index
  %lane_raw = kernel.workitem.id<x> : index
  %lane = index.assume %lane_raw [range(%lane_raw, 0, 31)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %zf = scalar.constant 0.0 : f32
  %one8 = vector.splatf 1.0 : vector<8xf32>
  %zero8 = vector.splatf 0.0 : vector<8xf32>
  // Step A: each lane l owns 8 elements [8l..8l+7] of RANK=256 state + latent
  %jov = buffer.view %joint_out[%zero] : buffer -> view<[%blocks]x96x8xf32>
  %i1_v = index.add %lane, %c32 : index
  %i1 = index.assume %i1_v [range(%i1_v, 32, 63)] : index
  %i2_v = index.add %lane, %c64 : index
  %i2 = index.assume %i2_v [range(%i2_v, 64, 95)] : index
  %u0 = vector.load %jov[%blk, %lane, %c0] : view<[%blocks]x96x8xf32> -> vector<8xf32>
  %u1 = vector.load %jov[%blk, %i1, %c0] : view<[%blocks]x96x8xf32> -> vector<8xf32>
  %u2 = vector.load %jov[%blk, %i2, %c0] : view<[%blocks]x96x8xf32> -> vector<8xf32>
  %nu0 = vector.negf %u0 : vector<8xf32>
  %eu0 = vector.expf<afn> %nu0 : vector<8xf32>
  %den = vector.addf %one8, %eu0 : vector<8xf32>
  %gate = vector.divf %one8, %den : vector<8xf32>
  %cand = vector.tanhf<afn> %u1 : vector<8xf32>
  %lat = vector.tanhf<afn> %u2 : vector<8xf32>
  %is_g0 = index.cmp eq, %grp, %c0 : index
  scf.if %is_g0 {
    %has_st = index.cmp ugt, %step, %c1 : index
    %st_old = scf.if %has_st -> (vector<8xf32>) {
      %siv = buffer.view %rnn_in[%zero] : buffer -> view<[%blocks]x32x8xf32>
      %so = vector.load %siv[%blk, %lane, %c0] : view<[%blocks]x32x8xf32> -> vector<8xf32>
      scf.yield %so : vector<8xf32>
    } else {
      scf.yield %zero8 : vector<8xf32>
    }
    %diff = vector.subf %st_old, %cand : vector<8xf32>
    %st_new = vector.fmaf %gate, %diff, %cand : vector<8xf32>
    %sov = buffer.view %rnn_out[%zero] : buffer -> view<[%blocks]x32x8xf32>
    vector.store %st_new, %sov[%blk, %lane, %c0] : vector<8xf32>, view<[%blocks]x32x8xf32>
  }
  // Step B: 32 rows d = 32*grp + r, each row is ONE coalesced 512B load (32 lanes x 8 bf16 = 256!)
  %d0 = index.mul %grp, %c32 : index
  %dl_v = index.add %d0, %lane : index
  %dl = index.assume %dl_v [range(%dl_v, 0, 2303)] : index
  %hbv = buffer.view %ho_b[%zero] : buffer -> view<2304xf32>
  %bi = view.load %hbv[%dl] : view<2304xf32> -> f32
  %tok0 = index.mul %blk, %c8 : index
  %tok_v = index.add %tok0, %step : index
  %tok = index.assume %tok_v [range(%tok_v, 0, 8191), lt(%tok_v, %tokens)] : index
  %curv = buffer.view %h_blk[%zero] : buffer -> view<[%tokens]x2304xf32>
  %base = view.load %curv[%tok, %dl] : view<[%tokens]x2304xf32> -> f32
  %bias_l = scalar.addf %base, %bi : f32
  %hwv = buffer.view %ho_w[%zero] : buffer -> view<2304x32x8xbf16>
  // Unroll 4 rows per batch so 4 coalesced 512B loads issue in flight together (cuts 32 serial stalls -> 8!)
  %c4_r = index.constant 4 : index
  %y_dot = scf.for %r0 = [%c0 to %c32 step %c4_r](%ya0 = %zf : f32) -> (f32) {
    %cr_0 = index.constant 0 : index
    %rr_0 = index.add %r0, %cr_0 : index
    %dr_0_v = index.add %d0, %rr_0 : index
    %dr_0 = index.assume %dr_0_v [range(%dr_0_v, 0, 2303)] : index
    %wb_0 = vector.load %hwv[%dr_0, %lane, %c0] : view<2304x32x8xbf16> -> vector<8xbf16>
    %cr_1 = index.constant 1 : index
    %rr_1 = index.add %r0, %cr_1 : index
    %dr_1_v = index.add %d0, %rr_1 : index
    %dr_1 = index.assume %dr_1_v [range(%dr_1_v, 0, 2303)] : index
    %wb_1 = vector.load %hwv[%dr_1, %lane, %c0] : view<2304x32x8xbf16> -> vector<8xbf16>
    %cr_2 = index.constant 2 : index
    %rr_2 = index.add %r0, %cr_2 : index
    %dr_2_v = index.add %d0, %rr_2 : index
    %dr_2 = index.assume %dr_2_v [range(%dr_2_v, 0, 2303)] : index
    %wb_2 = vector.load %hwv[%dr_2, %lane, %c0] : view<2304x32x8xbf16> -> vector<8xbf16>
    %cr_3 = index.constant 3 : index
    %rr_3 = index.add %r0, %cr_3 : index
    %dr_3_v = index.add %d0, %rr_3 : index
    %dr_3 = index.assume %dr_3_v [range(%dr_3_v, 0, 2303)] : index
    %wb_3 = vector.load %hwv[%dr_3, %lane, %c0] : view<2304x32x8xbf16> -> vector<8xbf16>
    %wf_0 = vector.extf %wb_0 : vector<8xbf16> to vector<8xf32>
    %ld_0 = vector.dotf<reassoc|contract> %wf_0, %lat, %zf : vector<8xf32>, vector<8xf32>, f32
    %rs_0 = kernel.subgroup.reduce<addf> %ld_0 : f32
    %mine_0 = index.cmp eq, %lane, %rr_0 : index
    %ya1 = scf.select %mine_0, %rs_0, %ya0 : f32
    %wf_1 = vector.extf %wb_1 : vector<8xbf16> to vector<8xf32>
    %ld_1 = vector.dotf<reassoc|contract> %wf_1, %lat, %zf : vector<8xf32>, vector<8xf32>, f32
    %rs_1 = kernel.subgroup.reduce<addf> %ld_1 : f32
    %mine_1 = index.cmp eq, %lane, %rr_1 : index
    %ya2 = scf.select %mine_1, %rs_1, %ya1 : f32
    %wf_2 = vector.extf %wb_2 : vector<8xbf16> to vector<8xf32>
    %ld_2 = vector.dotf<reassoc|contract> %wf_2, %lat, %zf : vector<8xf32>, vector<8xf32>, f32
    %rs_2 = kernel.subgroup.reduce<addf> %ld_2 : f32
    %mine_2 = index.cmp eq, %lane, %rr_2 : index
    %ya3 = scf.select %mine_2, %rs_2, %ya2 : f32
    %wf_3 = vector.extf %wb_3 : vector<8xbf16> to vector<8xf32>
    %ld_3 = vector.dotf<reassoc|contract> %wf_3, %lat, %zf : vector<8xf32>, vector<8xf32>, f32
    %rs_3 = kernel.subgroup.reduce<addf> %ld_3 : f32
    %mine_3 = index.cmp eq, %lane, %rr_3 : index
    %ya4 = scf.select %mine_3, %rs_3, %ya3 : f32
    scf.yield %ya4 : f32
  }
  %y_val = scalar.addf %y_dot, %bias_l : f32
  // Step C: in-wave Q8 quantize of the 32 values y_val across lanes 0..31 -> %h_eff_q
  %q_abs = scalar.absf %y_val : f32
  %q_amax = kernel.subgroup.reduce<maxnumf> %q_abs : f32
  %q_c127 = scalar.constant 127.0 : f32
  %q_d = scalar.divf %q_amax, %q_c127 : f32
  %q_nz = scalar.cmpf one, %q_amax, %zf : f32
  %q_sc = scalar.divf %y_val, %q_d : f32
  %q_rd = scalar.roundf %q_sc : f32
  %q_rs = scf.select %q_nz, %q_rd, %zf : f32
  %q_sum = kernel.subgroup.reduce<addf> %q_rs : f32
  %q_i8 = scalar.fptosi %q_rs : f32 to i8
  %q_ov = buffer.view %h_eff_q[%zero] : buffer -> view<[%blocks]x72x32xi8>
  view.store %q_i8, %q_ov[%blk, %grp, %lane] : i8, view<[%blocks]x72x32xi8>
  %is_l0 = index.cmp eq, %lane, %c0 : index
  scf.if %is_l0 {
    %q_mb = index.constant 2304 : offset
    %q_moff = index.scale %blocks, %q_mb : index, offset -> offset
    %q_mv = buffer.view %h_eff_q[%q_moff] : buffer -> view<[%blocks]x72x2xf32>
    %q_dh = scalar.fptrunc %q_d : f32 to f16
    %q_da = scalar.extf %q_dh : f16 to f32
    view.store %q_da, %q_mv[%blk, %grp, %c0] : f32, view<[%blocks]x72x2xf32>
    view.store %q_sum, %q_mv[%blk, %grp, %c1] : f32, view<[%blocks]x72x2xf32>
  }
  kernel.return
}

kernel.def export("g_dsp_head_mv_q8_p4s") @g_dsp_head_mv_q8_p4s(%spans: index) {
  %cCH = index.constant 512 : index
  %c128 = index.constant 128 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%spans, %cCH, %c1) workgroup_size(%c128, %c1, %c1) : index
} launch(%spans_arg: index, %metadata: buffer, %hq: buffer, %w: buffer, %partials: buffer) {
  %spans = index.assume %spans_arg [range(%spans_arg, 1, 1024)] : index
  %span_id = kernel.workgroup.id<x> : index
  %span = index.assume %span_id [lt(%span_id, %spans)] : index
  %chunk_id = kernel.workgroup.id<y> : index
  %chunk = index.assume %chunk_id [range(%chunk_id, 0, 511)] : index
  %wid_raw = kernel.workitem.id<x> : index
  %wid = index.assume %wid_raw [range(%wid_raw, 0, 127)] : index
  %wave_raw = kernel.subgroup.id : index
  %wave = index.assume %wave_raw [range(%wave_raw, 0, 3)] : index
  %lane_raw = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_raw [range(%lane_raw, 0, 31)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %cR = index.constant 128 : index
  %cs0 = index.constant 0 : index
  %cs1 = index.constant 8 : index
  %cs2 = index.constant 16 : index
  %cs3 = index.constant 24 : index
  %cs4 = index.constant 32 : index
  %cs5 = index.constant 40 : index
  %cs6 = index.constant 48 : index
  %cs7 = index.constant 56 : index
  %cs8 = index.constant 64 : index
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c4_i32 = scalar.constant 4 : i32
  %c32_i32 = scalar.constant 32 : i32
  %zi = scalar.constant 0 : i32
  %big = scalar.constant 2147483647 : i32
  %zf = scalar.constant 0.0 : f32
  %cm8 = scalar.constant -8.0 : f32
  %ninf = scalar.constant -3.0e38 : f32
  %z8i = vector.splati 0 : vector<8xi32>
  %nmask = vector.splati 15 : vector<16xi8>
  %cfour = vector.splati 4 : vector<16xi8>
  %hdr = buffer.view %metadata[%zero] : buffer -> view<4xi32>
  %cnt32 = view.load %hdr[0] : view<4xi32> -> i32
