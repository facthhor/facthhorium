    %b23 = scf.select %is_ap, %b_ap, %b_fp : index
    %sbase = scf.select %is_kv, %b01, %b23 : index
    %swidth = scf.select %is_kv, %cKD, %cH : index
    %s01 = scf.select %is_k, %c0, %cKD : index
    %s23 = scf.select %is_ap, %c2KD, %cAP : index
    %sstart = scf.select %is_kv, %s01, %s23 : index
