  %gus_s = view.load %gus_view[%expert] : view<128xf32> -> f32
  %gus_v = vector.splat %gus_s : vector<8xf32>
  %g0s = vector.mulf %g0, %gus_v : vector<8xf32>
  %g1s = vector.mulf %g1, %gus_v : vector<8xf32>
  %u0s = vector.mulf %u0, %gus_v : vector<8xf32>
