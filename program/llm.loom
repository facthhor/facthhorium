  kernel.launch.config workgroups(%t_tiles, %c1, %c1) workgroup_size(%c128, %c1, %c1) : index
} launch(%tokens_arg: index, %n_arg: index, %info: buffer, %x16: buffer, %scales: buffer, %w: buffer, %out: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %n = index.assume %n_arg [range(%n_arg, 1, 32)] : index
  %tt_id = kernel.workgroup.id<x> : index
  %tid_raw = kernel.workitem.id<x> : index
  %tid = index.assume %tid_raw [range(%tid_raw, 0, 127)] : index
  %sg_raw = kernel.subgroup.id : index
  %sg = index.assume %sg_raw [range(%sg_raw, 0, 3)] : index
  %lane_raw = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_raw [range(%lane_raw, 0, 31)] : index
