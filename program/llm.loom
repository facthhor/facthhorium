    vector.store %vh2, %vnew[1, %kh, %lane, %c0] : vector<4xf32>, view<3x8x32x4xf32>
    vector.store %vx3, %vnew[2, %kh, %lane, %c0] : vector<4xf32>, view<3x8x32x4xf32>
    %vsq = vector.dotf<reassoc|contract> %vconv, %vconv, %zero_f : vector<4xf32>, vector<4xf32>, f32
    %vtot = kernel.subgroup.reduce<addf> %vsq : f32
    %vm0 = scalar.mulf %vtot, %inv_D : f32
    %vm = scalar.addf %vm0, %eps : f32
    %vrs = scalar.rsqrtf<afn> %vm : f32
    %vrsv = vector.splat %vrs : vector<4xf32>
    %vout = vector.mulf %vconv, %vrsv : vector<4xf32>
    %v16 = vector.fptrunc %vout : vector<4xf32> to vector<4xf16>
