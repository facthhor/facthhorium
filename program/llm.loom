      %ls = view.load %pl_v[%tok, %hd, %sb] : view<[%tokens]x24x64xf32> -> f32
      %os = vector.load %po_v[%tok, %hd, %sb, %lane, %c0] : view<[%tokens]x24x64x32x4xf32> -> vector<4xf32>
