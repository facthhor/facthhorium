  %dtb0 = vector.dotf<reassoc|contract> %b0, %q0, %zero_f : vector<4xf32>, vector<4xf32>, f32
  %dtb1 = vector.dotf<reassoc|contract> %b1, %q1, %dtb0 : vector<4xf32>, vector<4xf32>, f32
