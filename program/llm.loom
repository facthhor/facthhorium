}


// 16-split indirect-dispatched fallback attention over %list / %count_buffer (runs < 9 tokens).
kernel.def export("g16_ink_attn_split_listed_swa") @g16_ink_attn_split_listed_swa(%count_buffer: buffer) {
  %origin_c = index.constant 0 : offset
  %counts = buffer.view %count_buffer[%origin_c] : buffer -> view<1xi32>
  %word = view.load %counts[0] : view<1xi32> -> i32
  %bounded = scalar.assume %word [range(%word, 0, 8192)] : i32
  %count = index.cast %bounded : i32 to index
  %c1 = index.constant 1 : index
  %ckvh = index.constant 8 : index
  %cS = index.constant 2 : index
  %clanes = index.constant 96 : index
  kernel.launch.config workgroups(%count, %ckvh, %cS) workgroup_size(%clanes, %c1, %c1) : index
} launch(%tokens_arg: index, %spans_arg: index, %list: buffer, %swa_off_arg: index, %metadata: buffer, %q: buffer, %r: buffer, %rel_bias: buffer, %info: buffer, %origins: buffer, %arena: buffer, %swa_cur: buffer, %part_acc: buffer, %part_ml: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %spans = index.assume %spans_arg [range(%spans_arg, 1, 8192)] : index
  %swa_off_b = index.assume %swa_off_arg [range(%swa_off_arg, 0, 1073741824)] : index
  %swa_off = index.cast %swa_off_b : index to offset
  %slot = kernel.workgroup.id<x> : index
  %zero = index.constant 0 : offset
  %list_view = buffer.view %list[%zero] : buffer -> view<[%tokens]xi32>
  %bounded_slot = index.assume %slot [lt(%slot, %tokens)] : index
  %token32 = view.load %list_view[%bounded_slot] : view<[%tokens]xi32> -> i32
  %token_bound = scalar.assume %token32 [range(%token32, 0, 8191)] : i32
  %token_value = index.cast %token_bound : i32 to index
  %token = index.assume %token_value [lt(%token_value, %tokens)] : index
  %kh_id = kernel.workgroup.id<y> : index
  %kh = index.assume %kh_id [range(%kh_id, 0, 7)] : index
  %sp_id = kernel.workgroup.id<z> : index
  %sp = index.assume %sp_id [range(%sp_id, 0, 1)] : index
  %wave_raw = kernel.subgroup.id : index
  %wave = index.assume %wave_raw [range(%wave_raw, 0, 2)] : index
  %lane_raw = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_raw [range(%lane_raw, 0, 31)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %cG = index.constant 3 : index
  %cS = index.constant 2 : index
  %cEXT = index.constant 1024 : index
  %cWIN = index.constant 1024 : index
  %cWIN1 = index.constant 1023 : index
  %c0_i32 = scalar.constant 0 : i32
  %zero_f = scalar.constant 0.0 : f32
  %neg_big = scalar.constant -3.0e38 : f32
  %zero4 = vector.splatf 0.0 : vector<4xf32>
  %scale = scalar.constant 0.08838834764831843 : f32
  %scale4 = vector.splat %scale : vector<4xf32>
  %hd_v = index.madd %kh, %cG, %wave : index
  %hd = index.assume %hd_v [range(%hd_v, 0, 23)] : index
  %info_v = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %live32 = view.load %info_v[%token, 2] : view<[%tokens]x4xi32> -> i32
  %live = scalar.cmpi ne, %live32, %c0_i32 : i32
  scf.if %live {
    %row32 = view.load %info_v[%token, 0] : view<[%tokens]x4xi32> -> i32
    %pos32 = view.load %info_v[%token, 1] : view<[%tokens]x4xi32> -> i32
    %row_b = scalar.assume %row32 [range(%row32, 0, 2147483646)] : i32
    %pos_b = scalar.assume %pos32 [range(%pos32, 0, 1048575)] : i32
    %row = index.cast %row_b : i32 to index
    %pos = index.cast %pos_b : i32 to index
    %is_swa = scalar.constant true : i1
    %far = index.cmp uge, %pos, %cWIN : index
    %use_win = scalar.andi %is_swa, %far : i1
    %win_start = index.sub %pos, %cWIN1 : index
    %w_low = scf.select %use_win, %win_start, %c0 : index
    %end = index.add %pos, %c1 : index
    %vis_val = index.sub %end, %w_low : index
    %vis = index.assume %vis_val [range(%vis_val, 1, 1048576)] : index
    %s_eff = index.min %vis, %cS : index
    %active_split = index.cmp ult, %sp, %s_eff : index
    scf.if %active_split {
      %s_less = index.sub %s_eff, %c1 : index
      %per_pad = index.add %vis, %s_less : index
      %per = index.div %per_pad, %s_eff : index
      %st0 = index.mul %sp, %per : index
      %st = index.min %st0, %vis : index
      %en0 = index.add %st, %per : index
      %en = index.min %en0, %vis : index
      %span32 = view.load %info_v[%token, 3] : view<[%tokens]x4xi32> -> i32
      %span_b = scalar.assume %span32 [range(%span32, 0, 8191)] : i32
      %span = index.cast %span_b : i32 to index
      %sp_act, %sp_len, %sp_start32, %sp_row, %sp_first = func.call @g_gdn_span(%metadata, %spans, %span) : (buffer, index, index) -> (i1, index, i32, index, index)
      %sp_start_b = scalar.assume %sp_start32 [range(%sp_start32, 0, 1048575)] : i32
      %sp_start = index.cast %sp_start_b : i32 to index
      %ring_rd, %ring_wr, %ring_fr = func.call @g_gdn_slots(%origins, %row, %sp_start32, %swa_off) : (buffer, index, i32, offset) -> (offset, offset, i1)
      %pos_bytes = index.constant 2048 : offset
      %ring_v_stride = index.constant 2129920 : offset
      %swa_cur_v = buffer.view %swa_cur[%zero] : buffer -> view<[%tokens]x2x8x32x4xf16>
      %qv = buffer.view %q[%zero] : buffer -> view<[%tokens]x24x32x4xf32>
      %q_raw = vector.load %qv[%token, %hd, %lane, %c0] : view<[%tokens]x24x32x4xf32> -> vector<4xf32>
      %q4 = vector.mulf %q_raw, %scale4 : vector<4xf32>
      %rv = buffer.view %r[%zero] : buffer -> view<[%tokens]x24x16xf32>
      %r16 = vector.load %rv[%token, %hd, %c0] : view<[%tokens]x24x16xf32> -> vector<16xf32>
      %rbv = buffer.view %rel_bias[%zero] : buffer -> view<1024x16xf32>
      %mf, %lf, %af = scf.for %k = [%st to %en step %c1](%m = %neg_big : f32, %l = %zero_f : f32, %acc = %zero4 : vector<4xf32>) -> (f32, f32, vector<4xf32>) {
        %kp_raw = index.add %w_low, %k : index
        %kp = index.assume %kp_raw [range(%kp_raw, 0, 1048575)] : index
        %in_cur = index.cmp uge, %kp, %sp_start : index
        %kh16, %vh16 = scf.if %in_cur -> (vector<4xf16>, vector<4xf16>) {
          %rel = index.sub %kp, %sp_start : index
          %tk_v = index.add %sp_first, %rel : index
          %tk = index.assume %tk_v [range(%tk_v, 0, 8191), lt(%tk_v, %tokens)] : index
          %khc = vector.load %swa_cur_v[%tk, %c0, %kh, %lane, %c0] : view<[%tokens]x2x8x32x4xf16> -> vector<4xf16>
          %vhc = vector.load %swa_cur_v[%tk, %c1, %kh, %lane, %c0] : view<[%tokens]x2x8x32x4xf16> -> vector<4xf16>
          scf.yield %khc, %vhc : vector<4xf16>, vector<4xf16>
        } else {
          %cRING = index.constant 1040 : index
          %rp = index.rem %kp, %cRING : index
          %rpo = index.scale %rp, %pos_bytes : index, offset -> offset
          %ko = index.add %ring_rd, %rpo : offset
          %vo = index.add %ko, %ring_v_stride : offset
          %kc = buffer.view %arena[%ko] : buffer -> view<8x32x4xf16>
          %vc = buffer.view %arena[%vo] : buffer -> view<8x32x4xf16>
          %kho = vector.load %kc[%kh, %lane, %c0] : view<8x32x4xf16> -> vector<4xf16>
          %vho = vector.load %vc[%kh, %lane, %c0] : view<8x32x4xf16> -> vector<4xf16>
          scf.yield %kho, %vho : vector<4xf16>, vector<4xf16>
        }
        %k4 = vector.extf %kh16 : vector<4xf16> to vector<4xf32>
        %v4 = vector.extf %vh16 : vector<4xf16> to vector<4xf32>
        %p4 = vector.dotf<reassoc|contract> %q4, %k4, %zero_f : vector<4xf32>, vector<4xf32>, f32
        %s_qk = kernel.subgroup.reduce<addf> %p4 : f32
        %dist = index.sub %pos, %kp : index
        %in_ext = index.cmp ult, %dist, %cEXT : index
        %rb = scf.if %in_ext -> (f32) {
          %db = index.assume %dist [range(%dist, 0, 1023)] : index
          %bv = vector.load %rbv[%db, %c0] : view<1024x16xf32> -> vector<16xf32>
          %rd = vector.dotf<reassoc|contract> %r16, %bv, %zero_f : vector<16xf32>, vector<16xf32>, f32
          scf.yield %rd : f32
        } else {
          scf.yield %zero_f : f32
        }
