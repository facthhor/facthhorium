      %deq1_upper = vector.andi %deq1_shifted, %deq1_mask : vector<8xi8>
      %deq1_k0 = scalar.constant 0 : i8
      %deq1_k1 = scalar.constant 60 : i8
      %deq1_k2 = scalar.constant 64 : i8
      %deq1_k3 = scalar.constant 66 : i8
      %deq1_k4 = scalar.constant 68 : i8
      %deq1_k5 = scalar.constant 70 : i8
      %deq1_k6 = scalar.constant 72 : i8
      %deq1_k7 = scalar.constant 74 : i8
