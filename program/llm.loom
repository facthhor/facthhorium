    %nw1 = vector.load %nwv[%i1, %c0] : view<576x4xf32> -> vector<4xf32>
    %y0a = vector.mulf %m0_4, %ninvv : vector<4xf32>
    %y0 = vector.mulf %y0a, %nw0 : vector<4xf32>

    %y1a = vector.mulf %m1_4, %ninvv : vector<4xf32>
    %y1 = vector.mulf %y1a, %nw1 : vector<4xf32>

    %y2 = scf.if %has2 -> (vector<4xf32>) {
      %i2 = index.assume %i2_raw [range(%i2_raw, 0, 575)] : index
      %nw2 = vector.load %nwv[%i2, %c0] : view<576x4xf32> -> vector<4xf32>
      %y2a = vector.mulf %m2_4, %ninvv : vector<4xf32>
      %y2v = vector.mulf %y2a, %nw2 : vector<4xf32>

