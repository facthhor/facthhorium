    %sq4_2 = vector.dotf<reassoc|contract> %s4_2, %s4_2, %sq4_1 : vector<4xf32>, vector<4xf32>, f32
    %dt4_0 = vector.dotf<reassoc|contract> %s4_0, %q0, %zero_f : vector<4xf32>, vector<4xf32>, f32
    %dt4_1 = vector.dotf<reassoc|contract> %s4_1, %q1, %dt4_0 : vector<4xf32>, vector<4xf32>, f32
    %dt4_2 = vector.dotf<reassoc|contract> %s4_2, %q2, %dt4_1 : vector<4xf32>, vector<4xf32>, f32
    %tsq0 = kernel.workgroup.reduce<addf> %sq0_2 : f32
    %tdt0 = kernel.workgroup.reduce<addf> %dt0_2 : f32
    %mn0 = scalar.mulf %tsq0, %inv_H : f32
    %vr0 = scalar.addf %mn0, %eps : f32
    %ir0 = scalar.rsqrtf %vr0 : f32
