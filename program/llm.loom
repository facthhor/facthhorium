    %vwt1 = vector.addf %vsw1, %vdw1 : vector<4xf32>
    %vw2_0 = view.load %vwv[%kh, %lane, 0, 2] : view<8x32x4x4xf32> -> f32
    %vw2_1 = view.load %vwv[%kh, %lane, 1, 2] : view<8x32x4x4xf32> -> f32
    %vw2_2 = view.load %vwv[%kh, %lane, 2, 2] : view<8x32x4x4xf32> -> f32
    %vw2_3 = view.load %vwv[%kh, %lane, 3, 2] : view<8x32x4x4xf32> -> f32
    %vsw2 = vector.from_elements %vw2_0, %vw2_1, %vw2_2, %vw2_3 : vector<4xf32>
    %vwt2 = vector.addf %vsw2, %vdw2 : vector<4xf32>
    %vw3_0 = view.load %vwv[%kh, %lane, 0, 3] : view<8x32x4x4xf32> -> f32
    %vw3_1 = view.load %vwv[%kh, %lane, 1, 3] : view<8x32x4x4xf32> -> f32
    %vw3_2 = view.load %vwv[%kh, %lane, 2, 3] : view<8x32x4x4xf32> -> f32
    %vw3_3 = view.load %vwv[%kh, %lane, 3, 3] : view<8x32x4x4xf32> -> f32
    %vsw3 = vector.from_elements %vw3_0, %vw3_1, %vw3_2, %vw3_3 : vector<4xf32>
    %vwt3 = vector.addf %vsw3, %vdw3 : vector<4xf32>
