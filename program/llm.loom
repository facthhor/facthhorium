      %deq1_k10 = scalar.constant -64 : i8
      %deq1_k11 = scalar.constant -62 : i8
      %deq1_k12 = scalar.constant -60 : i8
      %deq1_k13 = scalar.constant -58 : i8
      %deq1_k14 = scalar.constant -56 : i8
      %deq1_k15 = scalar.constant -54 : i8
      %deq1_cb = vector.from_elements %deq1_k0, %deq1_k1, %deq1_k2, %deq1_k3, %deq1_k4, %deq1_k5, %deq1_k6, %deq1_k7, %deq1_k0, %deq1_k9, %deq1_k10, %deq1_k11, %deq1_k12, %deq1_k13, %deq1_k14, %deq1_k15 : vector<16xi8>
