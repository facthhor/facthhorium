  %sqb1 = vector.dotf<reassoc|contract> %b1, %b1, %sqb0 : vector<4xf32>, vector<4xf32>, f32
  %sqb2 = vector.dotf<reassoc|contract> %b2, %b2, %sqb1 : vector<4xf32>, vector<4xf32>, f32
  %dtb0 = vector.dotf<reassoc|contract> %b0, %q0, %zero_f : vector<4xf32>, vector<4xf32>, f32
  %dtb1 = vector.dotf<reassoc|contract> %b1, %q1, %dtb0 : vector<4xf32>, vector<4xf32>, f32
  %dtb2 = vector.dotf<reassoc|contract> %b2, %q2, %dtb1 : vector<4xf32>, vector<4xf32>, f32
  %ta_sq = kernel.workgroup.reduce<addf> %sqa2 : f32
  %ta_dt = kernel.workgroup.reduce<addf> %dta2 : f32
  %tb_sq = kernel.workgroup.reduce<addf> %sqb2 : f32
  %tb_dt = kernel.workgroup.reduce<addf> %dtb2 : f32
  %ma = scalar.mulf %ta_sq, %inv_H : f32
  %va = scalar.addf %ma, %eps : f32
  %ira = scalar.rsqrtf %va : f32
  %sca0 = scalar.mulf %ta_dt, %ira : f32
  %sca = scalar.mulf %sca0, %inv_sqrt_H : f32
  %mb = scalar.mulf %tb_sq, %inv_H : f32
  %vb = scalar.addf %mb, %eps : f32
  %irb = scalar.rsqrtf %vb : f32
  %scb0 = scalar.mulf %tb_dt, %irb : f32
  %scb = scalar.mulf %scb0, %inv_sqrt_H : f32
  // 2-element softmax: pa = sigmoid(sca - scb), pb = 1 - pa!
  %one_f = scalar.constant 1.0 : f32
  %diff = scalar.subf %sca, %scb : f32
  %pa = scalar.logisticf<afn> %diff : f32
  %pb = scalar.subf %one_f, %pa : f32
  %wa = scalar.mulf %pa, %ira : f32
  %wb = scalar.mulf %pb, %irb : f32
  %wav = vector.splat %wa : vector<4xf32>
  %wbv = vector.splat %wb : vector<4xf32>
  %y0a = vector.mulf %wav, %a0 : vector<4xf32>
  %y0 = vector.fmaf %wbv, %b0, %y0a : vector<4xf32>
  vector.store %y0, %ov[%qi, %tok, %i0, %c0] : vector<4xf32>, view<[%q_cnt]x[%tokens]x576x4xf32>
  %y1a = vector.mulf %wav, %a1 : vector<4xf32>
  %y1 = vector.fmaf %wbv, %b1, %y1a : vector<4xf32>
  vector.store %y1, %ov[%qi, %tok, %i1, %c0] : vector<4xf32>, view<[%q_cnt]x[%tokens]x576x4xf32>
  scf.if %has2 {
    %i2 = index.assume %i2_raw [range(%i2_raw, 0, 575)] : index
    %y2a = vector.mulf %wav, %a2 : vector<4xf32>
    %y2 = vector.fmaf %wbv, %b2, %y2a : vector<4xf32>
    vector.store %y2, %ov[%qi, %tok, %i2, %c0] : vector<4xf32>, view<[%q_cnt]x[%tokens]x576x4xf32>
  }
  kernel.return
}


