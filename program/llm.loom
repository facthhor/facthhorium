  %kh = index.assume %kh_raw [range(%kh_raw, 0, 7)] : index
  %lane_raw = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_raw [range(%lane_raw, 0, 31)] : index
  %zero = index.constant 0 : offset
  %cWIN = index.constant 1024 : index
  %c0_i32 = scalar.constant 0 : i32
  %iv = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %live32 = view.load %iv[%tok, 2] : view<[%tokens]x4xi32> -> i32
  %live = scalar.cmpi ne, %live32, %c0_i32 : i32
  scf.if %live {
    %row32 = view.load %iv[%tok, 0] : view<[%tokens]x4xi32> -> i32
    %pos32 = view.load %iv[%tok, 1] : view<[%tokens]x4xi32> -> i32
    %row_b = scalar.assume %row32 [range(%row32, 0, 2147483646)] : i32
    %pos_b = scalar.assume %pos32 [range(%pos32, 0, 1048575)] : i32
    %row = index.cast %row_b : i32 to index
    %pos = index.cast %pos_b : i32 to index
    %rp = index.rem %pos, %cWIN : index
    %cstride = index.constant 8404992 : offset
    %row_at = index.scale %row, %cstride : index, offset -> offset
    %rbase = index.add %row_at, %ring_off : offset
    %pos_bytes = index.constant 2048 : offset
    %rpo = index.scale %rp, %pos_bytes : index, offset -> offset
    %ko = index.add %rbase, %rpo : offset
    %plane_sz = index.constant 2097152 : offset
    %vo = index.add %ko, %plane_sz : offset
    %kv_src = buffer.view %k_in[%zero] : buffer -> view<[%tokens]x8x128xf32>
    %vv_src = buffer.view %v_in[%zero] : buffer -> view<[%tokens]x8x128xf32>
    %knv = buffer.view %knorm[%zero] : buffer -> view<128xf32>
    %c32 = index.constant 32 : index
    %c64 = index.constant 64 : index
    %c96 = index.constant 96 : index
    %i0 = index.assume %lane [range(%lane, 0, 31)] : index
    %i0h_v = index.add %lane, %c64 : index
    %i0h = index.assume %i0h_v [range(%i0h_v, 64, 95)] : index
    %i1_v = index.add %lane, %c32 : index
    %i1 = index.assume %i1_v [range(%i1_v, 32, 63)] : index
    %i1h_v = index.add %lane, %c96 : index
    %i1h = index.assume %i1h_v [range(%i1h_v, 96, 127)] : index
    %x0 = view.load %kv_src[%tok, %kh, %i0] : view<[%tokens]x8x128xf32> -> f32
    %x0h = view.load %kv_src[%tok, %kh, %i0h] : view<[%tokens]x8x128xf32> -> f32
    %x1 = view.load %kv_src[%tok, %kh, %i1] : view<[%tokens]x8x128xf32> -> f32
    %x1h = view.load %kv_src[%tok, %kh, %i1h] : view<[%tokens]x8x128xf32> -> f32
    %q0 = scalar.mulf %x0, %x0 : f32
    %q1 = scalar.fmaf %x0h, %x0h, %q0 : f32
    %q2 = scalar.fmaf %x1, %x1, %q1 : f32
    %q3 = scalar.fmaf %x1h, %x1h, %q2 : f32
    %ssq = kernel.subgroup.reduce<addf> %q3 : f32
    %inv_d = scalar.constant 0.0078125 : f32
    %msq = scalar.mulf %ssq, %inv_d : f32
    %eps_r = scalar.constant 9.999999974752427e-07 : f32
    %st_r = scalar.addf %msq, %eps_r : f32
    %ir = scalar.rsqrtf %st_r : f32
    %w0 = view.load %knv[%i0] : view<128xf32> -> f32
    %w0h = view.load %knv[%i0h] : view<128xf32> -> f32
    %w1 = view.load %knv[%i1] : view<128xf32> -> f32
    %w1h = view.load %knv[%i1h] : view<128xf32> -> f32
    %s0_a = scalar.mulf %x0, %ir : f32
    %s0 = scalar.mulf %s0_a, %w0 : f32
    %s0h_a = scalar.mulf %x0h, %ir : f32
    %s0h = scalar.mulf %s0h_a, %w0h : f32
    %s1_a = scalar.mulf %x1, %ir : f32
    %s1 = scalar.mulf %s1_a, %w1 : f32
    %s1h_a = scalar.mulf %x1h, %ir : f32
    %s1h = scalar.mulf %s1h_a, %w1h : f32
    %pos_f = scalar.sitofp %pos32 : i32 to f32
    %ln_st = scalar.constant -0.21586735246819178 : f32
    %p0_i = index.cast %i0 : index to i32
    %p0_f = scalar.uitofp %p0_i : i32 to f32
    %lf0 = scalar.mulf %p0_f, %ln_st : f32
    %fr0 = scalar.expf<afn> %lf0 : f32
    %an0 = scalar.mulf %pos_f, %fr0 : f32
    %sn0 = scalar.sinf<afn> %an0 : f32
    %cs0 = scalar.cosf<afn> %an0 : f32
    %t0a = scalar.mulf %s0, %cs0 : f32
    %t0b = scalar.mulf %s0h, %sn0 : f32
    %kv0 = scalar.subf %t0a, %t0b : f32
    %t0c = scalar.mulf %s0h, %cs0 : f32
    %t0d = scalar.mulf %s0, %sn0 : f32
    %kv0h = scalar.addf %t0c, %t0d : f32
    %p1_i = index.cast %i1 : index to i32
    %p1_f = scalar.uitofp %p1_i : i32 to f32
    %lf1 = scalar.mulf %p1_f, %ln_st : f32
    %fr1 = scalar.expf<afn> %lf1 : f32
    %an1 = scalar.mulf %pos_f, %fr1 : f32
    %sn1 = scalar.sinf<afn> %an1 : f32
    %cs1 = scalar.cosf<afn> %an1 : f32
    %t1a = scalar.mulf %s1, %cs1 : f32
    %t1b = scalar.mulf %s1h, %sn1 : f32
    %kv1 = scalar.subf %t1a, %t1b : f32
    %t1c = scalar.mulf %s1h, %cs1 : f32
    %t1d = scalar.mulf %s1, %sn1 : f32
    %kv1h = scalar.addf %t1c, %t1d : f32
    %k0h16 = scalar.fptrunc %kv0 : f32 to f16
    %k0hh16 = scalar.fptrunc %kv0h : f32 to f16
    %k1h16 = scalar.fptrunc %kv1 : f32 to f16
    %k1hh16 = scalar.fptrunc %kv1h : f32 to f16
    %kd = buffer.view %carry[%ko] : buffer -> view<8x128xf16>
    view.store %k0h16, %kd[%kh, %i0] : f16, view<8x128xf16>
    view.store %k0hh16, %kd[%kh, %i0h] : f16, view<8x128xf16>
    view.store %k1h16, %kd[%kh, %i1] : f16, view<8x128xf16>
    view.store %k1hh16, %kd[%kh, %i1h] : f16, view<8x128xf16>
    %v0 = view.load %vv_src[%tok, %kh, %i0] : view<[%tokens]x8x128xf32> -> f32
    %v0h = view.load %vv_src[%tok, %kh, %i0h] : view<[%tokens]x8x128xf32> -> f32
    %v1 = view.load %vv_src[%tok, %kh, %i1] : view<[%tokens]x8x128xf32> -> f32
    %v1h = view.load %vv_src[%tok, %kh, %i1h] : view<[%tokens]x8x128xf32> -> f32
    %vh0 = scalar.fptrunc %v0 : f32 to f16
    %vh0h = scalar.fptrunc %v0h : f32 to f16
    %vh1 = scalar.fptrunc %v1 : f32 to f16
    %vh1h = scalar.fptrunc %v1h : f32 to f16
    %vd = buffer.view %carry[%vo] : buffer -> view<8x128xf16>
    view.store %vh0, %vd[%kh, %i0] : f16, view<8x128xf16>
    view.store %vh0h, %vd[%kh, %i0h] : f16, view<8x128xf16>
    view.store %vh1, %vd[%kh, %i1] : f16, view<8x128xf16>
    view.store %vh1h, %vd[%kh, %i1h] : f16, view<8x128xf16>
  }
  kernel.return
}

kernel.def export("g_dsp_prepare") @g_dsp_prepare() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%espans_arg: index, %blocks_arg: index, %etokens_arg: index, %epoch: buffer, %target_tokens: buffer, %metadata: buffer, %anchor_ids: buffer, %prev_tok: buffer, %slots: buffer, %step_meta: buffer) {
  %espans = index.assume %espans_arg [range(%espans_arg, 1, 8192)] : index
  %blocks = index.assume %blocks_arg [range(%blocks_arg, 1, 1024)] : index
  %etokens = index.assume %etokens_arg [range(%etokens_arg, 1, 8192)] : index
  %zero = index.constant 0 : offset
  %c16 = index.constant 16 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c9 = index.constant 9 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c8_i32 = scalar.constant 8 : i32
  %hdr = buffer.view %epoch[%zero] : buffer -> view<4xi32>
  %cnt32 = view.load %hdr[0] : view<4xi32> -> i32
  %eos = view.load %hdr[1] : view<4xi32> -> i32
  %mixed_w = view.load %hdr[2] : view<4xi32> -> i32
  %mixed = scalar.cmpi ne, %mixed_w, %c0_i32 : i32
  %id_stride = scf.select %mixed, %c8, %c1 : index
  %n_ids = index.mul %etokens, %id_stride : index
  %ids_flat = buffer.view %target_tokens[%zero] : buffer -> view<[%n_ids]xi32>
  %cnt_b = scalar.assume %cnt32 [range(%cnt32, 0, 8192)] : i32
  %cnt_v = index.cast %cnt_b : i32 to index
  %cnt = index.min %cnt_v, %espans : index
  %recs = buffer.view %epoch[%c16] : buffer -> view<[%espans]x9xi32>
  %out = buffer.view %metadata[%c16] : buffer -> view<[%blocks]x9xi32>
  %sm = buffer.view %step_meta[%c16] : buffer -> view<[%blocks]x9xi32>
  %av = buffer.view %anchor_ids[%zero] : buffer -> view<[%blocks]xi32>
  %pv = buffer.view %prev_tok[%zero] : buffer -> view<[%blocks]xi32>
  %sv = buffer.view %slots[%zero] : buffer -> view<[%blocks]xi32>
  %total = scf.for %s = [%c0 to %cnt step %c1](%k = %c0 : index) -> (index) {
    %sb = index.assume %s [range(%s, 0, 8191), lt(%s, %espans)] : index
    %flags = view.load %recs[%sb, 6] : view<[%espans]x9xi32> -> i32
    %prop_b = scalar.andi %flags, %c2_i32 : i32
    %proposes = scalar.cmpi ne, %prop_b, %c0_i32 : i32
    %fits = index.cmp ult, %k, %blocks : index
    %take = scalar.andi %proposes, %fits : i1
    scf.if %take {
      %kb = index.assume %k [range(%k, 0, 1023), lt(%k, %blocks)] : index
      scf.for %w = [%c0 to %c9 step %c1] {
        %wb = index.assume %w [range(%w, 0, 8)] : index
        %v = view.load %recs[%sb, %wb] : view<[%espans]x9xi32> -> i32
        view.store %v, %out[%kb, %wb] : i32, view<[%blocks]x9xi32>
        view.store %v, %sm[%kb, %wb] : i32, view<[%blocks]x9xi32>
      }
      %base = index.mul %kb, %c8 : index
      %base32 = index.cast %base : index to i32
      view.store %c8_i32, %out[%kb, 0] : i32, view<[%blocks]x9xi32>
      view.store %base32, %out[%kb, 4] : i32, view<[%blocks]x9xi32>
      view.store %c0_i32, %out[%kb, 6] : i32, view<[%blocks]x9xi32>
      // step_meta: greedy (temp=0, flags=1, length=1, cursor=k)
      %k32 = index.cast %kb : index to i32
      view.store %c1_i32, %sm[%kb, 0] : i32, view<[%blocks]x9xi32>
      view.store %c0_i32, %sm[%kb, 2] : i32, view<[%blocks]x9xi32>
      view.store %k32, %sm[%kb, 4] : i32, view<[%blocks]x9xi32>
      view.store %c1_i32, %sm[%kb, 6] : i32, view<[%blocks]x9xi32>
      view.store %c0_i32, %sm[%kb, 7] : i32, view<[%blocks]x9xi32>
      %orig_cur = view.load %recs[%sb, 4] : view<[%espans]x9xi32> -> i32
      view.store %orig_cur, %sv[%kb] : i32, view<[%blocks]xi32>
      %oc_b = scalar.assume %orig_cur [range(%orig_cur, 0, 8191)] : i32
      %oc = index.cast %oc_b : i32 to index
      %oc_e = index.mul %oc, %id_stride : index
      %oc_idx = index.assume %oc_e [range(%oc_e, 0, 65535), lt(%oc_e, %n_ids)] : index
      %aid = view.load %ids_flat[%oc_idx] : view<[%n_ids]xi32> -> i32
      view.store %aid, %av[%kb] : i32, view<[%blocks]xi32>
      view.store %aid, %pv[%kb] : i32, view<[%blocks]xi32>
    }
    %kn = index.add %k, %c1 : index
    %next = scf.select %take, %kn, %k : index
    scf.yield %next : index
  }
  %tot32 = index.cast %total : index to i32
  // Zero inactive block slots [total..blocks) in metadata, step_meta, anchor_ids, prev_tok, slots
  // so no downstream kernel (or @g_gdn_span range assumes) ever reads uninitialized slab memory.
  scf.for %z = [%total to %blocks step %c1] {
    %zb = index.assume %z [range(%z, 0, 1023), lt(%z, %blocks)] : index
    scf.for %zw = [%c0 to %c9 step %c1] {
      %zwb = index.assume %zw [range(%zw, 0, 8)] : index
      view.store %c0_i32, %out[%zb, %zwb] : i32, view<[%blocks]x9xi32>
      view.store %c0_i32, %sm[%zb, %zwb] : i32, view<[%blocks]x9xi32>
    }
    view.store %c0_i32, %av[%zb] : i32, view<[%blocks]xi32>
    view.store %c0_i32, %pv[%zb] : i32, view<[%blocks]xi32>
    view.store %c0_i32, %sv[%zb] : i32, view<[%blocks]xi32>
  }
  %oh = buffer.view %metadata[%zero] : buffer -> view<4xi32>
  view.store %tot32, %oh[0] : i32, view<4xi32>
  view.store %eos, %oh[1] : i32, view<4xi32>
  view.store %c0_i32, %oh[2] : i32, view<4xi32>
  view.store %c0_i32, %oh[3] : i32, view<4xi32>
  %sh = buffer.view %step_meta[%zero] : buffer -> view<4xi32>
  view.store %tot32, %sh[0] : i32, view<4xi32>
  view.store %eos, %sh[1] : i32, view<4xi32>
  view.store %c0_i32, %sh[2] : i32, view<4xi32>
  view.store %c0_i32, %sh[3] : i32, view<4xi32>
  kernel.return
}

kernel.def export("g_dsp_embed") @g_dsp_embed(%tokens: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %blocks_arg: index, %anchor_ids: buffer, %table: buffer, %tok_norm: buffer, %mask_embd: buffer, %attn_norm0: buffer, %x: buffer, %h: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %blocks = index.assume %blocks_arg [range(%blocks_arg, 1, 1024)] : index
  %tok_id = kernel.workgroup.id<x> : index
  %tok = index.assume %tok_id [lt(%tok_id, %tokens)] : index
  %lane_id = kernel.workitem.id<x> : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 255)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c8 = index.constant 8 : index
  %cgpb = index.constant 1 : index
  %groups = index.constant 72 : index
  %zero_f = scalar.constant 0.0 : f32
  %zero32 = vector.splatf 0.0 : vector<32xf32>
  %cnt_f = scalar.constant 2304.0 : f32
  %eps = scalar.constant 9.999999974752427e-07 : f32
  %blk_v = index.div %tok, %c8 : index
  %blk = index.assume %blk_v [lt(%blk_v, %blocks)] : index
  %rel = index.rem %tok, %c8 : index
  %is_anchor = index.cmp eq, %rel, %c0 : index
  %active = index.cmp ult, %lane, %groups : index
  %raw = scf.if %is_anchor -> (vector<32xf32>) {
    %av = buffer.view %anchor_ids[%zero] : buffer -> view<[%blocks]xi32>
    %id_r = view.load %av[%blk] : view<[%blocks]xi32> -> i32
    %c0_i32 = scalar.constant 0 : i32
    %vlast = scalar.constant 200057 : i32
    %lo = scalar.maxsi %id_r, %c0_i32 : i32
    %cl = scalar.minsi %lo, %vlast : i32
    %bd = scalar.assume %cl [range(%cl, 0, 200057)] : i32
    %id = index.cast %bd : i32 to index
    %row_bytes = index.constant 2448 : offset
    %blk_bytes = index.constant 34 : offset
    %rorig = index.scale %id, %row_bytes : index, offset -> offset
    %vals = scf.if %active -> (vector<32xf32>) {
      %b_i = index.div %lane, %cgpb : index
      %w_i = index.rem %lane, %cgpb : index
      %b_add = index.scale %b_i, %blk_bytes : index, offset -> offset
      %orig = index.add %rorig, %b_add : offset
      %v = func.call @g_q8_0_values(%table, %orig, %w_i) : (buffer, offset, index) -> (vector<32xf32>)
      scf.yield %v : vector<32xf32>
    } else {
      scf.yield %zero32 : vector<32xf32>
    }
    %sq = vector.mulf %vals, %vals : vector<32xf32>
    %loc = vector.reduce<addf> %sq, %zero_f : vector<32xf32>, f32
    %tot = kernel.workgroup.reduce<addf> %loc : f32
    %mean = scalar.divf %tot, %cnt_f : f32
    %stab = scalar.addf %mean, %eps : f32
    %inv = scalar.rsqrtf %stab : f32
    %inv32 = vector.splat %inv : vector<32xf32>
    %tn_out = scf.if %active -> (vector<32xf32>) {
      %bl = index.assume %lane [range(%lane, 0, 71)] : index
      %tnv = buffer.view %tok_norm[%zero] : buffer -> view<72x32xf32>
      %tnw = vector.load %tnv[%bl, %c0] : view<72x32xf32> -> vector<32xf32>
      %nv = vector.mulf %vals, %inv32 : vector<32xf32>
      %ov = vector.mulf %nv, %tnw : vector<32xf32>
      scf.yield %ov : vector<32xf32>
    } else {
      scf.yield %zero32 : vector<32xf32>
    }
    scf.yield %tn_out : vector<32xf32>
  } else {
    %mv_out = scf.if %active -> (vector<32xf32>) {
      %bl = index.assume %lane [range(%lane, 0, 71)] : index
      %mv = buffer.view %mask_embd[%zero] : buffer -> view<72x32xf32>
      %mval = vector.load %mv[%bl, %c0] : view<72x32xf32> -> vector<32xf32>
      scf.yield %mval : vector<32xf32>
    } else {
      scf.yield %zero32 : vector<32xf32>
    }
    scf.yield %mv_out : vector<32xf32>
  }
  %sq2 = vector.mulf %raw, %raw : vector<32xf32>
  %loc2 = vector.reduce<addf> %sq2, %zero_f : vector<32xf32>, f32
  %tot2 = kernel.workgroup.reduce<addf> %loc2 : f32
  %mean2 = scalar.divf %tot2, %cnt_f : f32
  %stab2 = scalar.addf %mean2, %eps : f32
  %inv2 = scalar.rsqrtf %stab2 : f32
  %inv2_32 = vector.splat %inv2 : vector<32xf32>
  scf.if %active {
    %bl = index.assume %lane [range(%lane, 0, 71)] : index
    %xv = buffer.view %x[%zero] : buffer -> view<[%tokens]x72x32xf32>
    %hv = buffer.view %h[%zero] : buffer -> view<[%tokens]x72x32xf32>
    %av0 = buffer.view %attn_norm0[%zero] : buffer -> view<72x32xf32>
    vector.store %raw, %xv[%tok, %bl, %c0] : vector<32xf32>, view<[%tokens]x72x32xf32>
    %aw = vector.load %av0[%bl, %c0] : view<72x32xf32> -> vector<32xf32>
    %n2 = vector.mulf %raw, %inv2_32 : vector<32xf32>
    %ho = vector.mulf %n2, %aw : vector<32xf32>
    vector.store %ho, %hv[%tok, %bl, %c0] : vector<32xf32>, view<[%tokens]x72x32xf32>
  }
  kernel.return
}

kernel.def export("g_dsp_embed_q8") @g_dsp_embed_q8(%tokens: index) {
  %c1 = index.constant 1 : index
