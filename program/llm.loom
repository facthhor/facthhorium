    %row_b = scalar.assume %row32 [range(%row32, 0, 1023)] : i32
    %pos_b = scalar.assume %pos32 [range(%pos32, 0, 2097151)] : i32
    %row = index.cast %row_b : i32 to index
    %pos = index.cast %pos_b : i32 to index
    %is_swa = scalar.cmpi ne, %sliding_arg, %c0_i32 : i32
    %w_low = scf.if %is_swa -> (index) {
      %gt = index.cmp ugt, %pos, %cWIN1 : index
      %sub = index.sub %pos, %cWIN1 : index
      %wl = scf.select %gt, %sub, %c0 : index
      scf.yield %wl : index
    } else {
      scf.yield %c0 : index
    }
    %n_keys_0 = index.sub %pos, %w_low : index
    %n_keys_raw = index.add %n_keys_0, %c1 : index
    %n_keys = index.assume %n_keys_raw [range(%n_keys_raw, 1, 2097152)] : index
    // Active splits are bounded by the key count; unused groups exit.
    %c7 = index.constant 7 : index
    %c8 = index.constant 8 : index
    %nk7 = index.add %n_keys, %c7 : index
    %nk7_b = index.assume %nk7 [range(%nk7, 8, 2097159)] : index
    %s_need = index.div %nk7_b, %c8 : index
    %s_eff0 = index.min %s_need, %cS : index
    %s_eff = index.assume %s_eff0 [range(%s_eff0, 1, 256)] : index
    %sp_active = index.cmp ult, %sp, %s_eff : index
    scf.if %sp_active {
      %chunk0 = index.add %n_keys, %s_eff : index
      %chunk1_raw = index.sub %chunk0, %c1 : index
      %chunk1 = index.assume %chunk1_raw [range(%chunk1_raw, 1, 2097408)] : index
      %chunk = index.div %chunk1, %s_eff : index
      %st0 = index.mul %sp, %chunk : index
      %st = index.min %st0, %n_keys : index
      %en0 = index.add %st, %chunk : index
      %en = index.min %en0, %n_keys : index
      %k_plane = index.mul %layer, %c2 : index
      %pos_bytes = index.constant 2048 : offset
      %plane_stride = index.scale %pool, %pos_bytes : index, offset -> offset
      %qv = buffer.view %q_in[%zero] : buffer -> view<[%tokens]x24x32x4xf32>
      %q_raw = vector.load %qv[%tok, %hd, %lane, %c0] : view<[%tokens]x24x32x4xf32> -> vector<4xf32>
      %q4 = vector.mulf %q_raw, %scale4 : vector<4xf32>
      %rv = buffer.view %r_in[%zero] : buffer -> view<[%tokens]x24x16xf32>
      %r16 = vector.load %rv[%tok, %hd, %c0] : view<[%tokens]x24x16xf32> -> vector<16xf32>
      %rbv = buffer.view %rel_bias[%zero] : buffer -> view<1024x16xf32>
      %c16 = index.constant 16 : index
      %st_pos_v = index.add %w_low, %st : index
      %st_pos = index.assume %st_pos_v [range(%st_pos_v, 0, 2097152)] : index
      %en_pos_v = index.add %w_low, %en : index
      %en_pos = index.assume %en_pos_v [range(%en_pos_v, 0, 2097152)] : index
      %has_keys = index.cmp ult, %st_pos, %en_pos : index
      %mf, %lf, %af = scf.if %has_keys -> (f32, f32, vector<4xf32>) {
        %pg0 = index.div %st_pos, %c16 : index
        %en_m1_v = index.sub %en_pos, %c1 : index
        %en_m1 = index.assume %en_m1_v [range(%en_m1_v, 0, 2097151)] : index
        %pg1_0 = index.div %en_m1, %c16 : index
        %pg1 = index.add %pg1_0, %c1 : index
        %pmf, %plf, %paf = scf.for %pg = [%pg0 to %pg1 step %c1](%m = %neg_inf : f32, %l = %zero_f : f32, %acc = %zero4 : vector<4xf32>) -> (f32, f32, vector<4xf32>) {
          %p_base = index.mul %pg, %c16 : index
          %lo_pos = index.max %p_base, %st_pos : index
          %p_next = index.add %p_base, %c16 : index
          %hi_pos = index.min %p_next, %en_pos : index
          %n_in_pg = index.sub %hi_pos, %lo_pos : index
          %ko_base = func.call @g_kv_offset(%origins, %row, %lo_pos, %blocks, %k_plane, %pool) : (buffer, index, index, index, index, index) -> (offset)
          %hi_m1 = index.sub %hi_pos, %c1 : index
          %min_dist = index.sub %pos, %hi_m1 : index
          %near_pg = index.cmp ult, %min_dist, %cEXT : index
          %nm_pg, %nl_pg, %na_pg = scf.if %near_pg -> (f32, f32, vector<4xf32>) {
            %m1, %l1, %a1 = scf.for %j = [%c0 to %n_in_pg step %c1](%mi = %m : f32, %li = %l : f32, %ai = %acc : vector<4xf32>) -> (f32, f32, vector<4xf32>) {
              %kp = index.add %lo_pos, %j : index
              %j_off = index.scale %j, %pos_bytes : index, offset -> offset
              %ko = index.add %ko_base, %j_off : offset
              %kc = buffer.view %arena[%ko] : buffer -> view<8x32x4xf16>
              %kh16 = vector.load %kc[%kh, %lane, %c0] : view<8x32x4xf16> -> vector<4xf16>
              %k4 = vector.extf %kh16 : vector<4xf16> to vector<4xf32>
              %vo = index.add %ko, %plane_stride : offset
              %vc = buffer.view %arena[%vo] : buffer -> view<8x32x4xf16>
              %vh16 = vector.load %vc[%kh, %lane, %c0] : view<8x32x4xf16> -> vector<4xf16>
              %v4 = vector.extf %vh16 : vector<4xf16> to vector<4xf32>
              %p4 = vector.dotf<reassoc|contract> %q4, %k4, %zero_f : vector<4xf32>, vector<4xf32>, f32
              %s_qk = kernel.subgroup.reduce<addf> %p4 : f32
              %dist = index.sub %pos, %kp : index
              %in_ext = index.cmp ult, %dist, %cEXT : index
              %rb = scf.if %in_ext -> (f32) {
                %db = index.assume %dist [range(%dist, 0, 1023)] : index
                %bv = vector.load %rbv[%db, %c0] : view<1024x16xf32> -> vector<16xf32>
                %rd = vector.dotf<reassoc|contract> %r16, %bv, %zero_f : vector<16xf32>, vector<16xf32>, f32
                scf.yield %rd : f32
              } else {
                scf.yield %zero_f : f32
              }
              %s = scalar.addf %s_qk, %rb : f32
              %nm = scalar.maxnumf %mi, %s : f32
              %ms = scalar.subf %mi, %nm : f32
              %al = scalar.expf<afn> %ms : f32
              %ls = scalar.mulf %li, %al : f32
              %alv = vector.splat %al : vector<4xf32>
              %as = vector.mulf %ai, %alv : vector<4xf32>
              %ds = scalar.subf %s, %nm : f32
              %pv = scalar.expf<afn> %ds : f32
              %nl = scalar.addf %ls, %pv : f32
              %pvv = vector.splat %pv : vector<4xf32>
              %na = vector.fmaf %pvv, %v4, %as : vector<4xf32>
              scf.yield %nm, %nl, %na : f32, f32, vector<4xf32>
            }
            scf.yield %m1, %l1, %a1 : f32, f32, vector<4xf32>
          } else {
            %m2, %l2, %a2 = scf.for %j = [%c0 to %n_in_pg step %c1](%mi = %m : f32, %li = %l : f32, %ai = %acc : vector<4xf32>) -> (f32, f32, vector<4xf32>) {
              %j_off = index.scale %j, %pos_bytes : index, offset -> offset
              %ko = index.add %ko_base, %j_off : offset
              %kc = buffer.view %arena[%ko] : buffer -> view<8x32x4xf16>
              %kh16 = vector.load %kc[%kh, %lane, %c0] : view<8x32x4xf16> -> vector<4xf16>
              %k4 = vector.extf %kh16 : vector<4xf16> to vector<4xf32>
              %vo = index.add %ko, %plane_stride : offset
              %vc = buffer.view %arena[%vo] : buffer -> view<8x32x4xf16>
              %vh16 = vector.load %vc[%kh, %lane, %c0] : view<8x32x4xf16> -> vector<4xf16>
              %v4 = vector.extf %vh16 : vector<4xf16> to vector<4xf32>
              %p4 = vector.dotf<reassoc|contract> %q4, %k4, %zero_f : vector<4xf32>, vector<4xf32>, f32
              %s = kernel.subgroup.reduce<addf> %p4 : f32
              %nm = scalar.maxnumf %mi, %s : f32
              %ms = scalar.subf %mi, %nm : f32
              %al = scalar.expf<afn> %ms : f32
              %ls = scalar.mulf %li, %al : f32
              %alv = vector.splat %al : vector<4xf32>
              %as = vector.mulf %ai, %alv : vector<4xf32>
              %ds = scalar.subf %s, %nm : f32
              %pv = scalar.expf<afn> %ds : f32
              %nl = scalar.addf %ls, %pv : f32
              %pvv = vector.splat %pv : vector<4xf32>
              %na = vector.fmaf %pvv, %v4, %as : vector<4xf32>
              scf.yield %nm, %nl, %na : f32, f32, vector<4xf32>
            }
            scf.yield %m2, %l2, %a2 : f32, f32, vector<4xf32>
          }
          scf.yield %nm_pg, %nl_pg, %na_pg : f32, f32, vector<4xf32>
        }
        scf.yield %pmf, %plf, %paf : f32, f32, vector<4xf32>
      } else {
        scf.yield %neg_inf, %zero_f, %zero4 : f32, f32, vector<4xf32>
      }
      scf.if %is_l0 {
        view.store %mf, %pm_v[%tok, %hd, %sp] : f32, view<[%tokens]x24x[%cS]xf32>
        view.store %lf, %pl_v[%tok, %hd, %sp] : f32, view<[%tokens]x24x[%cS]xf32>
      }
      vector.store %af, %po_v[%tok, %hd, %sp, %lane, %c0] : vector<4xf32>, view<[%tokens]x24x[%cS]x32x4xf32>
    }
  }
  kernel.return
}

kernel.def export("g_ink_attn_combine") @g_ink_attn_combine(%tokens: index) {
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  %cQH = index.constant 24 : index
  kernel.launch.config workgroups(%tokens, %cQH, %c1) workgroup_size(%c32, %c1, %c1) : index
} launch(%tokens_arg: index, %sliding_arg: i32, %info: buffer, %pm: buffer, %pl: buffer, %po: buffer, %sinks: buffer, %gate: buffer, %out: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %tok_id = kernel.workgroup.id<x> : index
  %tok = index.assume %tok_id [lt(%tok_id, %tokens)] : index
  %hd_id = kernel.workgroup.id<y> : index
  %hd = index.assume %hd_id [range(%hd_id, 0, 23)] : index
  %lane_raw = kernel.workitem.id<x> : index
  %lane = index.assume %lane_raw [range(%lane_raw, 0, 31)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %normal_splits = index.constant 64 : index
  %wide_splits = index.constant 256 : index
  %cWIN1 = index.constant 1023 : index
  %zero = index.constant 0 : offset
  %c0_i32 = scalar.constant 0 : i32
  %zero_f = scalar.constant 0.0 : f32
  %zero4 = vector.splatf 0.0 : vector<4xf32>
  %c4 = index.constant 4 : index
  %c127_f = scalar.constant 127.0 : f32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c4_i32 = scalar.constant 4 : i32
  %c8_i32 = scalar.constant 8 : i32
  %zero1i = vector.splati 0 : vector<1xi32>
  %ones4 = vector.splati 1 : vector<4xi8>
  %info_v = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %qg_in_hd = index.div %lane, %c8 : index
  %sub_l = index.rem %lane, %c8 : index
  %g_base = index.mul %hd, %c4 : index
  %g_v = index.add %g_base, %qg_in_hd : index
  %g = index.assume %g_v [range(%g_v, 0, 95)] : index
  %qv = buffer.view %out[%zero] : buffer -> view<[%tokens]x96x8xi32>
  %m_bytes = index.constant 3072 : offset
  %m_off = index.scale %tokens, %m_bytes : index, offset -> offset
  %mv = buffer.view %out[%m_off] : buffer -> view<[%tokens]x96x2xf32>
  %is_sub0 = index.cmp eq, %sub_l, %c0 : index
  %live32 = view.load %info_v[%tok, 2] : view<[%tokens]x4xi32> -> i32
  %live = scalar.cmpi ne, %live32, %c0_i32 : i32
  %res = scf.if %live -> (vector<4xf32>) {
    %pos32 = view.load %info_v[%tok, 1] : view<[%tokens]x4xi32> -> i32
    %pos_b = scalar.assume %pos32 [range(%pos32, 0, 2097151)] : i32
    %pos = index.cast %pos_b : i32 to index
    %is_swa = scalar.cmpi ne, %sliding_arg, %c0_i32 : i32
    %global_layer = scalar.cmpi eq, %sliding_arg, %c0_i32 : i32
    %one_token = index.cmp eq, %tokens, %c1 : index
    %wide = scalar.andi %one_token, %global_layer : i1
    %cS = scf.select %wide, %wide_splits, %normal_splits : index
    %w_low = scf.if %is_swa -> (index) {
      %gt = index.cmp ugt, %pos, %cWIN1 : index
      %sub = index.sub %pos, %cWIN1 : index
      %wl = scf.select %gt, %sub, %c0 : index
      scf.yield %wl : index
    } else {
      scf.yield %c0 : index
    }
    %nk0 = index.sub %pos, %w_low : index
    %nk_raw = index.add %nk0, %c1 : index
    %nk = index.assume %nk_raw [range(%nk_raw, 1, 2097152)] : index
    %nk7 = index.add %nk, %c7 : index
    %nk7_b = index.assume %nk7 [range(%nk7, 8, 2097159)] : index
    %s_need = index.div %nk7_b, %c8 : index
    %s_eff0 = index.min %s_need, %cS : index
    %s_eff = index.assume %s_eff0 [range(%s_eff0, 1, 256)] : index
    %pm_v = buffer.view %pm[%zero] : buffer -> view<[%tokens]x24x[%cS]xf32>
    %pl_v = buffer.view %pl[%zero] : buffer -> view<[%tokens]x24x[%cS]xf32>
    %po_v = buffer.view %po[%zero] : buffer -> view<[%tokens]x24x[%cS]x32x4xf32>
    %sv = buffer.view %sinks[%zero] : buffer -> view<[%tokens]x24xf32>
    %gv = buffer.view %gate[%zero] : buffer -> view<[%tokens]x24x32x4xf32>
    %sink = view.load %sv[%tok, %hd] : view<[%tokens]x24xf32> -> f32
    %warp = index.constant 32 : index
    %last_split = index.sub %s_eff, %c1 : index
    %lo_id = index.min %lane, %last_split : index
    %first = view.load %pm_v[%tok, %hd, %lo_id] : view<[%tokens]x24x[%cS]xf32> -> f32
    %pair_max = scf.for %step = [%warp to %s_eff step %warp](%prev = %first : f32) -> (f32) {
      %slot = index.add %step, %lane : index
      %active_slot = index.min %slot, %last_split : index
      %next = view.load %pm_v[%tok, %hd, %active_slot] : view<[%tokens]x24x[%cS]xf32> -> f32
      %best = scalar.maxnumf %prev, %next : f32
      scf.yield %best : f32
    }
    %split_max = kernel.subgroup.reduce<maxnumf> %pair_max : f32
    %mx = scalar.maxnumf %sink, %split_max : f32
    %s_sh = scalar.subf %sink, %mx : f32
    %d0 = scalar.expf<afn> %s_sh : f32
    %df, %af = scf.for %s = [%c0 to %s_eff step %c1](%d = %d0 : f32, %a = %zero4 : vector<4xf32>) -> (f32, vector<4xf32>) {
      %sb = index.assume %s [range(%s, 0, 255), lt(%s, %cS)] : index
      %ms = view.load %pm_v[%tok, %hd, %sb] : view<[%tokens]x24x[%cS]xf32> -> f32
      %ls = view.load %pl_v[%tok, %hd, %sb] : view<[%tokens]x24x[%cS]xf32> -> f32
      %os = vector.load %po_v[%tok, %hd, %sb, %lane, %c0] : view<[%tokens]x24x[%cS]x32x4xf32> -> vector<4xf32>
      %sh = scalar.subf %ms, %mx : f32
      %w = scalar.expf<afn> %sh : f32
      %nd = scalar.fmaf %ls, %w, %d : f32
      %wv = vector.splat %w : vector<4xf32>
      %na = vector.fmaf %os, %wv, %a : vector<4xf32>
      scf.yield %nd, %na : f32, vector<4xf32>
    }
    %one_f = scalar.constant 1.0 : f32
    %inv_d = scalar.divf %one_f, %df : f32
    %idv = vector.splat %inv_d : vector<4xf32>
    %att = vector.mulf %af, %idv : vector<4xf32>
    %g4 = vector.load %gv[%tok, %hd, %lane, %c0] : view<[%tokens]x24x32x4xf32> -> vector<4xf32>
    %sig = vector.logisticf<afn> %g4 : vector<4xf32>
    %res_live = vector.mulf %att, %sig : vector<4xf32>
    scf.yield %res_live : vector<4xf32>
  } else {
    scf.yield %zero4 : vector<4xf32>
  }
  // Direct Q8 quantization per 8-lane sub-group (8 lanes x 4 floats = 32 floats = 1 Q8 group, ZERO LDS/barrier!)
  %av = vector.absf %res : vector<4xf32>
  %am0 = vector.reduce<maxnumf> %av, %zero_f : vector<4xf32>, f32
  %am1p, %am1u = kernel.subgroup.shuffle<xor> %am0, %c1_i32, %c8_i32 : f32, i32, i32
  %am1 = scalar.maxnumf %am0, %am1p : f32
  %am2p, %am2u = kernel.subgroup.shuffle<xor> %am1, %c2_i32, %c8_i32 : f32, i32, i32
  %am2 = scalar.maxnumf %am1, %am2p : f32
  %am3p, %am3u = kernel.subgroup.shuffle<xor> %am2, %c4_i32, %c8_i32 : f32, i32, i32
  %amax = scalar.maxnumf %am2, %am3p : f32
  %d = scalar.divf %amax, %c127_f : f32
  %nz = scalar.cmpf one, %amax, %zero_f : f32
  %dv = vector.splat %d : vector<4xf32>
  %sc = vector.divf %res, %dv : vector<4xf32>
  %rd = vector.roundf %sc : vector<4xf32>
  %nzv = vector.splat %nz : vector<4xi1>
  %rs = vector.select %nzv, %rd, %zero4 : vector<4xf32>
  %q4 = vector.fptosi %rs : vector<4xf32> to vector<4xi8>
  %qw1 = vector.bitcast %q4 : vector<4xi8> to vector<1xi32>
  %qw = vector.extract %qw1[0] : vector<1xi32> -> i32
  view.store %qw, %qv[%tok, %g, %sub_l] : i32, view<[%tokens]x96x8xi32>
  %qs1 = vector.dot4i<s8s8> %q4, %ones4, %zero1i : vector<4xi8>, vector<4xi8>, vector<1xi32>
  %q0 = vector.extract %qs1[0] : vector<1xi32> -> i32
  %q1p, %q1u = kernel.subgroup.shuffle<xor> %q0, %c1_i32, %c8_i32 : i32, i32, i32
  %q1 = scalar.addi %q0, %q1p : i32
  %q2p, %q2u = kernel.subgroup.shuffle<xor> %q1, %c2_i32, %c8_i32 : i32, i32, i32
  %q2 = scalar.addi %q1, %q2p : i32
  %q3p, %q3u = kernel.subgroup.shuffle<xor> %q2, %c4_i32, %c8_i32 : i32, i32, i32
  %qtot = scalar.addi %q2, %q3p : i32
  scf.if %is_sub0 {
    %qsf = scalar.sitofp %qtot : i32 to f32
    %dh = scalar.fptrunc %d : f32 to f16
    %da = scalar.extf %dh : f16 to f32
    %meta = vector.from_elements %da, %qsf : vector<2xf32>
    vector.store %meta, %mv[%tok, %g, %c0] : vector<2xf32>, view<[%tokens]x96x2xf32>
  }
  kernel.return
}

// Direct single-pass attention for prefill epochs (t >= 64): ZERO split scratch buffer!
// 1 WG per (token, kv_head) = 3 waves (one per query head), lane l holds 4 head dims.
kernel.def export("g_ink_attn_direct") @g_ink_attn_direct(%tokens: index) {
  %c1 = index.constant 1 : index
  %cKH = index.constant 8 : index
  %lanes = index.constant 96 : index
  kernel.launch.config workgroups(%tokens, %cKH, %c1) workgroup_size(%lanes, %c1, %c1) : index
} launch(%tokens_arg: index, %blocks_arg: index, %pool_arg: index, %layer_arg: index, %sliding_arg: i32, %info: buffer, %origins: buffer, %q_in: buffer, %r_in: buffer, %rel_bias: buffer, %sinks: buffer, %gate: buffer, %arena: buffer, %out: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %blocks = index.assume %blocks_arg [range(%blocks_arg, 1, 131072)] : index
  %pool = index.assume %pool_arg [range(%pool_arg, 16, 2147483584)] : index
  %layer = index.assume %layer_arg [range(%layer_arg, 0, 47)] : index
  %tok_id = kernel.workgroup.id<x> : index
  %tok = index.assume %tok_id [lt(%tok_id, %tokens)] : index
  %kh_id = kernel.workgroup.id<y> : index
  %kh = index.assume %kh_id [range(%kh_id, 0, 7)] : index
  %wave_raw = kernel.subgroup.id : index
  %wave = index.assume %wave_raw [range(%wave_raw, 0, 2)] : index
  %lane_raw = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_raw [range(%lane_raw, 0, 31)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %cG = index.constant 3 : index
  %cEXT = index.constant 1024 : index
  %cWIN1 = index.constant 1023 : index
  %zero = index.constant 0 : offset
  %c0_i32 = scalar.constant 0 : i32
  %zero_f = scalar.constant 0.0 : f32
  %one_f = scalar.constant 1.0 : f32
  %zero4 = vector.splatf 0.0 : vector<4xf32>
  %scale = scalar.constant 0.08838834764831843 : f32
  %scale4 = vector.splat %scale : vector<4xf32>
  %hd_base = index.mul %kh, %cG : index
  %hd_v = index.add %hd_base, %wave : index
