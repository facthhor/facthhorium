    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    // Threads 0..63 compute inv_rms, power-of-2 row_scale, write %s_out, store inv_rms*scale -> sql_v[0, tid]
    %is_t64 = index.cmp ult, %tid, %c64 : index
    scf.if %is_t64 {
      %t64 = index.assume %tid [range(%tid, 0, 63)] : index
      %gt_raw = index.add %t_base, %t64 : index
      %gt_in = index.cmp ult, %gt_raw, %tokens : index
      scf.if %gt_in {
        %gt = index.assume %gt_raw [lt(%gt_raw, %tokens)] : index
        %glv = view.load %iv[%gt, 2] : view<[%tokens]x4xi32> -> i32
        %glive = scalar.cmpi ne, %glv, %c0_i32 : i32
        scf.if %glive {
          %s0 = view.load %sql_v[%c0, %t64] : view<2x64xf32> -> f32
          %s1 = view.load %sql_v[%c1, %t64] : view<2x64xf32> -> f32
          %tot_sq = scalar.addf %s0, %s1 : f32
          %m0 = view.load %mxl_v[%c0, %t64] : view<2x64xf32> -> f32
          %m1 = view.load %mxl_v[%c1, %t64] : view<2x64xf32> -> f32
          %tot_mx = scalar.maxnumf %m0, %m1 : f32
          %mean = scalar.mulf %tot_sq, %inv_H : f32
          %var = scalar.addf %mean, %eps : f32
          %inv_rms = scalar.rsqrtf %var : f32
          %maximum = scalar.mulf %tot_mx, %inv_rms : f32
          %bits = scalar.bitcast %maximum : f32 to i32
          %c23 = scalar.constant 23 : i32
          %c255 = scalar.constant 255 : i32
          %shifted = scalar.shrui %bits, %c23 : i32
          %biased = scalar.andi %shifted, %c255 : i32
          %c127 = scalar.constant 127 : i32
          %c13 = scalar.constant 13 : i32
          %c100 = scalar.constant 100 : i32
          %unbiased = scalar.subi %biased, %c127 : i32
          %raw_e = scalar.subi %unbiased, %c13 : i32
          %positive = scalar.maxsi %raw_e, %c0_i32 : i32
          %e = scalar.minsi %positive, %c100 : i32
          %scale_exp = scalar.subi %c127, %e : i32
          %inverse_exp = scalar.addi %c127, %e : i32
          %scale_bits = scalar.shli %scale_exp, %c23 : i32
          %inverse_bits = scalar.shli %inverse_exp, %c23 : i32
          %scale_f = scalar.bitcast %scale_bits : i32 to f32
          %inv_scale_f = scalar.bitcast %inverse_bits : i32 to f32
          view.store %scale_f, %scv[%gt, %c0] : f32, view<[%tokens]x2xf32>
          view.store %inv_scale_f, %scv[%gt, %c1] : f32, view<[%tokens]x2xf32>
          %comb_m = scalar.mulf %inv_rms, %scale_f : f32
          view.store %comb_m, %sql_v[%c0, %t64] : f32, view<2x64xf32>
        } else {
          view.store %zero_f, %scv[%gt, %c0] : f32, view<[%tokens]x2xf32>
          view.store %zero_f, %scv[%gt, %c1] : f32, view<[%tokens]x2xf32>
          view.store %zero_f, %sql_v[%c0, %t64] : f32, view<2x64xf32>
        }
      } else {
        view.store %zero_f, %sql_v[%c0, %t64] : f32, view<2x64xf32>
      }
