  %c3 = index.constant 3 : index
  %c16_r = index.constant 16 : index
  %c256 = index.constant 256 : index
  %cTOT = index.constant 6656 : index
  %zero_f = scalar.constant 0.0 : f32
  %ch_raw0 = index.mul %cb_id, %c256 : index
  %ch_raw = index.add %ch_raw0, %thread : index
