    %m2_3 = vector.fmaf %wv3, %s3_2, %m2_2 : vector<4xf32>
    %m2_4 = vector.fmaf %wv4, %s4_2, %m2_3 : vector<4xf32>
    // Fused RMSNorm + F16 row-scale on (%m0_4, %m1_4, %m2_4) in registers!
