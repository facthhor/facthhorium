    %w4 = scalar.mulf %pw4, %ir4 : f32
    %wv4 = vector.splat %w4 : vector<4xf32>
    %m0_0 = vector.mulf %wv0, %s0_0 : vector<4xf32>
    %m0_1 = vector.fmaf %wv1, %s1_0, %m0_0 : vector<4xf32>
