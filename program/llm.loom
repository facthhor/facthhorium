    %vwt0 = vector.addf %vsw0, %vdw0 : vector<4xf32>
    %vw1_0 = view.load %vwv[%kh, %lane, 0, 1] : view<8x32x4x4xf32> -> f32
    %vw1_1 = view.load %vwv[%kh, %lane, 1, 1] : view<8x32x4x4xf32> -> f32
    %vw1_2 = view.load %vwv[%kh, %lane, 2, 1] : view<8x32x4x4xf32> -> f32
    %vw1_3 = view.load %vwv[%kh, %lane, 3, 1] : view<8x32x4x4xf32> -> f32
