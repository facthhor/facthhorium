      %deq1_hi16c = vector.concat<0> %deq1_z8, %deq1_hi_hi : vector<8xi8>, vector<8xi8> -> vector<16xi8>
      %deq1_lo16 = vector.shuffle<[0, 8, 1, 9, 2, 10, 3, 11, 4, 12, 5, 13, 6, 14, 7, 15]> %deq1_lo16c : vector<16xi8>
      %deq1_hi16 = vector.shuffle<[0, 8, 1, 9, 2, 10, 3, 11, 4, 12, 5, 13, 6, 14, 7, 15]> %deq1_hi16c : vector<16xi8>
