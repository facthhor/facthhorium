// Decode bf16 projection: one 96-thread workgroup per (row, token), the same per-32-group dot + workgroup reduce as the
// 32-token-tile kernel (bit-identical), without its serial 32-token loop.
kernel.def export("g_ink_bf16_proj") @g_ink_bf16_proj(%tokens: index, %n: index) {
  %c1 = index.constant 1 : index
  %c96 = index.constant 96 : index
  kernel.launch.config workgroups(%n, %tokens, %c1) workgroup_size(%c96, %c1, %c1) : index
} launch(%tokens_arg: index, %n_arg: index, %info: buffer, %x: buffer, %w: buffer, %out: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %n = index.assume %n_arg [range(%n_arg, 1, 128)] : index
  %row_id = kernel.workgroup.id<x> : index
  %row = index.assume %row_id [lt(%row_id, %n)] : index
  %tok_id = kernel.workgroup.id<y> : index
  %tok = index.assume %tok_id [lt(%tok_id, %tokens)] : index
  %tid_raw = kernel.workitem.id<x> : index
  %tid = index.assume %tid_raw [range(%tid_raw, 0, 95)] : index
  %c0 = index.constant 0 : index
  %cHG = index.constant 72 : index
  %zero = index.constant 0 : offset
  %c0_i32 = scalar.constant 0 : i32
  %zero_f = scalar.constant 0.0 : f32
  %iv = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %lv32 = view.load %iv[%tok, 2] : view<[%tokens]x4xi32> -> i32
  %live = scalar.cmpi ne, %lv32, %c0_i32 : i32
  scf.if %live {
    %ok = index.cmp ult, %tid, %cHG : index
    %part = scf.if %ok -> (f32) {
      %g = index.assume %tid [range(%tid, 0, 71)] : index
      %wv = buffer.view %w[%zero] : buffer -> view<[%n]x72x32xbf16>
      %wb = vector.load %wv[%row, %g, %c0] : view<[%n]x72x32xbf16> -> vector<32xbf16>
      %wf = vector.extf %wb : vector<32xbf16> to vector<32xf32>
      %xv = buffer.view %x[%zero] : buffer -> view<[%tokens]x72x32xf32>
      %xg = vector.load %xv[%tok, %g, %c0] : view<[%tokens]x72x32xf32> -> vector<32xf32>
      %d = vector.dotf<reassoc|contract> %wf, %xg, %zero_f : vector<32xf32>, vector<32xf32>, f32
      scf.yield %d : f32
    } else {
      scf.yield %zero_f : f32
    }
    %tot = kernel.workgroup.reduce<addf> %part : f32
    %is_t0 = index.cmp eq, %tid, %c0 : index
    scf.if %is_t0 {
      %ov = buffer.view %out[%zero] : buffer -> view<[%tokens]x[%n]xf32>
      view.store %tot, %ov[%tok, %row] : f32, view<[%tokens]x[%n]xf32>
    }
  }
  kernel.return
}

// Fast prefill 64x32 WMMA bf16 projection (n <= 32): reads F16 %x16 + %scales ONCE per 64-token tile (13.8 KB LDS, 100% occ!).
kernel.def export("g_ink_bf16_proj_pre") @g_ink_bf16_proj_pre(%tokens: index, %n: index) {
  %c1 = index.constant 1 : index
  %c63 = index.constant 63 : index
