        scf.yield %hv0 : f32
      }
      scf.yield %o0 : f32
    }
    %need1 = index.constant 2 : index
    %has1 = index.cmp uge, %length, %need1 : index
    %val1 = scf.if %has1 -> (f32) {
      %s1_v = index.sub %length, %need1 : index
      %s1 = index.assume %s1_v [range(%s1_v, 0, 7)] : index
      %v1 = view.load %cap_v[%rb, %s1, %layer, %ch] : view<16x8x48x6656xf32> -> f32
      scf.yield %v1 : f32
    } else {
      %o1 = scf.if %fresh -> (f32) {
        scf.yield %zero_f : f32
      } else {
        %k1p = index.add %c1, %length : index
        %hk1_t = index.mul %k1p, %swidth : index
        %hk1_a = index.add %sbase, %hk1_t : index
        %hk1_b = index.add %hk1_a, %lch : index
        %hk1 = index.assume %hk1_b [range(%hk1_b, 0, 19967)] : index
        %hv1 = view.load %old_v[%hk1] : view<19968xf32> -> f32
        scf.yield %hv1 : f32
      }
      scf.yield %o1 : f32
    }
    %need2 = index.constant 1 : index
    %has2 = index.cmp uge, %length, %need2 : index
    %val2 = scf.if %has2 -> (f32) {
      %s2_v = index.sub %length, %need2 : index
      %s2 = index.assume %s2_v [range(%s2_v, 0, 7)] : index
      %v2 = view.load %cap_v[%rb, %s2, %layer, %ch] : view<16x8x48x6656xf32> -> f32
