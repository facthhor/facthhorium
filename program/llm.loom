  %cG_w = index.constant 3 : index
  %sub = index.div %wave_all, %cG_w : index
  %wave = index.rem %wave_all, %cG_w : index
  %lane_id = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 31)] : index
  %lane_col = index.rem %lane, %c16 : index
  %lane_half = index.div %lane, %c16 : index
  %hi_half = index.cmp ne, %lane_half, %c0 : index
  %adj1 = func.call @g_tile_adjacent(%info, %tokens, %anchor, %false_top) : (buffer, index, index, i1) -> (i1)
  %live1 = scalar.andi %first_slot, %adj1 : i1
  %is_sub1 = index.cmp eq, %sub, %c1 : index
  %use_sub1 = scalar.andi %is_sub1, %live1 : i1
  %mine = scf.select %is_sub1, %live1, %true_top : i1
  %first1_v = index.add %anchor, %c16 : index
  %first_sel = scf.select %use_sub1, %first1_v, %anchor : index
  %first_token = index.assume %first_sel [range(%first_sel, 0, 8191), lt(%first_sel, %tokens)] : index
  %pos1 = index.add %pos_a, %c16 : index
  %pos0 = scf.select %use_sub1, %pos1, %pos_a : index
  %c31_pos = index.constant 31 : index
  %pos_last0 = index.add %pos_a, %c15 : index
  %pos_last1 = index.add %pos_a, %c31_pos : index
  %pos_last = scf.select %live1, %pos_last1, %pos_last0 : index
  %padded = index.add %context, %c15 : index
  %blocks = index.div %padded, %c16 : index
  %k_plane = index.mul %layer, %c2 : index
  %pos_bytes = index.constant 2048 : offset
  %plane_stride = index.scale %pool, %pos_bytes : index, offset -> offset
  %is_sliding = scalar.cmpi ne, %sliding, %c0_i32 : i32
  %window = index.constant 1024 : index
  %window_less = index.constant 1023 : index
  %far = index.cmp uge, %pos_a, %window : index
  %use_window = scalar.andi %is_sliding, %far : i1
  %window_start = index.sub %pos_a, %window_less : index
  %key_low = scf.select %use_window, %window_start, %c0 : index
  %key_span = index.sub %pos_last, %key_low : index
  %key_count_value = index.add %key_span, %c1 : index
  %key_count = index.assume %key_count_value [range(%key_count_value, 1, 1048576)] : index
  %ckt_less = index.constant 31 : index
  %ckt = index.constant 32 : index
  %key_tiles_round = index.add %key_count, %ckt_less : index
  %key_tiles = index.div %key_tiles_round, %ckt : index
  %cG = index.constant 3 : index
  %head_value = index.madd %kv, %cG, %wave : index
  %head = index.assume %head_value [range(%head_value, 0, 23)] : index

  // K [32 x 128] and V^T [128 x 32] LDS tiles (F16, bank-padded).
  %k_bytes = index.constant 8704 : offset
  %k_tile = buffer.alloca<workgroup> align(16) %k_bytes : buffer
  %k_view = buffer.view %k_tile[%origin] : buffer -> view<32x136xf16>
  %vt_bytes = index.constant 10240 : offset
  %vt_tile = buffer.alloca<workgroup> align(16) %vt_bytes : buffer
  %vt_view = buffer.view %vt_tile[%origin] : buffer -> view<128x40xf16>

  // Q^T fragments (held in registers: 8 x vector<16xf16>)
  %q_view = buffer.view %q[%origin] : buffer -> view<[%tokens]x24x8x16xf32>
  %q_token_value = index.add %first_token, %lane_col : index
  %q_token = index.assume %q_token_value [lt(%q_token_value, %tokens)] : index
  %qc0 = index.constant 0 : index
  %qraw0 = vector.load %q_view[%q_token, %head, %qc0, %c0] : view<[%tokens]x24x8x16xf32> -> vector<16xf32>
  %qh0 = vector.fptrunc %qraw0 : vector<16xf32> to vector<16xf16>
  %qf0 = vector.fragment<rhs> %qh0 shape [%c16, %c16] : vector<16xf16>
  %qc1 = index.constant 1 : index
  %qraw1 = vector.load %q_view[%q_token, %head, %qc1, %c0] : view<[%tokens]x24x8x16xf32> -> vector<16xf32>
  %qh1 = vector.fptrunc %qraw1 : vector<16xf32> to vector<16xf16>
  %qf1 = vector.fragment<rhs> %qh1 shape [%c16, %c16] : vector<16xf16>
  %qc2 = index.constant 2 : index
  %qraw2 = vector.load %q_view[%q_token, %head, %qc2, %c0] : view<[%tokens]x24x8x16xf32> -> vector<16xf32>
  %qh2 = vector.fptrunc %qraw2 : vector<16xf32> to vector<16xf16>
  %qf2 = vector.fragment<rhs> %qh2 shape [%c16, %c16] : vector<16xf16>
  %qc3 = index.constant 3 : index
  %qraw3 = vector.load %q_view[%q_token, %head, %qc3, %c0] : view<[%tokens]x24x8x16xf32> -> vector<16xf32>
  %qh3 = vector.fptrunc %qraw3 : vector<16xf32> to vector<16xf16>
  %qf3 = vector.fragment<rhs> %qh3 shape [%c16, %c16] : vector<16xf16>
  %qc4 = index.constant 4 : index
  %qraw4 = vector.load %q_view[%q_token, %head, %qc4, %c0] : view<[%tokens]x24x8x16xf32> -> vector<16xf32>
  %qh4 = vector.fptrunc %qraw4 : vector<16xf32> to vector<16xf16>
  %qf4 = vector.fragment<rhs> %qh4 shape [%c16, %c16] : vector<16xf16>
  %qc5 = index.constant 5 : index
  %qraw5 = vector.load %q_view[%q_token, %head, %qc5, %c0] : view<[%tokens]x24x8x16xf32> -> vector<16xf32>
  %qh5 = vector.fptrunc %qraw5 : vector<16xf32> to vector<16xf16>
  %qf5 = vector.fragment<rhs> %qh5 shape [%c16, %c16] : vector<16xf16>
  %qc6 = index.constant 6 : index
  %qraw6 = vector.load %q_view[%q_token, %head, %qc6, %c0] : view<[%tokens]x24x8x16xf32> -> vector<16xf32>
  %qh6 = vector.fptrunc %qraw6 : vector<16xf32> to vector<16xf16>
  %qf6 = vector.fragment<rhs> %qh6 shape [%c16, %c16] : vector<16xf16>
  %qc7 = index.constant 7 : index
  %qraw7 = vector.load %q_view[%q_token, %head, %qc7, %c0] : view<[%tokens]x24x8x16xf32> -> vector<16xf32>
  %qh7 = vector.fptrunc %qraw7 : vector<16xf32> to vector<16xf16>
  %qf7 = vector.fragment<rhs> %qh7 shape [%c16, %c16] : vector<16xf16>
  %r_view = buffer.view %r[%origin] : buffer -> view<[%tokens]x24x16xf32>
  %rb_view = buffer.view %rel_bias[%origin] : buffer -> view<1024x16xf32>
  %r16 = vector.load %r_view[%q_token, %head, %c0] : view<[%tokens]x24x16xf32> -> vector<16xf32>
  %zero_f = scalar.constant 0.0 : f32
  %one_init = scalar.constant 1.0 : f32
  %sinks_view = buffer.view %sinks[%origin] : buffer -> view<[%tokens]x24xf32>
  %sink_raw = view.load %sinks_view[%q_token, %head] : view<[%tokens]x24xf32> -> f32
  %m_init = scalar.addf %sink_raw, %zero_f : f32
  %zero8 = vector.splatf 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zero8 shape [%c16, %c16] : vector<8xf32>
  %neg_big = scalar.constant -3.0e38 : f32
  %scale = scalar.constant 0.08838834764831843 : f32
  %scale_v = vector.splat %scale : vector<8xf32>
  %neg_v = vector.splat %neg_big : vector<8xf32>
  %zero_v8 = vector.splatf 0.0 : vector<8xf32>
  %zero16h = vector.splatf 0.0 : vector<16xf16>
  %iota16 = vector.iota %c0_i32 step %c1_i32m : vector<16xi32>
  %exchange = scalar.constant 16 : i32
  %width = scalar.constant 32 : i32
  %two_i32 = scalar.constant 2 : i32
  %cwin_i32 = scalar.constant 1023 : i32
  %true_const = scalar.constant true : i1
  %not_sliding = scalar.xori %is_sliding, %true_const : i1
  %ns_v = vector.splat %not_sliding : vector<8xi1>
  %pos0_i32 = index.cast %pos0 : index to i32
  %pos15_i32 = scalar.addi %pos0_i32, %c15_i32m : i32
  %lane_col32m = index.cast %lane_col : index to i32
  %win_lo15 = scalar.subi %pos15_i32, %cwin_i32 : i32
  %query_pos = index.add %pos0, %lane_col : index
  %qp32 = index.cast %query_pos : index to i32
  %qp_v = vector.splat %qp32 : vector<8xi32>
  %low32 = scalar.subi %qp32, %cwin_i32 : i32
  %low_v = vector.splat %low32 : vector<8xi32>
  %half32 = index.cast %lane_half : index to i32
  %row_off = vector.iota %half32 step %two_i32 : vector<8xi32>

  // Staging slot mapping: 2 pass(es) x 192 lanes -> 256 slots (32 keys x 8 chunks of 16 f16).
  %ctpk = index.constant 8 : index
  %cdpt = index.constant 16 : index
  %c_slots = index.constant 256 : index
  %c_slots_less = index.constant 255 : index
  %kz = vector.splatf 0.0 : vector<16xf16>
  %st_add_p0 = index.constant 0 : index
  %st_slot_p0 = index.add %workitem, %st_add_p0 : index
  %st_key_val_p0 = index.div %st_slot_p0, %ctpk : index
  %st_key_p0 = index.assume %st_key_val_p0 [range(%st_key_val_p0, 0, 31)] : index
  %st_seg_p0 = index.rem %st_slot_p0, %ctpk : index
  %st_dim_val_p0 = index.mul %st_seg_p0, %cdpt : index
  %st_dim_p0 = index.assume %st_dim_val_p0 [range(%st_dim_val_p0, 0, 112)] : index
  %st_add_p1 = index.constant 192 : index
  %st_slot_p1 = index.add %workitem, %st_add_p1 : index
  %st_live_p1 = index.cmp ult, %st_slot_p1, %c_slots : index
  %st_slot_cl_p1 = index.min %st_slot_p1, %c_slots_less : index
  %st_key_val_p1 = index.div %st_slot_cl_p1, %ctpk : index
  %st_key_p1 = index.assume %st_key_val_p1 [range(%st_key_val_p1, 0, 31)] : index
  %st_seg_p1 = index.rem %st_slot_cl_p1, %ctpk : index
  %st_dim_val_p1 = index.mul %st_seg_p1, %cdpt : index
  %st_dim_p1 = index.assume %st_dim_val_p1 [range(%st_dim_val_p1, 0, 112)] : index
  %m_final, %l_final, %o0, %o1, %o2, %o3, %o4, %o5, %o6, %o7 = scf.for %kt = [%c0 to %key_tiles step %c1](%m = %m_init : f32, %l = %one_init : f32, %a0 = %init : vector<8xf32>, %a1 = %init : vector<8xf32>, %a2 = %init : vector<8xf32>, %a3 = %init : vector<8xf32>, %a4 = %init : vector<8xf32>, %a5 = %init : vector<8xf32>, %a6 = %init : vector<8xf32>, %a7 = %init : vector<8xf32>) -> (f32, f32, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %tile_first = index.madd %kt, %ckt, %key_low : index
    %key_pos_p0 = index.add %tile_first, %st_key_p0 : index
    %key_valid_p0 = index.cmp ule, %key_pos_p0, %pos_last : index
    %kvals_p0, %vvals_p0 = scf.if %key_valid_p0 -> (vector<16xf16>, vector<16xf16>) {
      %kp_p0 = index.assume %key_pos_p0 [range(%key_pos_p0, 0, 1048575)] : index
      %k_off_p0 = func.call @g_kv_offset(%origins, %row, %kp_p0, %blocks, %k_plane, %pool) : (buffer, index, index, index, index, index) -> (offset)
      %v_off_p0 = index.add %k_off_p0, %plane_stride : offset
      %k_cache_p0 = buffer.view %arena[%k_off_p0] : buffer -> view<8x128xf16>
      %v_cache_p0 = buffer.view %arena[%v_off_p0] : buffer -> view<8x128xf16>
      %kh_p0 = vector.load %k_cache_p0[%kv, %st_dim_p0] : view<8x128xf16> -> vector<16xf16>
      %vh_p0 = vector.load %v_cache_p0[%kv, %st_dim_p0] : view<8x128xf16> -> vector<16xf16>
      scf.yield %kh_p0, %vh_p0 : vector<16xf16>, vector<16xf16>
    } else {
      scf.yield %kz, %kz : vector<16xf16>, vector<16xf16>
    }
    vector.store %kvals_p0, %k_view[%st_key_p0, %st_dim_p0] : vector<16xf16>, view<32x136xf16>
    scf.for %j_p0 = [%c0 to %cdpt step %c1] unroll {
      %vj_p0 = vector.extract %vvals_p0[%j_p0] : vector<16xf16> -> f16
      %vt_row_val_p0 = index.add %st_dim_p0, %j_p0 : index
      %vt_row_p0 = index.assume %vt_row_val_p0 [range(%vt_row_val_p0, 0, 127)] : index
      view.store %vj_p0, %vt_view[%vt_row_p0, %st_key_p0] : f16, view<128x40xf16>
    }
    scf.if %st_live_p1 {
      %key_pos_p1 = index.add %tile_first, %st_key_p1 : index
      %key_valid_p1 = index.cmp ule, %key_pos_p1, %pos_last : index
      %kvals_p1, %vvals_p1 = scf.if %key_valid_p1 -> (vector<16xf16>, vector<16xf16>) {
        %kp_p1 = index.assume %key_pos_p1 [range(%key_pos_p1, 0, 1048575)] : index
        %k_off_p1 = func.call @g_kv_offset(%origins, %row, %kp_p1, %blocks, %k_plane, %pool) : (buffer, index, index, index, index, index) -> (offset)
        %v_off_p1 = index.add %k_off_p1, %plane_stride : offset
        %k_cache_p1 = buffer.view %arena[%k_off_p1] : buffer -> view<8x128xf16>
        %v_cache_p1 = buffer.view %arena[%v_off_p1] : buffer -> view<8x128xf16>
        %kh_p1 = vector.load %k_cache_p1[%kv, %st_dim_p1] : view<8x128xf16> -> vector<16xf16>
        %vh_p1 = vector.load %v_cache_p1[%kv, %st_dim_p1] : view<8x128xf16> -> vector<16xf16>
        scf.yield %kh_p1, %vh_p1 : vector<16xf16>, vector<16xf16>
      } else {
        scf.yield %kz, %kz : vector<16xf16>, vector<16xf16>
      }
      vector.store %kvals_p1, %k_view[%st_key_p1, %st_dim_p1] : vector<16xf16>, view<32x136xf16>
      scf.for %j_p1 = [%c0 to %cdpt step %c1] unroll {
        %vj_p1 = vector.extract %vvals_p1[%j_p1] : vector<16xf16> -> f16
        %vt_row_val_p1 = index.add %st_dim_p1, %j_p1 : index
        %vt_row_p1 = index.assume %vt_row_val_p1 [range(%vt_row_val_p1, 0, 127)] : index
        view.store %vj_p1, %vt_view[%vt_row_p1, %st_key_p1] : f16, view<128x40xf16>
      }
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %tf32 = index.cast %tile_first : index to i32
    %kl0_0 = vector.fragment.load<lhs> %k_view[%kb0_row, %d0] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_0 = vector.mma %kl0_0, %qf0, %init : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_1 = vector.fragment.load<lhs> %k_view[%kb0_row, %d1] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_1 = vector.mma %kl0_1, %qf1, %s0_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_2 = vector.fragment.load<lhs> %k_view[%kb0_row, %d2] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_2 = vector.mma %kl0_2, %qf2, %s0_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_3 = vector.fragment.load<lhs> %k_view[%kb0_row, %d3] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_3 = vector.mma %kl0_3, %qf3, %s0_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_4 = vector.fragment.load<lhs> %k_view[%kb0_row, %d4] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_4 = vector.mma %kl0_4, %qf4, %s0_3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_5 = vector.fragment.load<lhs> %k_view[%kb0_row, %d5] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_5 = vector.mma %kl0_5, %qf5, %s0_4 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_6 = vector.fragment.load<lhs> %k_view[%kb0_row, %d6] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_6 = vector.mma %kl0_6, %qf6, %s0_5 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %kl0_7 = vector.fragment.load<lhs> %k_view[%kb0_row, %d7] shape [%c16, %c16] : view<32x136xf16> -> vector<16xf16>
    %s0_7 = vector.mma %kl0_7, %qf7, %s0_6 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %sc_qk0 = vector.mulf %s0_7, %scale_v : vector<8xf32>
    %base0 = scalar.addi %tf32, %kbo0 : i32
    %base0_v = vector.splat %base0 : vector<8xi32>
    %kpos0 = vector.addi %base0_v, %row_off : vector<8xi32>
    // Relative bias: skip sub-block completely if min_dist = pos0 - (base + 15) >= 1024 or base > pos15.
    %rb_lim0 = scalar.addi %base0, %cEXT15_i32 : i32
    %rb_near0 = scalar.cmpi slt, %pos0_i32, %rb_lim0 : i32
    %rb_live0 = scalar.cmpi sle, %base0, %pos15_i32 : i32
    %has_rb0 = scalar.andi %rb_near0, %rb_live0 : i1
    %sc0 = scf.if %has_rb0 -> (vector<8xf32>) {
      %dbase0 = scalar.subi %qp32, %base0 : i32
      %d0_0 = scalar.subi %dbase0, %half32 : i32
      %rok0_0 = scalar.cmpi ult, %d0_0, %cEXT_i32 : i32
      %rb0_0 = scf.if %rok0_0 -> (f32) {
        %dbd0_0 = scalar.assume %d0_0 [range(%d0_0, 0, 1023)] : i32
        %dix0_0 = index.cast %dbd0_0 : i32 to index
        %bv0_0 = vector.load %rb_view[%dix0_0, %c0] : view<1024x16xf32> -> vector<16xf32>
        %rd0_0 = vector.dotf<reassoc|contract> %r16, %bv0_0, %zero_f : vector<16xf32>, vector<16xf32>, f32
        scf.yield %rd0_0 : f32
      } else {
        scf.yield %zero_f : f32
      }
      %dist0_1 = scalar.subi %d0_0, %c2_i32 : i32
      %rok0_1 = scalar.cmpi ult, %dist0_1, %cEXT_i32 : i32
      %rb0_1 = scf.if %rok0_1 -> (f32) {
        %dbd0_1 = scalar.assume %dist0_1 [range(%dist0_1, 0, 1023)] : i32
        %dix0_1 = index.cast %dbd0_1 : i32 to index
        %bv0_1 = vector.load %rb_view[%dix0_1, %c0] : view<1024x16xf32> -> vector<16xf32>
        %rd0_1 = vector.dotf<reassoc|contract> %r16, %bv0_1, %zero_f : vector<16xf32>, vector<16xf32>, f32
        scf.yield %rd0_1 : f32
      } else {
        scf.yield %zero_f : f32
      }
      %dist0_2 = scalar.subi %d0_0, %c4_i32 : i32
      %rok0_2 = scalar.cmpi ult, %dist0_2, %cEXT_i32 : i32
      %rb0_2 = scf.if %rok0_2 -> (f32) {
        %dbd0_2 = scalar.assume %dist0_2 [range(%dist0_2, 0, 1023)] : i32
        %dix0_2 = index.cast %dbd0_2 : i32 to index
        %bv0_2 = vector.load %rb_view[%dix0_2, %c0] : view<1024x16xf32> -> vector<16xf32>
        %rd0_2 = vector.dotf<reassoc|contract> %r16, %bv0_2, %zero_f : vector<16xf32>, vector<16xf32>, f32
        scf.yield %rd0_2 : f32
      } else {
        scf.yield %zero_f : f32
      }
      %dist0_3 = scalar.subi %d0_0, %c6_i32 : i32
      %rok0_3 = scalar.cmpi ult, %dist0_3, %cEXT_i32 : i32
      %rb0_3 = scf.if %rok0_3 -> (f32) {
        %dbd0_3 = scalar.assume %dist0_3 [range(%dist0_3, 0, 1023)] : i32
        %dix0_3 = index.cast %dbd0_3 : i32 to index
        %bv0_3 = vector.load %rb_view[%dix0_3, %c0] : view<1024x16xf32> -> vector<16xf32>
        %rd0_3 = vector.dotf<reassoc|contract> %r16, %bv0_3, %zero_f : vector<16xf32>, vector<16xf32>, f32
        scf.yield %rd0_3 : f32
      } else {
        scf.yield %zero_f : f32
      }
      %dist0_4 = scalar.subi %d0_0, %c8_i32 : i32
      %rok0_4 = scalar.cmpi ult, %dist0_4, %cEXT_i32 : i32
      %rb0_4 = scf.if %rok0_4 -> (f32) {
        %dbd0_4 = scalar.assume %dist0_4 [range(%dist0_4, 0, 1023)] : i32
        %dix0_4 = index.cast %dbd0_4 : i32 to index
        %bv0_4 = vector.load %rb_view[%dix0_4, %c0] : view<1024x16xf32> -> vector<16xf32>
        %rd0_4 = vector.dotf<reassoc|contract> %r16, %bv0_4, %zero_f : vector<16xf32>, vector<16xf32>, f32
        scf.yield %rd0_4 : f32
      } else {
        scf.yield %zero_f : f32
      }
      %dist0_5 = scalar.subi %d0_0, %c10_i32 : i32
      %rok0_5 = scalar.cmpi ult, %dist0_5, %cEXT_i32 : i32
