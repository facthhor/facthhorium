    // K-loader geometry (waves 0..7): key_k = 4*wk + (lane & 3) in 0..31, c0 = lane >> 2 in 0..7 -> dims 8*c0 and 8*c0 + 64!
    %wk_cl = index.min %wave_all, %c7 : index
