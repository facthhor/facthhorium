// Parallel decode MoE top-k selector (reads logits[t, E] produced by 128-WG g_mv_f32_k2304_r1):
// computes sigmoid(logits) + bias, top-8, norm with 1e-20, * scale (8.0), and optional * down_scale[e] in ONE tiny 1-WG launch!
kernel.def export("g_ink_moe_topk") @g_ink_moe_topk(%tokens: index) {
  %c1 = index.constant 1 : index
  %cE = index.constant 128 : index
