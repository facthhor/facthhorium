    %ns1 = vector.dotf<reassoc|contract> %m1_4, %m1_4, %ns0 : vector<4xf32>, vector<4xf32>, f32
    %nlsq = vector.dotf<reassoc|contract> %m2_4, %m2_4, %ns1 : vector<4xf32>, vector<4xf32>, f32
