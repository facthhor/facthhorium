  kernel.launch.config workgroups(%tiles_count, %ckv, %c1) workgroup_size(%clanes, %c1, %c1) : index
} launch(%tokens_arg: index, %spans_arg: index, %swa_off_arg: index, %metadata: buffer, %q: buffer, %r: buffer, %rel_bias: buffer, %sinks: buffer, %gate: buffer, %info: buffer, %tiles: buffer, %origins: buffer, %arena: buffer, %swa_cur: buffer, %out: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 16, 8192), multiple_of(%tokens_arg, 16)] : index
  %spans = index.assume %spans_arg [range(%spans_arg, 1, 8192)] : index
  %swa_off_b = index.assume %swa_off_arg [range(%swa_off_arg, 0, 1073741824)] : index
