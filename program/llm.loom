    %vdw1_s = view.load %vdv[%c0, %kh, 2] : view<1x8x4xf32> -> f32
    %vdw2_s = view.load %vdv[%c0, %kh, 1] : view<1x8x4xf32> -> f32
    %vdw3_s = view.load %vdv[%c0, %kh, 0] : view<1x8x4xf32> -> f32
