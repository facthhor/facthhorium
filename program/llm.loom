      %vv1 = vector.load %vold[1, %kh, %lane, %c0] : view<3x8x32x4xf32> -> vector<4xf32>
      %vv2 = vector.load %vold[2, %kh, %lane, %c0] : view<3x8x32x4xf32> -> vector<4xf32>
