    vector.store %deq1, %w2_stage_view[%stage_row, %stage_col] : vector<16xf16>, view<64x72xf16>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %pf_step1 = index.add %step, %c1 : index
    %pf_min = index.min %pf_step1, %pf_last : index
    %pf_next = index.assume %pf_min [lt(%pf_min, %k_steps)] : index
    %k_origin_n = index.mul %pf_next, %c64 : index
