    %am0 = vector.reduce<maxnumf> %a0, %zero_f : vector<4xf32>, f32
    %a1 = vector.absf %y1 : vector<4xf32>
    %am1 = vector.reduce<maxnumf> %a1, %am0 : vector<4xf32>, f32
    %a2 = vector.absf %y2 : vector<4xf32>
    %alm = vector.reduce<maxnumf> %a2, %am1 : vector<4xf32>, f32
    %maximum = kernel.workgroup.reduce<maxnumf> %alm : f32
    %bits = scalar.bitcast %maximum : f32 to i32
