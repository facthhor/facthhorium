  %values = vector.sitofp %codes : vector<32xi8> to vector<32xf32>
  %scales = vector.splat %scale : vector<32xf32>
  %scaled = vector.mulf %values, %scales : vector<32xf32>
  func.return %scaled : vector<32xf32>
}

// Q5_K group as values (for heads/embeddings) is g_q5_k_values; Q4_K is g_q4_k_values.

func.def inline @g_ue4m3_to_f32(%b: i8) -> (f32) {
  %x0 = scalar.extui %b : i8 to i32
  %c127 = scalar.constant 127 : i32
  %c8 = scalar.constant 8 : i32
  %c952 = scalar.constant 952 : i32
  %c20 = scalar.constant 20 : i32
  %zero_f = scalar.constant 0.0 : f32
  %sub_scale = scalar.constant 0.0009765625 : f32
  %x = scalar.andi %x0, %c127 : i32
  %is_sub = scalar.cmpi ult, %x, %c8 : i32
  %is_nan = scalar.cmpi eq, %x0, %c127 : i32
  %man_f = scalar.uitofp %x : i32 to f32
  %sub_v = scalar.mulf %man_f, %sub_scale : f32
  %xb = scalar.addi %x, %c952 : i32
  %n_bits = scalar.shli %xb, %c20 : i32
  %norm_v = scalar.bitcast %n_bits : i32 to f32
  %nz_v = scf.select %is_sub, %sub_v, %norm_v : f32
  %out = scf.select %is_nan, %zero_f, %nz_v : f32
  func.return %out : f32
}

func.def inline @g_nvfp4_values(%w: buffer, %origin: offset, %group: index) -> (vector<32xf32>) {
