// Whether a 16-token tile is uniform (live, one row, consecutive positions): flash2 handles those.
func.def inline @g_tile_uniform(%info: buffer, %tokens: index, %first: index) -> (i1, i32, i32) {
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %c0_i32 = scalar.constant 0 : i32
  %true = scalar.constant true : i1
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %bfirst = index.assume %first [lt(%first, %tokens)] : index
  %row0 = view.load %info_view[%bfirst, %c0] : view<[%tokens]x4xi32> -> i32
  %pos0 = view.load %info_view[%bfirst, %c1] : view<[%tokens]x4xi32> -> i32
  %ok = scf.for %i = [%c0 to %c16 step %c1](%acc = %true : i1) -> (i1) {
    %t_value = index.add %first, %i : index
    %in_range = index.cmp ult, %t_value, %tokens : index
    %t_clamped = scf.select %in_range, %t_value, %bfirst : index
    %t = index.assume %t_clamped [lt(%t_clamped, %tokens)] : index
    %row = view.load %info_view[%t, %c0] : view<[%tokens]x4xi32> -> i32
    %pos = view.load %info_view[%t, %c1] : view<[%tokens]x4xi32> -> i32
    %c2 = index.constant 2 : index
    %live = view.load %info_view[%t, %c2] : view<[%tokens]x4xi32> -> i32
    %i32v = index.cast %i : index to i32
    %expected = scalar.addi %pos0, %i32v : i32
    %same_row = scalar.cmpi eq, %row, %row0 : i32
    %consecutive = scalar.cmpi eq, %pos, %expected : i32
    %is_live = scalar.cmpi ne, %live, %c0_i32 : i32
    %a = scalar.andi %same_row, %consecutive : i1
    %b = scalar.andi %a, %is_live : i1
    %c = scalar.andi %b, %in_range : i1
    %next = scalar.andi %acc, %c : i1
    scf.yield %next : i1
  }
  func.return %ok, %row0, %pos0 : i1, i32, i32
}

// Whether the 16-token tile after (BACK false) or before (BACK true) the uniform tile at FIRST is uniform too and
// continues it: the same row, positions 16 higher / lower.
func.def inline @g_tile_adjacent(%info: buffer, %tokens: index, %first: index, %back: i1) -> (i1) {
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %c16_i32 = scalar.constant 16 : i32
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %bfirst = index.assume %first [range(%first, 0, 8191), lt(%first, %tokens)] : index
  %row0 = view.load %info_view[%bfirst, %c0] : view<[%tokens]x4xi32> -> i32
  %pos0 = view.load %info_view[%bfirst, %c1] : view<[%tokens]x4xi32> -> i32
  %room = index.cmp uge, %first, %c16 : index
  %back_step = scf.select %room, %c16, %c0 : index
  %prev = index.sub %first, %back_step : index
  %next = index.add %first, %c16 : index
  %other = scf.select %back, %prev, %next : index
  %in_range = index.cmp ult, %other, %tokens : index
  %other_clamped = scf.select %in_range, %other, %bfirst : index
  %other_bound = index.assume %other_clamped [range(%other_clamped, 0, 8191), lt(%other_clamped, %tokens)] : index
  %uniform, %row, %pos = func.call @g_tile_uniform(%info, %tokens, %other_bound) : (buffer, index, index) -> (i1, i32, i32)
  %pos_before = scalar.subi %pos0, %c16_i32 : i32
  %pos_after = scalar.addi %pos0, %c16_i32 : i32
  %pos_want = scf.select %back, %pos_before, %pos_after : i32
  %same_row = scalar.cmpi eq, %row, %row0 : i32
  %next_pos = scalar.cmpi eq, %pos, %pos_want : i32
  %a = scalar.andi %uniform, %in_range : i1
  %b = scalar.andi %a, %same_row : i1
  %ok = scalar.andi %b, %next_pos : i1
  func.return %ok : i1
}

// Whether the uniform tile at TOKEN starts at a position multiple of 16 (flash2 computes those; see
// g_attention_fallback_list).
func.def inline @g_tile_starts(%info: buffer, %tokens: index, %token: index) -> (i1) {
  %zero = index.constant 0 : offset
  %c1 = index.constant 1 : index
  %c0_i32 = scalar.constant 0 : i32
  %c15_i32 = scalar.constant 15 : i32
  %false = scalar.constant false : i1
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %bounded = index.assume %token [range(%token, 0, 8191), lt(%token, %tokens)] : index
  %pos = view.load %info_view[%bounded, %c1] : view<[%tokens]x4xi32> -> i32
  %skew = scalar.andi %pos, %c15_i32 : i32
  %aligned = scalar.cmpi eq, %skew, %c0_i32 : i32
  %starts = scf.if %aligned -> (i1) {
    %uniform, %row, %pos0 = func.call @g_tile_uniform(%info, %tokens, %bounded) : (buffer, index, index) -> (i1, i32, i32)
    scf.yield %uniform : i1
  } else {
    scf.yield %false : i1
  }
  func.return %starts : i1
}

// Whether TOKEN belongs to a run of at least 9 tokens (one row, consecutive positions, live): the tokens of a prefill
// span, however it was cut. Decode and verify spans are at most 8 tokens (draft depth <= 7) and stay on the split-K
// fallback, so a token's attention path depends on its run, never on where the epoch or the scheduler cut it.
func.def inline @g_run_qualifies(%info: buffer, %tokens: index, %token: index) -> (i1) {
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c9 = index.constant 9 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c9_i32 = scalar.constant 9 : i32
  %true = scalar.constant true : i1
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %btoken = index.assume %token [lt(%token, %tokens)] : index
  %row0 = view.load %info_view[%btoken, %c0] : view<[%tokens]x4xi32> -> i32
  %pos0 = view.load %info_view[%btoken, %c1] : view<[%tokens]x4xi32> -> i32
  %live0 = view.load %info_view[%btoken, %c2] : view<[%tokens]x4xi32> -> i32
  %is_live0 = scalar.cmpi ne, %live0, %c0_i32 : i32
  %alive_l, %left = scf.for %k = [%c1 to %c9 step %c1](%alive = %is_live0 : i1, %n = %c0_i32 : i32) -> (i1, i32) {
    %room = index.cmp ule, %k, %token : index
    %back = index.sub %token, %k : index
    %at_value = scf.select %room, %back, %btoken : index
    %at = index.assume %at_value [lt(%at_value, %tokens)] : index
    %row = view.load %info_view[%at, %c0] : view<[%tokens]x4xi32> -> i32
    %pos = view.load %info_view[%at, %c1] : view<[%tokens]x4xi32> -> i32
    %live = view.load %info_view[%at, %c2] : view<[%tokens]x4xi32> -> i32
    %k32 = index.cast %k : index to i32
    %want = scalar.subi %pos0, %k32 : i32
    %same_row = scalar.cmpi eq, %row, %row0 : i32
    %at_pos = scalar.cmpi eq, %pos, %want : i32
    %is_live = scalar.cmpi ne, %live, %c0_i32 : i32
    %a = scalar.andi %same_row, %at_pos : i1
    %b = scalar.andi %a, %is_live : i1
    %c = scalar.andi %b, %room : i1
    %next_alive = scalar.andi %alive, %c : i1
    %step = scf.select %next_alive, %c1_i32, %c0_i32 : i32
    %n_next = scalar.addi %n, %step : i32
    scf.yield %next_alive, %n_next : i1, i32
  }
  %alive_r, %right = scf.for %k = [%c1 to %c9 step %c1](%alive = %is_live0 : i1, %n = %c0_i32 : i32) -> (i1, i32) {
    %ahead = index.add %token, %k : index
    %room = index.cmp ult, %ahead, %tokens : index
    %at_value = scf.select %room, %ahead, %btoken : index
    %at = index.assume %at_value [lt(%at_value, %tokens)] : index
    %row = view.load %info_view[%at, %c0] : view<[%tokens]x4xi32> -> i32
    %pos = view.load %info_view[%at, %c1] : view<[%tokens]x4xi32> -> i32
    %live = view.load %info_view[%at, %c2] : view<[%tokens]x4xi32> -> i32
    %k32 = index.cast %k : index to i32
    %want = scalar.addi %pos0, %k32 : i32
    %same_row = scalar.cmpi eq, %row, %row0 : i32
    %at_pos = scalar.cmpi eq, %pos, %want : i32
    %is_live = scalar.cmpi ne, %live, %c0_i32 : i32
    %a = scalar.andi %same_row, %at_pos : i1
    %b = scalar.andi %a, %is_live : i1
    %c = scalar.andi %b, %room : i1
    %next_alive = scalar.andi %alive, %c : i1
    %step = scf.select %next_alive, %c1_i32, %c0_i32 : i32
    %n_next = scalar.addi %n, %step : i32
    scf.yield %next_alive, %n_next : i1, i32
  }
  %lr = scalar.addi %left, %right : i32
  %run = scalar.addi %lr, %c1_i32 : i32
  %long = scalar.cmpi sge, %run, %c9_i32 : i32
  %ok = scalar.andi %long, %is_live0 : i1
  func.return %ok : i1
}

// Whether TOKEN is the first token of its 16-position block within its run: its position is a multiple of 16, or the
// token before it does not continue the run. The partial tiles (blocks the run covers only in part) are listed by it.
func.def inline @g_block_starts(%info: buffer, %tokens: index, %token: index) -> (i1) {
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c15_i32 = scalar.constant 15 : i32
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %btoken = index.assume %token [lt(%token, %tokens)] : index
  %row0 = view.load %info_view[%btoken, %c0] : view<[%tokens]x4xi32> -> i32
  %pos0 = view.load %info_view[%btoken, %c1] : view<[%tokens]x4xi32> -> i32
  %skew = scalar.andi %pos0, %c15_i32 : i32
  %aligned = scalar.cmpi eq, %skew, %c0_i32 : i32
  %room = index.cmp uge, %token, %c1 : index
  %back = index.sub %token, %c1 : index
  %at_value = scf.select %room, %back, %btoken : index
  %at = index.assume %at_value [lt(%at_value, %tokens)] : index
  %row = view.load %info_view[%at, %c0] : view<[%tokens]x4xi32> -> i32
  %pos = view.load %info_view[%at, %c1] : view<[%tokens]x4xi32> -> i32
  %live = view.load %info_view[%at, %c2] : view<[%tokens]x4xi32> -> i32
  %want = scalar.subi %pos0, %c1_i32 : i32
  %same_row = scalar.cmpi eq, %row, %row0 : i32
  %at_pos = scalar.cmpi eq, %pos, %want : i32
  %is_live = scalar.cmpi ne, %live, %c0_i32 : i32
  %a = scalar.andi %same_row, %at_pos : i1
  %b = scalar.andi %a, %is_live : i1
  %continues = scalar.andi %b, %room : i1
  %true = scalar.constant true : i1
  %starts_run = scalar.xori %continues, %true : i1
  %starts = scalar.ori %aligned, %starts_run : i1
  func.return %starts : i1
}


// Load-time capability (card config llm.logits, default off): export the logits rows of flagged spans (g_logits_export).
config.def @llm.logits = false : i1

// Rows of the logits region this stage may write (prepare.loom: min(spans, rows) under llm.logits).
config.def @llm.logit_slots = 0 : index

config.decl @llm.context : %value: index where [range(%value, 16, 1048576)]

config.decl @llm.spans : %value: index where [range(%value, 1, 8192)]

config.decl @llm.tokens : %value: index where [range(%value, 1, 8192)]

config.decl @llm.pool : %value: index where [range(%value, 16, 2147483584)]

command.def public target(@device) @llm_advance() launch(%weights: buffer, %residual: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %tokens: buffer, %outputs: buffer) {
  %t = config.get @llm.tokens : index
  %spans = config.get @llm.spans : index
  %context = config.get @llm.context : index
  %pool = config.get @llm.pool : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c24 = index.constant 24 : index
  %c32 = index.constant 32 : index
  %nH = index.constant 2304 : index
  %n2H = index.constant 4608 : index
  %nQ = index.constant 3072 : index
  %nKV = index.constant 1024 : index
  %nR = index.constant 384 : index
  %nRANK = index.constant 64 : index
  %nE = index.constant 128 : index
  %nSINK = index.constant 24 : index
  %nDYN = index.constant 32 : index
  %off_k = index.constant 0 : index
  %off_v = index.constant 12288 : index
  %off_ap = index.constant 24576 : index
  %off_fp = index.constant 52224 : index
  %zero_i32 = scalar.constant 0 : i32
  %one_i32 = scalar.constant 1 : i32
  %blocks = index.div %context, %c16 : index
  %single = index.cmp eq, %t, %c1 : index
  %gemm = index.cmp uge, %t, %c64 : index
  %big = index.cmp uge, %t, %c128 : index
  %huge = index.cmp uge, %t, %c256 : index
  // Scratch allocations
  %row_bytes = index.constant 9216 : offset
  %row_size = index.scale %t, %row_bytes : index, offset -> offset
  %x = buffer.alloca<global> align(256) %row_size : buffer
  %h = buffer.alloca<global> align(256) %row_size : buffer
  %hk = buffer.alloca<global> align(256) %row_size : buffer
  %hv = buffer.alloca<global> align(256) %row_size : buffer
  %y = buffer.alloca<global> align(256) %row_size : buffer
  %y2 = buffer.alloca<global> align(256) %row_size : buffer
  %ffn_inp = buffer.alloca<global> align(256) %row_size : buffer
  %ctrl_out0 = buffer.alloca<global> align(256) %row_size : buffer
  %ctrl_out1 = buffer.alloca<global> align(256) %row_size : buffer
  %ctrl_out2 = buffer.alloca<global> align(256) %row_size : buffer
  %bank_last = buffer.alloca<global> align(256) %row_size : buffer
  // 8-slot block bank: slots 0..3 = blocks[0..3], 4 = prelude_cur, 5 = bank_b2
  %c5 = index.constant 5 : index
  %c8 = index.constant 8 : index
  %bank_size = index.scale %c8, %row_size : index, offset -> offset
  %blk_bank = buffer.alloca<global> align(256) %bank_size : buffer
  // Mix output buffers (up to 3 planes x t x H)
  %mix3_size = index.scale %c3, %row_size : index, offset -> offset
  %mix_out = buffer.alloca<global> align(256) %mix3_size : buffer
  %mix2_size = index.scale %c2, %row_size : index, offset -> offset
  %msg_attn = buffer.alloca<global> align(256) %mix2_size : buffer
  %msg_kv = buffer.alloca<global> align(256) %mix2_size : buffer
  // Loop controller scratch: [t, 2*H] and [t, 64]
  %cat_bytes = index.constant 18432 : offset
  %cat_size = index.scale %t, %cat_bytes : index, offset -> offset
  %cat = buffer.alloca<global> align(256) %cat_size : buffer
  %z_bytes = index.constant 256 : offset
  %z_size = index.scale %t, %z_bytes : index, offset -> offset
  %z_buf = buffer.alloca<global> align(256) %z_size : buffer
  // Attention scratch
  %q_bytes = index.constant 12288 : offset
  %q_size = index.scale %t, %q_bytes : index, offset -> offset
  %q = buffer.alloca<global> align(256) %q_size : buffer
  %gate = buffer.alloca<global> align(256) %q_size : buffer
  %att = buffer.alloca<global> align(256) %q_size : buffer
  %kv_bytes = index.constant 4096 : offset
  %kv_size = index.scale %t, %kv_bytes : index, offset -> offset
  %k_raw = buffer.alloca<global> align(256) %kv_size : buffer
  %v_raw = buffer.alloca<global> align(256) %kv_size : buffer
  %k_conv = buffer.alloca<global> align(256) %kv_size : buffer
  %v_conv = buffer.alloca<global> align(256) %kv_size : buffer
  %r_bytes = index.constant 1536 : offset
  %r_size = index.scale %t, %r_bytes : index, offset -> offset
  %r_buf = buffer.alloca<global> align(256) %r_size : buffer
  %sink_bytes = index.constant 96 : offset
  %sink_size = index.scale %t, %sink_bytes : index, offset -> offset
  %sink_buf = buffer.alloca<global> align(256) %sink_size : buffer
  %dyn_bytes = index.constant 128 : offset
  %dyn_size = index.scale %t, %dyn_bytes : index, offset -> offset
  %dyn_k = buffer.alloca<global> align(256) %dyn_size : buffer
  %dyn_v = buffer.alloca<global> align(256) %dyn_size : buffer
  // Decode split-K scratch (only sized for t < 64; 1 token dummy on prefill!)
  %t_dec = scf.select %gemm, %c1, %t : index
  %pm_bytes = index.constant 6144 : offset
  %pm_size = index.scale %t_dec, %pm_bytes : index, offset -> offset
  %pm = buffer.alloca<global> align(256) %pm_size : buffer
  %pl = buffer.alloca<global> align(256) %pm_size : buffer
  %po_bytes = index.constant 786432 : offset
  %po_size = index.scale %t_dec, %po_bytes : index, offset -> offset
  %po = buffer.alloca<global> align(256) %po_size : buffer
  // Prefill flash2 tile list & 16-split listed fallback scratch (sized for t on prefill, 1 on decode)
  %t_pre = scf.select %gemm, %t, %c1 : index
  // 8 MiB MALL-hot SWA prefill K/V scratch ([t_pre, 2, KH, D] f16, 4 KiB on decode!)
  %swa_cur_bytes = index.constant 4096 : offset
  %swa_cur_size = index.scale %t_pre, %swa_cur_bytes : index, offset -> offset
  %swa_kv_cur = buffer.alloca<global> align(256) %swa_cur_size : buffer
  %list_entry = index.constant 4 : offset
  %list_size = index.scale %t, %list_entry : index, offset -> offset
  %count_size = index.constant 256 : offset
  %flash_tiles = buffer.alloca<global> align(256) %list_size : buffer
  %fallback_list = buffer.alloca<global> align(256) %list_size : buffer
  %fallback_count = buffer.alloca<global> align(256) %count_size : buffer
  %fb_acc_bytes = index.constant 196608 : offset
  %fb_acc_size = index.scale %t_pre, %fb_acc_bytes : index, offset -> offset
  %fb_acc = buffer.alloca<global> align(256) %fb_acc_size : buffer
  %fb_ml_bytes = index.constant 3072 : offset
  %fb_ml_size = index.scale %t_pre, %fb_ml_bytes : index, offset -> offset
  %fb_ml = buffer.alloca<global> align(256) %fb_ml_size : buffer
  // Prefill F16 row-scaled activation buffers
  %f16_h_bytes = index.constant 4608 : offset
  %f16_q_bytes = index.constant 6144 : offset
  %f16_2h_bytes = index.constant 9216 : offset
  %scale_bytes = index.constant 8 : offset
  %h16_size = index.scale %t, %f16_h_bytes : index, offset -> offset
  %q16_size = index.scale %t, %f16_q_bytes : index, offset -> offset
  %c16_size = index.scale %t, %f16_2h_bytes : index, offset -> offset
  %sc_size = index.scale %t, %scale_bytes : index, offset -> offset
  %h16 = buffer.alloca<global> align(256) %h16_size : buffer
  %h16q = buffer.alloca<global> align(256) %h16_size : buffer
  %s_h = buffer.alloca<global> align(256) %sc_size : buffer
  %hk16 = buffer.alloca<global> align(256) %h16_size : buffer
  %hk16q = buffer.alloca<global> align(256) %h16_size : buffer
  %s_hk = buffer.alloca<global> align(256) %sc_size : buffer
  %hv16 = buffer.alloca<global> align(256) %h16_size : buffer
  %hv16q = buffer.alloca<global> align(256) %h16_size : buffer
  %s_hv = buffer.alloca<global> align(256) %sc_size : buffer
  %att16 = buffer.alloca<global> align(256) %q16_size : buffer
  %att16q = buffer.alloca<global> align(256) %q16_size : buffer
  %s_att = buffer.alloca<global> align(256) %sc_size : buffer
  %cat16 = buffer.alloca<global> align(256) %c16_size : buffer
  %s_cat = buffer.alloca<global> align(256) %sc_size : buffer
  // Info + Head scratch
  %info_bytes = index.constant 16 : offset
  %info_size = index.scale %t, %info_bytes : index, offset -> offset
  %info = buffer.alloca<global> align(256) %info_size : buffer
  %part_bytes = index.constant 12504 : offset
  %part_size = index.scale %spans, %part_bytes : index, offset -> offset
  %partials = buffer.alloca<global> align(256) %part_size : buffer
  %logit_bytes = index.constant 800256 : offset
  %logit_size = index.scale %spans, %logit_bytes : index, offset -> offset
  %logits = buffer.alloca<global> align(256) %logit_size : buffer
  // MoE scratch
  %nFS = index.constant 32 : index
  %cKU = index.constant 8 : index
  %ta = index.mul %t, %cKU : index
  %nFE = index.constant 1152 : index
  %ids_bytes = index.constant 32 : offset
  %ids_size = index.scale %t, %ids_bytes : index, offset -> offset
  %ids = buffer.alloca<global> align(256) %ids_size : buffer
  %wts = buffer.alloca<global> align(256) %ids_size : buffer
  %act_bytes = index.constant 36864 : offset
  %act_size = index.scale %t, %act_bytes : index, offset -> offset
  %act = buffer.alloca<global> align(256) %act_size : buffer
  %actq = buffer.alloca<global> align(256) %act_size : buffer
  %ys_bytes = index.constant 73728 : offset
  %ys_size = index.scale %t, %ys_bytes : index, offset -> offset
  %ys = buffer.alloca<global> align(256) %ys_size : buffer
  %c64m = index.constant 64 : index
  %cEm = index.constant 128 : index
  %ta_tiles = index.div %ta, %c64m : index
  %max_tiles = index.add %ta_tiles, %cEm : index
  %max_rows = index.mul %max_tiles, %c64m : index
  %b8 = index.constant 8 : offset
  %b4 = index.constant 4 : offset
  %ti_size = index.scale %max_tiles, %b8 : index, offset -> offset
  %tile_info = buffer.alloca<global> align(256) %ti_size : buffer
  %rm_size = index.scale %max_rows, %b4 : index, offset -> offset
  %rowmap = buffer.alloca<global> align(256) %rm_size : buffer
  %pos_size = index.scale %ta, %b4 : index, offset -> offset
  %pos = buffer.alloca<global> align(256) %pos_size : buffer
  %fe4 = index.constant 4608 : offset
  %fe2 = index.constant 2304 : offset
  %h4 = index.constant 9216 : offset
  %as_size = index.scale %max_rows, %fe4 : index, offset -> offset
  %act_sorted = buffer.alloca<global> align(256) %as_size : buffer
  %a16_size = index.scale %max_rows, %fe2 : index, offset -> offset
  %act16 = buffer.alloca<global> align(256) %a16_size : buffer
  %sr_size = index.scale %max_rows, %b8 : index, offset -> offset
  %s_rows = buffer.alloca<global> align(256) %sr_size : buffer
  %yss_size = index.scale %max_rows, %h4 : index, offset -> offset
  %ys_sorted = buffer.alloca<global> align(256) %yss_size : buffer

  // Parallel decode router logits [t_dec, E]
  %rl_bytes = index.constant 512 : offset
  %rl_size = index.scale %t_dec, %rl_bytes : index, offset -> offset
  %rlogits = buffer.alloca<global> align(256) %rl_size : buffer
  kernel.launch @g_token_info[%t](%t, %spans, %metadata, %info) : [index](index, index, buffer, buffer)
  kernel.launch @g_ink_swa_fork_copy_all[%spans](%spans, %metadata, %origins, %arena) : [index](index, buffer, buffer, buffer)
  scf.if %gemm {
    kernel.launch @g_attention_fallback_list[%t](%t, %info, %flash_tiles, %fallback_list, %fallback_count) : [index](index, buffer, buffer, buffer, buffer)
  }
  // Embed + token_embd_norm -> %h, then copy %h -> %x so `cur` always lives in %x
  %embedding = command.parameter %weights, "token_embd.weight" : view<492106752xi8>
  %tok_norm = command.parameter %weights, "token_embd_norm.weight" : view<2304xf32>
  kernel.launch @g_embed_media[%t](%t, %tokens, %embedding, %tok_norm, %x, %h, %metadata, %info) : [index](index, buffer, view<492106752xi8>, view<2304xf32>, buffer, buffer, buffer, buffer)
  scf.if %gemm {
    kernel.launch @g_ink_copy_buf_lv[%t](%t, %h, %x, %info) : [index](index, buffer, buffer, buffer)
  } else {
    kernel.launch @g_ink_copy_buf[%t](%t, %h, %x) : [index](index, buffer, buffer)
  }
  %loop_res_q = command.parameter %weights, "loop_res_query.weight" : view<221184xi8>
  %loop_kv_q = command.parameter %weights, "loop_kv_res_query.weight" : view<221184xi8>
  %cQLOOP = index.constant 24 : index

  // ==== step 0 (phys blk.0, pass -1, SWA, n_blk=0) ====
  %slot_0 = index.constant 0 : index
  %swa_0 = scalar.constant 1 : i32
  %an_0 = command.parameter %weights, "blk.0.attn_norm.weight" : view<2304xf32>
  scf.if %gemm {
    kernel.launch @g_ink_rms_norm_plane_f16_lv[%t](%t, %c1, %c0, %x, %an_0, %info, %h, %s_h, %h16) : [index](index, index, index, buffer, view<2304xf32>, buffer, buffer, buffer, buffer)
  } else {
    kernel.launch @g_ink_rms_norm_plane[%t](%t, %c1, %c0, %x, %an_0, %h) : [index](index, index, index, buffer, view<2304xf32>, buffer)
    kernel.launch @g_quant_q8[%t, %nH](%t, %nH, %h, %h16q) : [index, index](index, index, buffer, buffer)
  }
  %wq_0 = command.parameter %weights, "blk.0.attn_q.weight" : view<7520256xi8>
  %wk_0 = command.parameter %weights, "blk.0.attn_k.weight" : view<2506752xi8>
  %wv_0 = command.parameter %weights, "blk.0.attn_v.weight" : view<2506752xi8>
  %wr_0 = command.parameter %weights, "blk.0.attn_rel.weight" : view<940032xi8>
  %wg_0 = command.parameter %weights, "blk.0.attn_gate.weight" : view<7520256xi8>
  %wo_0 = command.parameter %weights, "blk.0.attn_output.weight" : view<7520256xi8>
  %wsink_0 = command.parameter %weights, "blk.0.attn_sink_proj.weight" : view<110592xi8>
  %qclip_0 = command.parameter %weights, "blk.0.attn_q_clip.weight" : view<12288xi8>
  %rclip_0 = command.parameter %weights, "blk.0.attn_rel_clip.weight" : view<1536xi8>
  %rbias_0 = command.parameter %weights, "blk.0.attn_rel_bias.weight" : view<65536xi8>
  %kconv_0 = command.parameter %weights, "blk.0.attn_k_conv.weight" : view<16384xi8>
  %vconv_0 = command.parameter %weights, "blk.0.attn_v_conv.weight" : view<16384xi8>
  %apconv_0 = command.parameter %weights, "blk.0.attn_post_conv.weight" : view<36864xi8>
  %fpconv_0 = command.parameter %weights, "blk.0.ffn_post_conv.weight" : view<36864xi8>
  scf.if %gemm {
      scf.if %big {
        scf.if %huge {
          template.apply<@sel1_g_gemm_q8_0_store_m256>(%t, %nQ, %t, %nH, %nQ, %h16, %s_h, %wq_0, %q) : (index, index, index, index, index, buffer, buffer, view<7520256xi8>, buffer)
        } else {
          template.apply<@sel2_g_gemm_q8_0_store_m128>(%t, %nQ, %t, %nH, %nQ, %h16, %s_h, %wq_0, %q) : (index, index, index, index, index, buffer, buffer, view<7520256xi8>, buffer)
        }
      } else {
        template.apply<@sel3_g_gemm_q8_0_store>(%t, %nQ, %t, %nH, %nQ, %h16, %s_h, %wq_0, %q) : (index, index, index, index, index, buffer, buffer, view<7520256xi8>, buffer)
      }
      scf.if %big {
        scf.if %huge {
          template.apply<@sel1_g_gemm_q8_0_store_m256>(%t, %nQ, %t, %nH, %nQ, %h16, %s_h, %wg_0, %gate) : (index, index, index, index, index, buffer, buffer, view<7520256xi8>, buffer)
        } else {
          template.apply<@sel2_g_gemm_q8_0_store_m128>(%t, %nQ, %t, %nH, %nQ, %h16, %s_h, %wg_0, %gate) : (index, index, index, index, index, buffer, buffer, view<7520256xi8>, buffer)
        }
      } else {
        template.apply<@sel3_g_gemm_q8_0_store>(%t, %nQ, %t, %nH, %nQ, %h16, %s_h, %wg_0, %gate) : (index, index, index, index, index, buffer, buffer, view<7520256xi8>, buffer)
      }
    } else {
      %c4_p1 = index.constant 4 : index
      %le4_p1 = index.cmp ule, %t, %c4_p1 : index
      scf.if %le4_p1 {
        scf.if %single {
          kernel.launch @g_mv_q8_0_k2304_q8_r1[%nQ, %t](%nQ, %t, %zero_i32, %h16q, %wq_0, %q) : [index, index](index, index, i32, buffer, view<7520256xi8>, buffer)
          kernel.launch @g_mv_q8_0_k2304_q8_r1[%nQ, %t](%nQ, %t, %zero_i32, %h16q, %wg_0, %gate) : [index, index](index, index, i32, buffer, view<7520256xi8>, buffer)
        } else {
          kernel.launch @g_mv_q8_0_k2304_t4_q8_r1[%nQ, %t](%nQ, %t, %zero_i32, %h16q, %wq_0, %q) : [index, index](index, index, i32, buffer, view<7520256xi8>, buffer)
          kernel.launch @g_mv_q8_0_k2304_t4_q8_r1[%nQ, %t](%nQ, %t, %zero_i32, %h16q, %wg_0, %gate) : [index, index](index, index, i32, buffer, view<7520256xi8>, buffer)
        }
      } else {
        %c8_p1 = index.constant 8 : index
        %le8_p1 = index.cmp ule, %t, %c8_p1 : index
        scf.if %le8_p1 {
          kernel.launch @g_mv_q8_0_k2304_pair_t8_q8[%nQ, %t](%nQ, %t, %zero_i32, %h16q, %wq_0, %wg_0, %q, %gate) : [index, index](index, index, i32, buffer, view<7520256xi8>, view<7520256xi8>, buffer, buffer)
        } else {
          kernel.launch @g_mv_q8_0_k2304_pair_t16_q8[%nQ, %t](%nQ, %t, %zero_i32, %h16q, %wq_0, %wg_0, %q, %gate) : [index, index](index, index, i32, buffer, view<7520256xi8>, view<7520256xi8>, buffer, buffer)
        }
      }
    }
  scf.if %gemm {
      scf.if %big {
        scf.if %huge {
          template.apply<@sel4_g_gemm_q8_0_store_m256>(%t, %nKV, %t, %nH, %nKV, %h16, %s_h, %wk_0, %k_raw) : (index, index, index, index, index, buffer, buffer, view<2506752xi8>, buffer)
        } else {
          template.apply<@sel5_g_gemm_q8_0_store_m128>(%t, %nKV, %t, %nH, %nKV, %h16, %s_h, %wk_0, %k_raw) : (index, index, index, index, index, buffer, buffer, view<2506752xi8>, buffer)
        }
      } else {
        template.apply<@sel6_g_gemm_q8_0_store>(%t, %nKV, %t, %nH, %nKV, %h16, %s_h, %wk_0, %k_raw) : (index, index, index, index, index, buffer, buffer, view<2506752xi8>, buffer)
      }
      scf.if %big {
        scf.if %huge {
          template.apply<@sel4_g_gemm_q8_0_store_m256>(%t, %nKV, %t, %nH, %nKV, %h16, %s_h, %wv_0, %v_raw) : (index, index, index, index, index, buffer, buffer, view<2506752xi8>, buffer)
        } else {
          template.apply<@sel5_g_gemm_q8_0_store_m128>(%t, %nKV, %t, %nH, %nKV, %h16, %s_h, %wv_0, %v_raw) : (index, index, index, index, index, buffer, buffer, view<2506752xi8>, buffer)
        }
      } else {
        template.apply<@sel6_g_gemm_q8_0_store>(%t, %nKV, %t, %nH, %nKV, %h16, %s_h, %wv_0, %v_raw) : (index, index, index, index, index, buffer, buffer, view<2506752xi8>, buffer)
      }
    } else {
      %c4_p2 = index.constant 4 : index
      %le4_p2 = index.cmp ule, %t, %c4_p2 : index
      scf.if %le4_p2 {
        scf.if %single {
          kernel.launch @g_mv_q8_0_k2304_q8_r1[%nKV, %t](%nKV, %t, %zero_i32, %h16q, %wk_0, %k_raw) : [index, index](index, index, i32, buffer, view<2506752xi8>, buffer)
