  %sp_act, %sp_len, %sp_start32, %sp_row, %sp_first = func.call @g_gdn_span(%metadata, %spans, %span) : (buffer, index, index) -> (i1, index, i32, index, index)
  %sp_start_b = scalar.assume %sp_start32 [range(%sp_start32, 0, 1048575)] : i32
  %sp_start = index.cast %sp_start_b : i32 to index
