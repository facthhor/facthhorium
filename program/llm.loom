    %vv = buffer.view %v_in[%zero] : buffer -> view<[%tokens]x8x32x4xf32>
    %v0 = vector.load %vv[%tok, %kh, %lane, %c0] : view<[%tokens]x8x32x4xf32> -> vector<4xf32>
    %vsq = vector.dotf<reassoc|contract> %v0, %v0, %zero_f : vector<4xf32>, vector<4xf32>, f32
