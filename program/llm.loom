    %ksq = vector.dotf<reassoc|contract> %k0, %k0, %zero_f : vector<4xf32>, vector<4xf32>, f32
    %ktot = kernel.subgroup.reduce<addf> %ksq : f32
    %kn0 = scalar.sqrtf %ktot : f32
    %kn = scalar.addf %kn0, %eps : f32
    %kf0 = scalar.divf %qk_thr, %kn : f32
    %kf = scalar.minnumf %kf0, %one_f : f32
