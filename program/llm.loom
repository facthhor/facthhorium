    view.store %ov7_0, %out_flat[%q_token, %dn7_0] : f32, view<[%tokens]x3072xf32>
    %ov7_1 = vector.extract %of7[%d1i] : vector<8xf32> -> f32
    view.store %ov7_1, %out_flat[%q_token, %dn7_1] : f32, view<[%tokens]x3072xf32>
    %ov7_2 = vector.extract %of7[%d2i] : vector<8xf32> -> f32
    view.store %ov7_2, %out_flat[%q_token, %dn7_2] : f32, view<[%tokens]x3072xf32>
    %ov7_3 = vector.extract %of7[%d3i] : vector<8xf32> -> f32
    view.store %ov7_3, %out_flat[%q_token, %dn7_3] : f32, view<[%tokens]x3072xf32>
    %ov7_4 = vector.extract %of7[%d4i] : vector<8xf32> -> f32
    view.store %ov7_4, %out_flat[%q_token, %dn7_4] : f32, view<[%tokens]x3072xf32>
    %ov7_5 = vector.extract %of7[%d5i] : vector<8xf32> -> f32
    view.store %ov7_5, %out_flat[%q_token, %dn7_5] : f32, view<[%tokens]x3072xf32>
    %ov7_6 = vector.extract %of7[%d6i] : vector<8xf32> -> f32
    view.store %ov7_6, %out_flat[%q_token, %dn7_6] : f32, view<[%tokens]x3072xf32>
