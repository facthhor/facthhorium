  scf.for %r = [%c0 to %rows step %c1] {
    %row_value = index.add %first_row, %r : index
    %in_vocab = index.cmp ult, %row_value, %vocab : index
    %load = scalar.andi %in_vocab, %ok : i1
    %last_row = index.constant 200057 : index
    %row_c = index.min %row_value, %last_row : index
    %ro = index.scale %row_c, %row_bytes : index, offset -> offset
    %o = index.add %ro, %ba : offset
    %rb = index.assume %r [range(%r, 0, 127)] : index
    %wv = scf.if %load -> (vector<32xf32>) {
      %v = func.call @g_q8_0_values(%w, %o, %within) : (buffer, offset, index) -> (vector<32xf32>)
      scf.yield %v : vector<32xf32>
    } else {
      scf.yield %zero32 : vector<32xf32>
    }
    %pa0 = vector.dotf<reassoc|contract> %wv, %x0, %zero_f : vector<32xf32>, vector<32xf32>, f32
    %ps0 = kernel.subgroup.reduce<addf> %pa0 : f32
    scf.if %lane_first {
      view.store %ps0, %pv[%wave, %rb, 0] : f32, view<3x128x4xf32>
    }
    %pa1 = vector.dotf<reassoc|contract> %wv, %x1, %zero_f : vector<32xf32>, vector<32xf32>, f32
    %ps1 = kernel.subgroup.reduce<addf> %pa1 : f32
    scf.if %lane_first {
      view.store %ps1, %pv[%wave, %rb, 1] : f32, view<3x128x4xf32>
    }
    %pa2 = vector.dotf<reassoc|contract> %wv, %x2, %zero_f : vector<32xf32>, vector<32xf32>, f32
    %ps2 = kernel.subgroup.reduce<addf> %pa2 : f32
    scf.if %lane_first {
      view.store %ps2, %pv[%wave, %rb, 2] : f32, view<3x128x4xf32>
    }
    %pa3 = vector.dotf<reassoc|contract> %wv, %x3, %zero_f : vector<32xf32>, vector<32xf32>, f32
    %ps3 = kernel.subgroup.reduce<addf> %pa3 : f32
    scf.if %lane_first {
      view.store %ps3, %pv[%wave, %rb, 3] : f32, view<3x128x4xf32>
    }
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %partial_view = buffer.view %partials[%zero] : buffer -> view<[%spans]x1563x2xi32>
  %logit_view = buffer.view %logits[%zero] : buffer -> view<[%spans]x200064xf32>
  %writer0 = index.cmp eq, %workitem, %sj0 : index
  %store0 = scalar.andi %writer0, %live0 : i1
  scf.if %store0 {
    %neg_inf = scalar.constant -3.0e38 : f32
    %best, %best_id = scf.for %r = [%c0 to %rows step %c1](%bv = %neg_inf : f32, %bi = %c0_i32 : i32) -> (f32, i32) {
      %rb = index.assume %r [range(%r, 0, 127)] : index
      %total = scf.for %ww = [%c0 to %cW step %c1](%acc = %zero_f : f32) -> (f32) {
        %bw = index.assume %ww [range(%ww, 0, 2)] : index
        %p = view.load %pv[%bw, %rb, 0] : view<3x128x4xf32> -> f32
        %nx = scalar.addf %acc, %p : f32
        scf.yield %nx : f32
      }
      %row_value = index.add %first_row, %r : index
      %in_vocab = index.cmp ult, %row_value, %vocab : index
      %ls = index.assume %span0_raw [lt(%span0_raw, %spans)] : index
      %lrow = index.assume %row_value [range(%row_value, 0, 200063)] : index
      %stored = scf.select %in_vocab, %total, %neg_inf : f32
      view.store %stored, %logit_view[%ls, %lrow] : f32, view<[%spans]x200064xf32>
      %greater = scalar.cmpf ogt, %total, %bv : f32
      %better = scalar.andi %greater, %in_vocab : i1
      %row32 = index.cast %row_value : index to i32
      %v = scf.select %better, %total, %bv : f32
      %i = scf.select %better, %row32, %bi : i32
      scf.yield %v, %i : f32, i32
    }
    %ss = index.assume %span0_raw [lt(%span0_raw, %spans)] : index
    %bits_value = scalar.bitcast %best : f32 to i32
    view.store %bits_value, %partial_view[%ss, %chunk, %c0] : i32, view<[%spans]x1563x2xi32>
    view.store %best_id, %partial_view[%ss, %chunk, %c1] : i32, view<[%spans]x1563x2xi32>
  }
  %writer1 = index.cmp eq, %workitem, %sj1 : index
  %store1 = scalar.andi %writer1, %live1 : i1
  scf.if %store1 {
    %neg_inf = scalar.constant -3.0e38 : f32
    %best, %best_id = scf.for %r = [%c0 to %rows step %c1](%bv = %neg_inf : f32, %bi = %c0_i32 : i32) -> (f32, i32) {
      %rb = index.assume %r [range(%r, 0, 127)] : index
      %total = scf.for %ww = [%c0 to %cW step %c1](%acc = %zero_f : f32) -> (f32) {
        %bw = index.assume %ww [range(%ww, 0, 2)] : index
        %p = view.load %pv[%bw, %rb, 1] : view<3x128x4xf32> -> f32
        %nx = scalar.addf %acc, %p : f32
        scf.yield %nx : f32
      }
      %row_value = index.add %first_row, %r : index
      %in_vocab = index.cmp ult, %row_value, %vocab : index
      %ls = index.assume %span1_raw [lt(%span1_raw, %spans)] : index
      %lrow = index.assume %row_value [range(%row_value, 0, 200063)] : index
      %stored = scf.select %in_vocab, %total, %neg_inf : f32
      view.store %stored, %logit_view[%ls, %lrow] : f32, view<[%spans]x200064xf32>
      %greater = scalar.cmpf ogt, %total, %bv : f32
      %better = scalar.andi %greater, %in_vocab : i1
      %row32 = index.cast %row_value : index to i32
      %v = scf.select %better, %total, %bv : f32
      %i = scf.select %better, %row32, %bi : i32
      scf.yield %v, %i : f32, i32
    }
    %ss = index.assume %span1_raw [lt(%span1_raw, %spans)] : index
    %bits_value = scalar.bitcast %best : f32 to i32
    view.store %bits_value, %partial_view[%ss, %chunk, %c0] : i32, view<[%spans]x1563x2xi32>
    view.store %best_id, %partial_view[%ss, %chunk, %c1] : i32, view<[%spans]x1563x2xi32>
  }
  %writer2 = index.cmp eq, %workitem, %sj2 : index
  %store2 = scalar.andi %writer2, %live2 : i1
  scf.if %store2 {
    %neg_inf = scalar.constant -3.0e38 : f32
    %best, %best_id = scf.for %r = [%c0 to %rows step %c1](%bv = %neg_inf : f32, %bi = %c0_i32 : i32) -> (f32, i32) {
      %rb = index.assume %r [range(%r, 0, 127)] : index
      %total = scf.for %ww = [%c0 to %cW step %c1](%acc = %zero_f : f32) -> (f32) {
        %bw = index.assume %ww [range(%ww, 0, 2)] : index
        %p = view.load %pv[%bw, %rb, 2] : view<3x128x4xf32> -> f32
        %nx = scalar.addf %acc, %p : f32
        scf.yield %nx : f32
      }
      %row_value = index.add %first_row, %r : index
      %in_vocab = index.cmp ult, %row_value, %vocab : index
      %ls = index.assume %span2_raw [lt(%span2_raw, %spans)] : index
      %lrow = index.assume %row_value [range(%row_value, 0, 200063)] : index
      %stored = scf.select %in_vocab, %total, %neg_inf : f32
      view.store %stored, %logit_view[%ls, %lrow] : f32, view<[%spans]x200064xf32>
      %greater = scalar.cmpf ogt, %total, %bv : f32
      %better = scalar.andi %greater, %in_vocab : i1
      %row32 = index.cast %row_value : index to i32
      %v = scf.select %better, %total, %bv : f32
      %i = scf.select %better, %row32, %bi : i32
      scf.yield %v, %i : f32, i32
    }
    %ss = index.assume %span2_raw [lt(%span2_raw, %spans)] : index
    %bits_value = scalar.bitcast %best : f32 to i32
    view.store %bits_value, %partial_view[%ss, %chunk, %c0] : i32, view<[%spans]x1563x2xi32>
    view.store %best_id, %partial_view[%ss, %chunk, %c1] : i32, view<[%spans]x1563x2xi32>
  }
  %writer3 = index.cmp eq, %workitem, %sj3 : index
  %store3 = scalar.andi %writer3, %live3 : i1
  scf.if %store3 {
    %neg_inf = scalar.constant -3.0e38 : f32
    %best, %best_id = scf.for %r = [%c0 to %rows step %c1](%bv = %neg_inf : f32, %bi = %c0_i32 : i32) -> (f32, i32) {
      %rb = index.assume %r [range(%r, 0, 127)] : index
      %total = scf.for %ww = [%c0 to %cW step %c1](%acc = %zero_f : f32) -> (f32) {
        %bw = index.assume %ww [range(%ww, 0, 2)] : index
        %p = view.load %pv[%bw, %rb, 3] : view<3x128x4xf32> -> f32
        %nx = scalar.addf %acc, %p : f32
        scf.yield %nx : f32
      }
      %row_value = index.add %first_row, %r : index
      %in_vocab = index.cmp ult, %row_value, %vocab : index
      %ls = index.assume %span3_raw [lt(%span3_raw, %spans)] : index
      %lrow = index.assume %row_value [range(%row_value, 0, 200063)] : index
      %stored = scf.select %in_vocab, %total, %neg_inf : f32
      view.store %stored, %logit_view[%ls, %lrow] : f32, view<[%spans]x200064xf32>
      %greater = scalar.cmpf ogt, %total, %bv : f32
      %better = scalar.andi %greater, %in_vocab : i1
      %row32 = index.cast %row_value : index to i32
      %v = scf.select %better, %total, %bv : f32
      %i = scf.select %better, %row32, %bi : i32
      scf.yield %v, %i : f32, i32
    }
    %ss = index.assume %span3_raw [lt(%span3_raw, %spans)] : index
    %bits_value = scalar.bitcast %best : f32 to i32
    view.store %bits_value, %partial_view[%ss, %chunk, %c0] : i32, view<[%spans]x1563x2xi32>
    view.store %best_id, %partial_view[%ss, %chunk, %c1] : i32, view<[%spans]x1563x2xi32>
  }
  kernel.return
}


// Prefill attention work lists, built once per epoch from the token info. A token's path depends only on its own
// run (a run of one row's consecutive positions), never on where the epoch packs it or where the scheduler cut the
// prefill: tiles[1 + i] is the first token of the i-th 16-token tile that lies inside one run and starts at a position
// multiple of 16, in token order (neighbouring workgroups then read neighbouring keys; token 0 past the count):
// g_attention_flash2 computes those, and tiles[0] is their count. The blocks a run of 9 or more tokens covers only in
// part (its head and tail, whatever the cut) are listed from tiles[tokens / 2]: the count, then the first live token of
// each block, for g_attention_flash2_partial (the same arithmetic with the dead columns masked). list holds every
// other token (those of shorter runs: decode and verify; g16_attention_split_listed computes them; count[0] is the
// list length for indirect dispatch).
kernel.def export("g_attention_fallback_list") @g_attention_fallback_list(%tokens: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %info: buffer, %tiles: buffer, %list: buffer, %count: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 16, 8192), multiple_of(%tokens_arg, 16)] : index
  %lane_id = kernel.workitem.id<x> : index
  %lane = index.assume %lane_id [range(%lane_id, 0, 255)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c255 = index.constant 255 : index
  %c256 = index.constant 256 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c15_i32 = scalar.constant 15 : i32
  %true = scalar.constant true : i1
  %scratch_bytes = index.constant 1040 : offset
  %scratch = buffer.alloca<workgroup> align(16) %scratch_bytes : buffer
  %scratch_view = buffer.view %scratch[%zero] : buffer -> view<260xi32>
  %first = index.cmp eq, %lane, %c0 : index
  %c256_slot = index.constant 256 : index
  %c257_slot = index.constant 257 : index
  %c258_slot = index.constant 258 : index
  scf.if %first {
    view.store %c0_i32, %scratch_view[%c256_slot] : i32, view<260xi32>
    view.store %c0_i32, %scratch_view[%c258_slot] : i32, view<260xi32>
  }
  %info_view = buffer.view %info[%zero] : buffer -> view<[%tokens]x4xi32>
  %tiles_view = buffer.view %tiles[%zero] : buffer -> view<[%tokens]xi32>
  %list_view = buffer.view %list[%zero] : buffer -> view<[%tokens]xi32>
  // Tile starts, in token order: lane L takes the L-th run of `chunk` tokens, counts its tile starts, the first lane
  // turns the counts into offsets, and every lane writes its starts after those of the lanes before it.
  %chunk_round = index.add %tokens, %c255 : index
  %chunk = index.div %chunk_round, %c256 : index
  %run = index.mul %lane, %chunk : index
  %mine = scf.for %i = [%c0 to %chunk step %c1](%n = %c0_i32 : i32) -> (i32) {
    %token_value = index.add %run, %i : index
    %inside = index.cmp ult, %token_value, %tokens : index
    %token = scf.select %inside, %token_value, %c0 : index
    %starts = func.call @g_tile_starts(%info, %tokens, %token) : (buffer, index, index) -> (i1)
    %counted = scalar.andi %starts, %inside : i1
    %step = scf.select %counted, %c1_i32, %c0_i32 : i32
    %next = scalar.addi %n, %step : i32
    scf.yield %next : i32
  }
  view.store %mine, %scratch_view[%lane] : i32, view<260xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  scf.if %first {
    %total = scf.for %l = [%c0 to %c256 step %c1](%sum = %c0_i32 : i32) -> (i32) {
      %bounded_l = index.assume %l [range(%l, 0, 255)] : index
      %count_l = view.load %scratch_view[%bounded_l] : view<260xi32> -> i32
      view.store %sum, %scratch_view[%bounded_l] : i32, view<260xi32>
      %sum_next = scalar.addi %sum, %count_l : i32
      scf.yield %sum_next : i32
    }
    view.store %total, %tiles_view[%c0] : i32, view<[%tokens]xi32>
    view.store %total, %scratch_view[%c257_slot] : i32, view<260xi32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %offset = view.load %scratch_view[%lane] : view<260xi32> -> i32
  %written = scf.for %i = [%c0 to %chunk step %c1](%n = %offset : i32) -> (i32) {
    %token_value = index.add %run, %i : index
    %inside = index.cmp ult, %token_value, %tokens : index
    %token = scf.select %inside, %token_value, %c0 : index
    %starts = func.call @g_tile_starts(%info, %tokens, %token) : (buffer, index, index) -> (i1)
    %counted = scalar.andi %starts, %inside : i1
    %next = scf.if %counted -> (i32) {
      %n_bound = scalar.assume %n [range(%n, 0, 511)] : i32
      %slot_value = index.cast %n_bound : i32 to index
      %entry_value = index.add %slot_value, %c1 : index
      %entry = index.assume %entry_value [lt(%entry_value, %tokens)] : index
      %token32 = index.cast %token : index to i32
      view.store %token32, %tiles_view[%entry] : i32, view<[%tokens]xi32>
      %n_next = scalar.addi %n, %c1_i32 : i32
      scf.yield %n_next : i32
    } else {
      scf.yield %n : i32
    }
    scf.yield %next : i32
  }
  // The entries past the count are token 0, so a workgroup without a tile can read its entry.
  %listed_total32 = view.load %scratch_view[%c257_slot] : view<260xi32> -> i32
  %listed_total = index.cast %listed_total32 : i32 to index
  %c16 = index.constant 16 : index
  %slots = index.div %tokens, %c16 : index
  %fill_from = index.add %listed_total, %lane : index
  scf.for %e = [%fill_from to %slots step %c256] {
    %e_bound = index.assume %e [range(%e, 0, 8191)] : index
    %fill_value = index.add %e_bound, %c1 : index
    %fill_slot = index.assume %fill_value [range(%fill_value, 1, 8192), lt(%fill_value, %tokens)] : index
    view.store %c0_i32, %tiles_view[%fill_slot] : i32, view<[%tokens]xi32>
  }
  // Every token of a run shorter than 9 is the listed fallback's; the blocks of a longer run that flash2 does not take
  // whole are the partial list's (order does not matter, each is computed on its own).
  %c2 = index.constant 2 : index
  %half = index.div %tokens, %c2 : index
  %half_entry = index.add %half, %c1 : index
  scf.for %t = [%lane to %tokens step %c256] {
    %token = index.assume %t [lt(%t, %tokens)] : index
    %long = func.call @g_run_qualifies(%info, %tokens, %token) : (buffer, index, index) -> (i1)
    %short = scalar.xori %long, %true : i1
    scf.if %short {
      %slot32 = view.atomic.rmw<addi> %c1_i32, %scratch_view[%c256_slot] {ordering = relaxed, scope = workgroup} : i32, view<260xi32> -> i32
      %slot_bound = scalar.assume %slot32 [range(%slot32, 0, 8191)] : i32
      %slot_value = index.cast %slot_bound : i32 to index
      %slot = index.assume %slot_value [lt(%slot_value, %tokens)] : index
      %token32 = index.cast %token : index to i32
      view.store %token32, %list_view[%slot] : i32, view<[%tokens]xi32>
    } else {
      %block_start = func.call @g_block_starts(%info, %tokens, %token) : (buffer, index, index) -> (i1)
      %whole = func.call @g_tile_starts(%info, %tokens, %token) : (buffer, index, index) -> (i1)
      %part = scalar.xori %whole, %true : i1
      %listed_part = scalar.andi %block_start, %part : i1
      scf.if %listed_part {
        %pslot32 = view.atomic.rmw<addi> %c1_i32, %scratch_view[%c258_slot] {ordering = relaxed, scope = workgroup} : i32, view<260xi32> -> i32
        %pslot_bound = scalar.assume %pslot32 [range(%pslot32, 0, 8191)] : i32
        %pslot_value = index.cast %pslot_bound : i32 to index
        %pentry_value = index.add %half_entry, %pslot_value : index
        %pentry = index.assume %pentry_value [lt(%pentry_value, %tokens)] : index
        %ptoken32 = index.cast %token : index to i32
        view.store %ptoken32, %tiles_view[%pentry] : i32, view<[%tokens]xi32>
      }
    }
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  scf.if %first {
    %fallbacks = view.load %scratch_view[%c256_slot] : view<260xi32> -> i32
    %count_view = buffer.view %count[%zero] : buffer -> view<1xi32>
    view.store %fallbacks, %count_view[0] : i32, view<1xi32>
    %partials = view.load %scratch_view[%c258_slot] : view<260xi32> -> i32
    %half_bound = index.assume %half [lt(%half, %tokens)] : index
    view.store %partials, %tiles_view[%half_bound] : i32, view<[%tokens]xi32>
  }
  kernel.return
}


// (reader, writer, fresh) for the span of `row` starting at `start`: the reader slot at the
// fork position, otherwise the row's own writer; position 0 starts from zeros.
kernel.def export("g_ink_copy_buf") @g_ink_copy_buf(%tokens: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  %cb = index.constant 3 : index
  kernel.launch.config workgroups(%tokens, %cb, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %src: buffer, %dst: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %tok_id = kernel.workgroup.id<x> : index
  %tok = index.assume %tok_id [lt(%tok_id, %tokens)] : index
  %blk = kernel.workgroup.id<y> : index
  %tid = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c256 = index.constant 256 : index
  %cH4 = index.constant 576 : index
  %off_b = index.mul %blk, %c256 : index
  %c_raw = index.add %off_b, %tid : index
  %in = index.cmp ult, %c_raw, %cH4 : index
  scf.if %in {
    %ch = index.assume %c_raw [range(%c_raw, 0, 575)] : index
    %zero = index.constant 0 : offset
    %sv = buffer.view %src[%zero] : buffer -> view<[%tokens]x576x4xf32>
    %dv = buffer.view %dst[%zero] : buffer -> view<[%tokens]x576x4xf32>
    %v = vector.load %sv[%tok, %ch, %c0] : view<[%tokens]x576x4xf32> -> vector<4xf32>
    vector.store %v, %dv[%tok, %ch, %c0] : vector<4xf32>, view<[%tokens]x576x4xf32>
  }
  kernel.return
}

kernel.def export("g_ink_copy_slot") @g_ink_copy_slot(%tokens: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  %cb = index.constant 3 : index
  kernel.launch.config workgroups(%tokens, %cb, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens_arg: index, %slot_arg: index, %src: buffer, %dst: buffer) {
  %tokens = index.assume %tokens_arg [range(%tokens_arg, 1, 8192)] : index
  %slot = index.assume %slot_arg [range(%slot_arg, 0, 7)] : index
  %tok_id = kernel.workgroup.id<x> : index
  %tok = index.assume %tok_id [lt(%tok_id, %tokens)] : index
  %blk = kernel.workgroup.id<y> : index
  %tid = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c256 = index.constant 256 : index
  %cH4 = index.constant 576 : index
  %off_b = index.mul %blk, %c256 : index
  %c_raw = index.add %off_b, %tid : index
  %in = index.cmp ult, %c_raw, %cH4 : index
  scf.if %in {
    %ch = index.assume %c_raw [range(%c_raw, 0, 575)] : index
    %zero = index.constant 0 : offset
    %sv = buffer.view %src[%zero] : buffer -> view<[%tokens]x576x4xf32>
    %dv = buffer.view %dst[%zero] : buffer -> view<8x[%tokens]x576x4xf32>
    %v = vector.load %sv[%tok, %ch, %c0] : view<[%tokens]x576x4xf32> -> vector<4xf32>
