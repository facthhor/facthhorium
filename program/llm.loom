}


// Copy all 40 SWA FP16 ring buffers from reader -> writer ONCE at top of @llm_advance ONLY on prefix-cache fork!
// Exits immediately on 99.9% of steps where read64 == write64 or start == 0 or length >= 1024.
kernel.def export("g_ink_swa_fork_copy_all") @g_ink_swa_fork_copy_all(%spans: index) {
  %c1 = index.constant 1 : index
  %cN = index.constant 40 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%spans, %cN, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%spans_arg: index, %metadata: buffer, %origins: buffer, %arena: buffer) {
  %spans = index.assume %spans_arg [range(%spans_arg, 1, 8192)] : index
  %span_id = kernel.workgroup.id<x> : index
  %span = index.assume %span_id [lt(%span_id, %spans)] : index
  %swa_id = kernel.workgroup.id<y> : index
  %swa = index.assume %swa_id [range(%swa_id, 0, 39)] : index
  %kh_raw = kernel.subgroup.id : index
  %kh = index.assume %kh_raw [range(%kh_raw, 0, 7)] : index
  %lane_raw = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_raw [range(%lane_raw, 0, 31)] : index
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %cWIN = index.constant 1024 : index
  %c0_i32 = scalar.constant 0 : i32
  %active, %length, %start32, %row, %first = func.call @g_gdn_span(%metadata, %spans, %span) : (buffer, index, index) -> (i1, index, i32, index, index)
  scf.if %active {
    %rec_stride = index.constant 40 : offset
    %brow = index.assume %row [range(%row, 0, 2147483646)] : index
    %rec_off = index.scale %brow, %rec_stride : index, offset -> offset
    %recs = buffer.view %origins[%rec_off] : buffer -> view<5xi64>
    %read64 = view.load %recs[0] : view<5xi64> -> i64
    %write64 = view.load %recs[1] : view<5xi64> -> i64
    %fork64 = view.load %recs[3] : view<5xi64> -> i64
    %start64 = scalar.extui %start32 : i32 to i64
    %nz_start = scalar.cmpi ne, %start32, %c0_i32 : i32
    %at_fork = scalar.cmpi eq, %start64, %fork64 : i64
    %diff_slot = scalar.cmpi ne, %read64, %write64 : i64
    %short_span = index.cmp ult, %length, %cWIN : index
    %a0 = scalar.andi %nz_start, %at_fork : i1
    %a1 = scalar.andi %a0, %diff_slot : i1
    %need = scalar.andi %a1, %short_span : i1
    scf.if %need {
      %rb = scalar.assume %read64 [range(%read64, 0, 9223372036854775807)] : i64
      %wb = scalar.assume %write64 [range(%write64, 0, 9223372036854775807)] : i64
      %rbase = index.cast %rb : i64 to offset
      %wbase = index.cast %wb : i64 to offset
      %ring_base = index.constant 3833856 : offset
      %layer_sz = index.constant 4194304 : offset
      %loff0 = index.scale %swa, %layer_sz : index, offset -> offset
      %loff = index.add %ring_base, %loff0 : offset
      %src_k = index.add %rbase, %loff : offset
      %dst_k = index.add %wbase, %loff : offset
      %plane_sz = index.constant 2097152 : offset
      %src_v = index.add %src_k, %plane_sz : offset
      %dst_v = index.add %dst_k, %plane_sz : offset
      %skv = buffer.view %arena[%src_k] : buffer -> view<1024x8x32x4xf16>
      %dkv = buffer.view %arena[%dst_k] : buffer -> view<1024x8x32x4xf16>
      %svv = buffer.view %arena[%src_v] : buffer -> view<1024x8x32x4xf16>
      %dvv = buffer.view %arena[%dst_v] : buffer -> view<1024x8x32x4xf16>
      scf.for %p = [%c0 to %cWIN step %c1] {
        %pb = index.assume %p [range(%p, 0, 1023)] : index
        %kv4 = vector.load %skv[%pb, %kh, %lane, %c0] : view<1024x8x32x4xf16> -> vector<4xf16>
        vector.store %kv4, %dkv[%pb, %kh, %lane, %c0] : vector<4xf16>, view<1024x8x32x4xf16>
        %vv4 = vector.load %svv[%pb, %kh, %lane, %c0] : view<1024x8x32x4xf16> -> vector<4xf16>
        vector.store %vv4, %dvv[%pb, %kh, %lane, %c0] : vector<4xf16>, view<1024x8x32x4xf16>
      }
    }
  }
  kernel.return
}

